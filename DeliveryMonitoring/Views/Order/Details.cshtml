@model DeliveryMonitoring.Models.Order

@{
    ViewData["Title"] = "Details";
}



<div class="container-fluid pt-3">
    <div class="card">
        <div class="card-header">
            <h3>Order Details</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-5">
                    @Html.DisplayNameFor(model => model.branchName)
                </dt>
                <dd class="col-sm-5">
                    @Html.DisplayFor(model => model.branchName)
                </dd>
                <dt class="col-sm-5">
                    @Html.DisplayNameFor(model => model.companyTin)
                </dt>
                <dd class="col-sm-5">
                    @Html.DisplayFor(model => model.companyTin)
                </dd>
                <dt class="col-sm-5">
                    @Html.DisplayNameFor(model => model.customer.deviceId)
                </dt>
                <dd class="col-sm-5">
                    @Html.DisplayFor(model => model.customer.deviceId)
                </dd>
                <dt class="col-sm-5">
                    @Html.DisplayNameFor(model => model.customer.firstName)
                </dt>
                <dd class="col-sm-5">
                    @Html.DisplayFor(model => model.customer.firstName)
                </dd>
                <dt class="col-sm-5">
                    @Html.DisplayNameFor(model => model.customer.geocodeAddress)
                </dt>
                <dd class="col-sm-5">
                    @Html.DisplayFor(model => model.customer.geocodeAddress)
                </dd>
                <dt class="col-sm-5">
                    @Html.DisplayNameFor(model => model.customer.phoneNumber)
                </dt>
                <dd class="col-sm-5">
                    @Html.DisplayFor(model => model.customer.phoneNumber)
                </dd>
                <dt class="col-sm-5">
                    @Html.DisplayNameFor(model => model.customer.specificAddress)
                </dt>
                <dd class="col-sm-5">
                    @Html.DisplayFor(model => model.customer.specificAddress)
                </dd>

                <dt class="col-sm-5">
                    @Html.DisplayNameFor(model => model.requestCreatedAt)
                </dt>
                <dd class="col-sm-5">
                    @DateTimeOffset.FromUnixTimeMilliseconds(Model.requestCreatedAt).DateTime.ToString("yyyy-MM-dd HH:mm:ss")
                </dd>
                <dt class="col-sm-5">
                    @Html.DisplayNameFor(model => model.status)
                </dt>
                <dd class="col-sm-5">
                    @Html.DisplayFor(model => model.status)
                </dd>
                <dt class="col-sm-5">
                    @Html.DisplayNameFor(model => model.voucherCode)
                </dt>
                <dd class="col-sm-5">
                    @Html.DisplayFor(model => model.voucherCode)
                </dd>
                <dt class="col-sm-5">
                    @Html.DisplayNameFor(model => model.isNoDriversAck)
                </dt>
                <dd class="col-sm-5">
                    @if (Model.isNoDriversAck == true)
                    {
                        <span>Yes</span>
                    }
                    else
                    {
                        <span>No</span>
                    }
                </dd>
                <dt class="col-sm-5">
                    @Html.DisplayNameFor(model => model.orderArrivedAckByCustomer)
                </dt>
                <dd class="col-sm-5">
                    @if (Model.orderArrivedAckByCustomer == true)
                    {
                        <span>Yes</span>
                    }
                    else
                    {
                        <span>No</span>
                    }
                </dd>
                <dt class="col-sm-5">
                    @Html.DisplayNameFor(model => model.orderArrivedAckByDriver)
                </dt>
                <dd class="col-sm-5">
                    @if (Model.orderArrivedAckByDriver == true)
                    {
                        <span>Yes</span>
                    }
                    else
                    {
                        <span>No</span>
                    }
                </dd>
            </dl>

            <div>
                <a class="btn btn-primary" asp-action="Index">Back to List</a>
            </div>
        </div>
    </div>
    
    
    
</div>

