@model DeliveryMonitoring.Models.OrderDetail

@{
    ViewData["Title"] = "Order Details";
    var phoneNumber = Model.assignedDriverPhoneNumber;
}

<div class="container-fluid col-11 pt-5">

    <h3>Order Details</h3>

    <div class="card" id="orderCard">
        <br />      
        <div class="row">
            <div class="col-11 col-md-6" id="orderDetail">
                <div>
                    <span><strong>@Html.DisplayNameFor(model => model.voucherCode):</strong></span>
                    <span><strong>@Html.DisplayFor(model => model.voucherCode)</strong></span>
                </div>
                <div>
                    @DateTimeOffset.FromUnixTimeMilliseconds(Model.requestCreatedAt).DateTime.ToString("HH:mm:ss - ddd, MMMM dd, yyyy")
                </div>
                <div class="d-flex d-inline-block">
                    <div>
                        @{
                            if (Model.status == "requested")
                            {
                                <div style="background-color: deepskyblue;
                                                                                                        border-radius: 20px;
                                                                                                        color: black;
                                                                                                        display: inline-block;
                                                                                                        padding: 5px 5px;">
                                    <strong>@Html.DisplayFor(model => model.status)</strong>
                                </div>
                            }
                            else if (Model.status == "assigned")
                            {
                                <div style="background-color: lawngreen;
                                                                                                            border-radius: 20px;
                                                                                                            color: black;
                                                                                                            display: inline-block;
                                                                                                            padding: 5px 5px;">
                                    <strong>@Html.DisplayFor(model => model.status)</strong>
                                </div>
                            }
                            else
                            {
                                <div style="background-color: yellow;
                                                                                                                border-radius: 20px;
                                                                                                                color: black;
                                                                                                                display: inline-block;
                                                                                                                padding: 5px 5px;">
                                    <strong>@Html.DisplayFor(model => model.status)</strong>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="pt-3 col-12 col-md-5 d-flex justify-content-end">
                <div>
                    @{
                        if (phoneNumber != null && phoneNumber.Length < 10)
                        {
                            <div style="background-color: red;
                                                                                                    border-radius: 20px;
                                                                                                    color: black;
                                                                                                    display: inline-block;
                                                                                                    padding: 5px 5px;">
                                <strong>Driver Not Assigned</strong>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-dark" asp-controller="Driver" asp-action="Details" asp-route-id="@phoneNumber">Check Order Status</a>
                        }
                    }
                </div>
            </div>
        </div>
        <br />
        <br />

        <div class="row">

            <!--Customer Details-->
            <div class="col-12 col-md-4 detail" id="orderDetail">
                <h4><i class="bi bi-person-circle icon"></i>Customer</h4>
                <div>
                    <span id="letters">Name:</span>
                    <span id="outputs">@Html.DisplayFor(model => model.customer.firstName)</span>
                </div>
                <div>
                    <span id="letters">Address:</span>
                    <span id="outputs">
                        @Html.DisplayFor(model => model.customer.geocodeAddress) -
                        @Html.DisplayFor(model => model.customer.specificAddress)
                    </span>
                </div>
                <div>
                    <span id="letters">Phone:</span>
                    <span id="outputs">@Html.DisplayFor(model => model.customer.phoneNumber)</span>
                </div>
                @* <div>
                <span id="letters">Device ID:</span>
                <span id="outputs">@Html.DisplayFor(model => model.customer.deviceId)</span>
                </div> *@
            </div>
            <!--Customer Details Ends Here-->
            <!--Company Details-->
            <div class="col-12 col-md-4 detail">
                <h4><i class="bi bi-building icon"></i>Company</h4>
                <div>
                    <span id="letters">Branch:</span>
                    <span id="outputs">@Html.DisplayFor(model => model.branchName)</span>
                </div>
                <div>
                    <span id="letters">Name:</span>
                    <span id="outputs">@Html.DisplayFor(model => model.companyName)</span>
                </div>
                <div>
                    <span id="letters">TIN:</span>
                    <span id="outputs">
                        <a asp-controller="Company" asp-action="Details" asp-route-id="@Model.companyTin">@Html.DisplayFor(model => model.companyTin)</a>
                    </span>
                </div>
            </div>
            <!--Company Details Ends Here-->
            <!--Driver Details-->
            <div class="col-12 col-md-3">
                <h4><i class="bi bi-car-front icon"></i>Driver</h4>
                <div>
                    <span id="letters">Phone:</span>
                    <span id="outputs">
                        @Html.DisplayFor(model => model.assignedDriverPhoneNumber)
                    </span>
                </div>
            </div>
            <!--Driver Details Ends Here-->
        </div>

        <br />
        <br />
        <!--Order Items Table-->
        <h4 id="orderDetail">Products</h4>
        <div class="col-11 table-responsive table-bordered" id="orderDetail">
            <table class="table pt-3" id="orderTable">
                <thead class="table-secondary">
                    <tr>
                        <th>
                            Item Name
                        </th>
                        <th>
                            Quantity
                        </th>
                        <th>
                            Unit Amount
                        </th>
                        <th>
                            Taxable Amount
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.lineItemsDetail.lineItems)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.quantity)
                            </td>
                            <td>
                                @String.Format("{0:F2} ETB", item.unitAmount)
                            </td>
                            <td>
                                @String.Format("{0:F2} ETB", item.taxableAmount)
                            </td>
                        </tr>
                    }
                    <tr>
                        <td>
                            TXBL 1
                        </td>
                        <td>
                        </td>
                        <td>
                        </td>
                        <td>
                            @Model.lineItemsDetail.extraCharge.TXBL1
                        </td>
                    </tr>
                    <tr>
                        <td>
                            TAX1 15%
                        </td>
                        <td>
                        </td>
                        <td>
                        </td>
                        <td>
                            @Model.lineItemsDetail.extraCharge.TAX115
                        </td>
                    </tr>
                    <tr>
                        <td>
                            Total
                        </td>
                        <td>
                        </td>
                        <td>
                        </td>
                        <td>
                            @String.Format("{0:F2} ETB", Model.lineItemsDetail.grandTotal)
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div id="content">
            <div class="timeline-container">
                <ul class="timeline">
                    @foreach (var item in Model.activities)
                    {
                        <li class="event" data-date="@Html.DisplayFor(modelItem => item.time)">
                            <h3>@Html.DisplayFor(modelItem => item.name)</h3>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <br />        
        <br />
    </div>
</div>
