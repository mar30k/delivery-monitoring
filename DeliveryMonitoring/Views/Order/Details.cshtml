@model DeliveryMonitoring.Models.Order

@{
    ViewData["Title"] = "Details";
}

<div class="container-fluid col-11 pt-5">
            <div class="card">
                <div class="card-header">
                    <h4>Driver Details</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-5">
                        @Html.DisplayNameFor(model => model.assignedDriverPhoneNumber)
                        </dt>
                        <dd class="col-sm-5">
                    <i class="bi bi-telephone-fill"></i>&nbsp;@Html.DisplayFor(model => model.assignedDriverPhoneNumber)
                        </dd>
                @{
                    var phoneNumber = Model.assignedDriverPhoneNumber;
                }
                <dd class="col-sm-2">
                    <a class="btn btn-outline-dark" asp-controller="Driver" asp-action="Details" asp-route-id="@phoneNumber">Check Order Status</a>
                </dd>
                    </dl>

                </div>
            </div>
            <br />

            <div class="card">
                <div class="card-header">
                    <h4>Company Details</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-5">
                            @Html.DisplayNameFor(model => model.branchName)
                        </dt>
                        <dd class="col-sm-5">
                    <i class="bi bi-building-fill"></i>&nbsp;@Html.DisplayFor(model => model.branchName)
                        </dd>
                        <dt class="col-sm-5">
                            @Html.DisplayNameFor(model => model.companyTin)
                        </dt>
                        <dd class="col-sm-5">
                    <i class="bi bi-ticket-detailed-fill"></i>&nbsp;@Html.DisplayFor(model => model.companyTin)
                        </dd>
                    </dl>

                </div>
            </div>
            <br/>

            <div class="card">
                <div class="card-header">
                    <h4>Customer Details</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-5">
                            @Html.DisplayNameFor(model => model.customer.deviceId)
                        </dt>
                        <dd class="col-sm-5">
                    <i class="bi bi-person-vcard-fill"></i>&nbsp;@Html.DisplayFor(model => model.customer.deviceId)
                        </dd>
                        <dt class="col-sm-5">
                            @Html.DisplayNameFor(model => model.customer.firstName)
                        </dt>
                        <dd class="col-sm-5">
                    <i class="bi bi-person-fill"></i>&nbsp;@Html.DisplayFor(model => model.customer.firstName)
                        </dd>
                        <dt class="col-sm-5">
                            @Html.DisplayNameFor(model => model.customer.geocodeAddress)
                        </dt>
                        <dd class="col-sm-5">
                    <i class="bi bi-geo-alt-fill">&nbsp;</i>@Html.DisplayFor(model => model.customer.geocodeAddress) - @Html.DisplayFor(model => model.customer.specificAddress)
                        </dd>
                        <dt class="col-sm-5">
                            @Html.DisplayNameFor(model => model.customer.phoneNumber)
                        </dt>
                        <dd class="col-sm-5">
                    <i class="bi bi-telephone-fill"></i>&nbsp;@Html.DisplayFor(model => model.customer.phoneNumber)
                        </dd>
                        
                    </dl>
                </div>

            </div>
            <br/>
                        

    <div class="col-12 table-responsive">
        
        <table class="table pt-3" id="orderTable">
            <thead class="table-dark">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.requestCreatedAt)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.status)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.voucherCode)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.isAssignedAck)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.isNoDriversAck)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.orderArrivedAckByCustomer)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.orderArrivedAckByDriver)
                    </th>
                </tr>
            </thead>
            <tbody>
                    <tr>
                        <td>
                            <i class="bi bi-clock-fill">&nbsp;@DateTimeOffset.FromUnixTimeMilliseconds(Model.requestCreatedAt).DateTime.ToString("yyyy-MM-dd HH:mm:ss")</i>
                        </td>
                        <td>
                            <i class="bi bi-bell-fill"></i>&nbsp;@Html.DisplayFor(model => model.status)
                        </td>
                        <td>
                            <i class="bi bi-qr-code"></i>&nbsp;@Html.DisplayFor(model => model.voucherCode)
                        </td>
                        <td>
                            @if (Model.isAssignedAck == true)
                            {
                                <span><i class="bi bi-check2-circle"></i>&nbsp;Yes</span>
                            }
                            else
                            {
                                <span><i class="bi bi-x-circle"></i>&nbsp;No</span>
                            }
                        </td>
                    <td>
                        @if (Model.isNoDriversAck == true)
                        {
                            <span><i class="bi bi-check2-circle"></i>&nbsp;Yes</span>
                        }
                        else
                        {
                            <span><i class="bi bi-x-circle"></i>&nbsp;No</span>
                        }
                    </td>
                    <td>
                        @if (Model.orderArrivedAckByCustomer == true)
                        {
                            <span><i class="bi bi-check2-circle"></i>&nbsp;Yes</span>
                        }
                        else
                        {
                            <span><i class="bi bi-x-circle"></i>&nbsp;No</span>
                        }
                    </td>
                    <td>
                        @if (Model.orderArrivedAckByDriver == true)
                        {
                            <span><i class="bi bi-check2-circle"></i>&nbsp;Yes</span>
                        }
                        else
                        {
                            <span><i class="bi bi-x-circle"></i>&nbsp;No</span>
                        }
                    </td>
                    </tr>
            </tbody>
        </table>
    </div>

    <div>
        <a class="btn btn-outline-dark" asp-action="Index">Back to List</a>
    </div>
                                            
    <br />
</div>

