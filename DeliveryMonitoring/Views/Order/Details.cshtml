@using System.Net
@using System.Text.RegularExpressions
@model DeliveryMonitoring.Models.OrderDetail

@{
    ViewData["Title"] = "Order Details";
    var phoneNumber = Model.AssignedDriverPhoneNumber;
    var statusColors = new Dictionary<string, string>
    {
        { "requested", "deepskyblue" },
        { "arrivedatbranch", "orange" },
        { "assigned", "lawngreen" },
        { "declined", "red" },
        { "accepted", "seagreen" },
        { "arrived", "#F7BEA2" },
        { "ontheway", "darkorange" },
        { "drivernotfound", "red" },
        { "sos", "darkred" },
        { "default", "yellow" }
    };
}
<!-- Add this line to include the custom CSS -->
<link rel="stylesheet" href="~/css/orderDetail.css" />
<div class="px-4 mt-2">
    <div class="modal fade" id="supervisorConfirmModal" tabindex="-1" aria-labelledby="supervisorConfirmLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header border-bottom bg-light">
                    <h5 class="modal-title" id="supervisorConfirmLabel">Confirm Supervision Assignment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div id="accetOrderAlertContainer"></div>
                    <p class="m-0">You are about to confirm supervision for this order.</p>
                    <ul class="list-unstyled my-1">
                        <li><strong>Voucher Code:</strong> @Model?.VoucherCode</li>
                        <li><strong>Branch:</strong> @Model?.BranchName</li>
                        <li><strong>Customer Phone:</strong> @Model?.CustomerPhoneNumber</li>
                        <li><strong>Driver Phone:</strong> @Model?.AssignedDriverPhoneNumber</li>
                        <li><strong>Supervisor:</strong> @Model?.SupervisorName</li>
                    </ul>
                    <!-- Feedback message (hidden by default) -->
                    <div id="supervisorFeedback" class="alert d-none mb-0 mt-2" role="alert"></div>
                </div>

                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm" id="confirmSupervisorBtn">Confirm</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="sendAlertModal" tabindex="-1" aria-labelledby="sendAlertModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content shadow">
                <div class="modal-header bg-light border-bottom">
                    <h5 class="modal-title " id="sendAlertModalLabel">Send Alert</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div id="sendAlertContainer"></div>
                    <!-- Recipient Choice -->
                    <div class="mb-3">
                        <label class="form-label">Send alert to:</label>
                        <div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="recipient" id="toCustomer" value="customer" />
                                <label class="form-check-label" for="toCustomer">Customer</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="recipient" id="toDriver" value="driver" />
                                <label class="form-check-label" for="toDriver">Driver</label>
                            </div>
                        </div>
                    </div>

                    <!-- Form Fields -->
                    <form id="alertForm" style="display: none;">
                        <div class="mb-3">
                            <label for="deviceId" class="form-label">Device ID</label>
                            <input type="text" readonly class="form-control" id="deviceId" />
                        </div>

                        <div class="mb-3">
                            <label for="title" class="form-label">Title</label>
                            <input type="text" class="form-control" id="title" required/>
                        </div>

                        <div class="mb-3">
                            <label for="body" class="form-label">Body</label>
                            <textarea class="form-control" id="body" rows="4" required></textarea>
                        </div>
                    </form>
                </div>

                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary btn-sm" id="sendAlertBtn" disabled>Send</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="changeStatusModal" tabindex="-1" aria-labelledby="changeStatusModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content shadow">
                <div class="modal-header bg-light border-bottom">
                    <h5 class="modal-title " id="changeStatusModalLabel">Change Order Status : <span id="voucherCode"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="changeOrderStatusForm" method="post">
                    <div class="modal-body">
                        <div id="changeOrderStatusAlertContainer"></div>

                        <div class="mb-3">
                            <label for="voucherCode" class="form-label">Voucher Code: </label>
                            <input type="text" readonly class="form-control" name="voucherCode" id="voucherCodeInput" />
                        </div>
                        <!-- Driver dropdown -->
                        <div class="mb-3">
                            <label for="driverSelect" class="form-label">Select Driver</label>
                            <select id="driverSelect" name="driverPhoneNumber" class="form-select form-select-sm">
                                <option value="" selected disabled>Loading drivers...</option>
                            </select>
                        </div>

                        <!-- Status dropdown -->
                        <div class="mb-3">

                            @{
                                // Define which statuses to exclude
                                var excludedStatuses = new HashSet<RequestStat>
                                                        {
                                                        RequestStat.sos,
                                                        RequestStat.driverNotFound,
                                                        RequestStat.declined,
                                                        RequestStat.completed
                                                        };
                            }
                            <div class="form-group">
                                <label for="statusSelect" class="form-label">Select Order Status</label>
                                <select id="statusSelect" name="OrderStatus" class="form-select form-select-sm">
                                    <option value="" selected disabled>Select status</option>
                                    @foreach (var status in Enum.GetValues(typeof(RequestStat)).Cast<RequestStat>())
                                    {
                                        if (!excludedStatuses.Contains(status))
                                        {
                                            // Both the value and text will match the TypeScript casing
                                            <option value="@status.ToString()">@status</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light border-top">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary btn-sm" id="orderStatusButton" disabled>Submit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <h3>Order Details</h3>

    <div class="card" id="orderCard">
        <div class="row p-4">
            <div class="col-md-4">
                <div>
                    <span><strong>VoucherCode:</strong></span>
                    <span>@Model?.VoucherCode</span>
                </div>
                <div>
                    <span><strong>Expected Time Of Arrival:</strong></span>
                    <span>@(Model?.Activities?.Eta?.ToString("ddd, MMMM dd - hh:mm:ss tt") ?? "N/A")</span>
                </div>
                <div class="@(Model?.Activities?.ActualArrival == null ? "d-none" : "")">
                    <span><strong>Actual Arrival:</strong></span>
                    <span id="actualArrival">@(Model?.Activities?.ActualArrival?.ToString("ddd, MMMM dd - hh:mm:ss tt") ?? "N/A")</span>
                </div>
                <div class="d-flex d-inline-block">
                    <div>
                        @{
                            
                            var statusKey = Model?.Status?.ToLower() ?? "default";
                            var bgColor = statusColors.ContainsKey(statusKey) ? statusColors[statusKey] : statusColors["default"];
                        }
                        <div>
                            <span><strong>Order Status:</strong></span>
                            <div style="background-color: @bgColor;
                                border-radius: 10px;
                                color: @(bgColor == "red" || bgColor == "green" ? "white" : "black");
                                display: inline-block;
                                padding: 0px 8px;">
                                <strong class="@(bgColor == "lawngreen" || bgColor == "yellow" ? "text-black" : "text-white")" id="orderStatus">@Html.DisplayFor(model => model.Status) </strong>
                            </div>
                            <span class="text-info bg-aqua" id="sosReason">@(Model?.Status == "sos" && Model.SosReason != null ? $"{Model.SosReason}" : "")</span> 
                            @if (!string.IsNullOrWhiteSpace(Model?.PhotoAttachment))
                            {
                                <a href="#" class="zoomable" id="sosAttachment" data-img="@Model?.PhotoAttachment">Attachement</a>
                            }
                            @await Html.PartialAsync("_ImageModal")
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div>
                    <span><strong>Payment Method:</strong></span>
                    <span>@(Model?.PaymentMethod ?? "N/A")</span>
                </div>
                <div>
                    <span><strong>Customer Special Request:</strong></span>
                    <span>@(Model?.CustomerSpecialRequest ?? "N/A")</span>
                </div>
                @if (!string.IsNullOrEmpty(Model?.StatusReport))
                {
                    var rawText = WebUtility.HtmlDecode(Model?.StatusReport ?? "-");         // Step 1: Decode entities like &#x12DD;
                    var cleanText = Regex.Replace(rawText, "<.*?>", string.Empty);          // Step 2: Strip any actual HTML tags
                    <div>
                        <span><strong>Status Report:</strong></span>
                        <span>@cleanText</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model?.PreparationTime?.ToString()))
                {
                    <div>
                        <span><strong>Preparation Time:</strong></span>
                        <span>@(Model?.PreparationTime) min</span>
                    </div>
                }
            </div>
            <div class="col-12 col-md-4 d-flex justify-content-md-end justify-content-start text-md-end text-start">
                <div class="d-flex flex-column">
                    <div class="mb-1">
                        <span>
                            <strong>
                                @(Model?.CreatedAt != null
                                    ? new DateTimeOffset(DateTime.SpecifyKind(Model.CreatedAt.Value, DateTimeKind.Utc))
                                    .ToOffset(TimeSpan.FromHours(3))
                                    .ToString("ddd, MMMM dd, yyyy - hh:mm:ss tt")
                                    : "")
                            </strong>
                        </span>
                    </div>
                    <div>
                        @{
                            var isDriverPhoneInvalid = string.IsNullOrEmpty(phoneNumber) || phoneNumber.Length < 10;
                            <div class="row">
                                <div class="col-12">
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#sendAlertModal">
                                        Send Alert
                                    </button>
                                    <div style="display: inline-block;">
                                        <div id="driverPhoneWarning"
                                             class="@(isDriverPhoneInvalid ? "" : "d-none") p-2 badge bg-danger"
                                             >
                                            <strong class="text-white">Driver Not Available</strong>
                                        </div>

                                        <a id="trackDriverLink"
                                           class="btn btn-outline-success btn-sm @(isDriverPhoneInvalid ? "d-none" : "")"
                                           style="text-decoration: none"
                                           href="/driverdetail/@phoneNumber">
                                            Track Driver
                                        </a>
                                    </div>
                                    
                                </div>
                            </div>
                            <div class="row mt-1">
                                <div class="col-12">
                                    @if (!(Model?.Activities?.ActivityResponse?.Any(x =>
                                            string.Equals(x?.Name, "Order Delivery accepted by the Supervisor", StringComparison.OrdinalIgnoreCase)
                                            ) ?? false))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" id="supervisorAccept"
                                                data-tin="@Model?.CompanyTin"
                                                data-voucher-code="@Model?.VoucherCode"
                                                data-client-phone="@Model?.CustomerPhoneNumber"
                                                data-driver-phone="@Model?.AssignedDriverPhoneNumber"
                                                data-supervisor-phone="@Model?.SupervisedBy"
                                                data-supervisor-name="@Model?.SupervisorName"
                                                data-branch="@Model?.BranchName">
                                            Accept Order
                                        </button>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-warning @(Model?.Status?.ToLower() == "sos" ? "" : "d-none")" id="changeOrderStatus"
                                                data-voucher-code="@Model?.VoucherCode">
                                            Change Order Status
                                    </button>
                                </div>
                            </div>
                            
                        }
                        
                    </div>
                </div>
            </div>
        </div>

        <div class="row p-4 d-flex justify-content-evenly">

            <div class="col-md-3 mb-3">
                <h4 style="margin-bottom: 5px;"><i class="bi bi-person-circle icon"></i>Customer</h4>
                <div>
                    <span id="letters">Name:</span>
                    <span >@Model?.Customer?.FirstName</span>
                </div>
                <div>
                    <span id="letters">Address:</span>
                    <span >
                        @Model?.CustomerGeocodeAddress -
                        @Model?.CustomerSpecificAddress
                    </span>
                </div>
                <div>
                    <span id="letters">Phone:</span>
                    <span >@Model?.CustomerPhoneNumber</span>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <h4 style="margin-bottom: 5px;"><i class="bi bi-building icon"></i>Company</h4>
                <div>
                    <span id="letters">Name:</span>
                    <span >@Html.DisplayFor(model => model.CompanyName)</span>
                </div>
                <div>
                    <span id="letters">Branch:</span>
                    <span >@Html.DisplayFor(model => model.BranchName)</span>
                </div>
                <div>
                    <span id="letters">TIN:</span>
                    <span >
                        @* <a asp-controller="Company" asp-action="Details" asp-route-id="@Model.companyTin">@Html.DisplayFor(model => model.companyTin)</a> *@
                        <a>@Html.DisplayFor(model => model.CompanyTin)</a>
                    </span>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <h4 style="margin-bottom: 5px;"> <i class="fa-sharp-duotone fa-solid fa-motorcycle"></i> Driver</h4>
                <div>
                    <span id="letters">Phone:</span>
                    <span id="driverPhoneNumber">
                        @(!string.IsNullOrEmpty(Model?.AssignedDriverPhoneNumber) ? Model.AssignedDriverPhoneNumber: "N/A")
                    </span>
                </div>
            </div>
            <div class="col-md-3">
                <h4 style="margin-bottom: 5px;"><i class="bi bi-person-circle icon"></i>Supervisor</h4>
                <div>
                    <span id="letters">Phone:</span>
                    <span >
                        @(Model?.SupervisedBy ?? "Not Assigned")
                    </span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model?.SupervisorName))
                {
                    <div>
                        <span id="letters">Name:</span>
                        <span >
                            @Model?.SupervisorName
                        </span>
                    </div>
                }
            </div>
        </div>
        @await Html.PartialAsync("_LineItemDetail", Model?.LineItemsDetail ?? new LineItemsDetail())
    </div>
</div>
@await Html.PartialAsync("_DeliveryActivity", Model?.Activities ?? new DeliveryMonitoring.Models.Activities())
@section Scripts{
    <script>
        window.customerDeviceId = '@Model?.CustomerDeviceID';
        window.voucherCode = '@Model?.VoucherCode';
    </script>
    <script src="~/js/order-details.js" asp-append-version="true"></script>
}