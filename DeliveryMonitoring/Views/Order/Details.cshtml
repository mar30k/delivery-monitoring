@model DeliveryMonitoring.Models.OrderDetail

@{
    ViewData["Title"] = "Order Details";
    var phoneNumber = Model.assignedDriverPhoneNumber;
}

<div class="container-fluid col-11 pt-5">
    <h3>Order Details</h3>
    <div class="card border-0" style="border-radius: 0px;" id="orderCard">
        <br />
        <div class="row">
            <div class="col-11 col-md-6" id="orderDetail">
                <div>
                    <span><strong>@Html.DisplayNameFor(model => model.voucherCode):</strong></span>
                    <span><strong>@Html.DisplayFor(model => model.voucherCode)</strong></span>
                </div>
                <div>
                    @DateTimeOffset.FromUnixTimeMilliseconds(Model.requestCreatedAt).DateTime.ToString("HH:mm:ss - ddd, MMMM dd, yyyy")
                </div>
                <div class="d-flex d-inline-block">
                    <div id="status">
                        <strong>@Html.DisplayFor(model => model.status)</strong>
                    </div>
                </div>
            </div>

            <div class="pt-3 col-12 col-md-5 d-flex justify-content-end">
                <div>
                    @{
                        if (phoneNumber != null && phoneNumber.Length < 10)
                        {
                            <div style="background-color: red;
                                                                border-radius: 20px;
                                                                color: black;
                                                                display: inline-block;
                                                                padding: 5px 5px;">
                                <strong>Driver Not Assigned</strong>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-dark" asp-controller="Driver" asp-action="Details" asp-route-id="@phoneNumber">Check Order Status</a>
                        }
                    }
                </div>
            </div>
        </div>
        <br />
        <br />

        <div class="row">
            <!--Customer Details-->
            <div class="col-12 col-md-4 detail" id="orderDetail">
                <h4><i class="bi bi-person-circle icon"></i>Customer</h4>
                <div>
                    <span id="letters">Name:</span>
                    <span id="outputs">@Html.DisplayFor(model => model.customer.firstName)</span>
                </div>
                <div>
                    <span id="letters">Address:</span>
                    <span id="outputs">
                        @Html.DisplayFor(model => model.customer.geocodeAddress) -
                        @Html.DisplayFor(model => model.customer.specificAddress)
                    </span>
                </div>
                <div>
                    <span id="letters">Phone:</span>
                    <span id="outputs">@Html.DisplayFor(model => model.customer.phoneNumber)</span>
                </div>
                <div>
                    <span id="letters">Device ID:</span>
                    <span id="outputs">@Html.DisplayFor(model => model.customer.deviceId)</span>
                </div>
            </div>
            <!--Customer Details Ends Here-->
            <!--Company Details-->
            <div class="col-12 col-md-4 detail">
                <h4><i class="bi bi-building icon"></i>Company</h4>
                <div>
                    <span id="letters">Branch Name:</span>
                    <span id="outputs">@Html.DisplayFor(model => model.branchName)</span>
                </div>
                <div>
                    <span id="letters">TIN:</span>
                    <span id="outputs">
                        <a asp-controller="Company" asp-action="Details" asp-route-id="@Model.companyTin">@Html.DisplayFor(model => model.companyTin)</a>
                        
                    </span>
                </div>
                
            </div>
            <!--Company Details Ends Here-->
            <!--Driver Details-->
            <div class="col-12 col-md-3">
                <h4><i class="bi bi-car-front icon"></i>Driver</h4>
                <div>
                    <span id="letters">Phone:</span>
                    <span id="outputs">@Html.DisplayFor(model => model.assignedDriverPhoneNumber)</span>
                </div>
            </div>
            <!--Driver Details Ends Here-->

        </div>
        <br />
        <br />
        <!--Order Items Table-->
        <h4 id="orderDetail">Products</h4>
        <div class="col-11 table-responsive table-bordered" id="orderDetail">
            <table class="table pt-3" id="orderTable">
                <thead class="table-secondary">
                    <tr>
                        <th>
                            Item Name
                        </th>
                        <th>
                            Note
                        </th>
                        <th>
                            Quantity
                        </th>
                        <th>
                            Unit Amount
                        </th>
                        <th>
                            Total Amount
                        </th>
                        <th>
                            Tax Value
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.LineItems)
                    {
                        double multiplicaitonValue = (100 + item.taxValue)/100;
                        double beforeTax = item.unitAmount * multiplicaitonValue;
                        beforeTax = Math.Round(beforeTax, 2);
                        <tr>

                            <td>
                                @Html.DisplayFor(modelItem => item.articleName)
                            </td>
                            <td>
                                @{
                                    if (item.lineItemNote.Length == 0)
                                    {
                                        <span>Empty Note</span>
                                    }
                                    else
                                    {
                                        @Html.DisplayFor(modelItem => item.lineItemNote)
                                    }
                                }

                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.quantity)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.unitAmount) ETB
                            </td>
                            <td>
                               @beforeTax ETB
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.taxValue)%
                            </td>
                        </tr>
                    }
                    <tr>

                        <td>
                            Total
                        </td>
                        <td>
                            -
                        </td>
                        @{
                            int sum = 0;
                            foreach(var item in Model.LineItems)
                            {
                                sum += item.quantity;
                            }
                        }
                        <td>
                            @sum
                        </td>
                        @{
                            double Amount = 0;
                            foreach (var item in Model.LineItems)
                            {
                                Amount += item.unitAmount;
                            }
                        }
                        <td>
                            @Amount ETB
                        </td>
                        @{
                            double totalAmount = 0;
                            foreach (var item in Model.LineItems)
                            {
                                double multiplicaitonValue = (100 + item.taxValue) / 100;
                                double beforeTax1 = item.unitAmount * multiplicaitonValue;
                                beforeTax1 = Math.Round(beforeTax1, 2);
                                totalAmount += beforeTax1;
                                totalAmount = Math.Round(totalAmount, 2);
                            }
                        }
                        <td>
                            @totalAmount ETB
                        </td>

                        <td>
                            -
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <br />
        <br />
        <!--Order Items Table Ends Here-->
        <!--Activity Timeline-->
        <h4 id="orderDetail">Activity</h4>
        <div class="col-11 table-responsive table-bordered" id="orderDetail">
            <table class="table pt-3" id="orderTable">
                <tr>
                    <td class="table-secondary col-6">
                        @Html.DisplayNameFor(model => model.isAssignedAck)
                    </td>
                    <td>
                        @if (Model.isAssignedAck == true)
                        {
                            <span style="color:green;"><i class="bi bi-check2-circle"></i>&nbsp;Yes</span>
                        }
                        else
                        {
                            <span style="color:red;"><i class="bi bi-x-circle"></i>&nbsp;No</span>
                        }
                    </td>
                </tr>

                <tr>
                    <td class="table-secondary col-6">
                        @Html.DisplayNameFor(model => model.isNoDriversAck)
                    </td>
                    <td>
                        @if (Model.isNoDriversAck == true)
                        {
                            <span style="color:green;"><i class="bi bi-check2-circle"></i>&nbsp;Yes</span>
                        }
                        else
                        {
                            <span style="color:red;"><i class="bi bi-x-circle"></i>&nbsp;No</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="table-secondary col-6">
                        @Html.DisplayNameFor(model => model.orderArrivedAckByCustomer)
                    </td>
                    <td>
                        @if (Model.orderArrivedAckByCustomer == true)
                        {
                            <span style="color:green;"><i class="bi bi-check2-circle"></i>&nbsp;Yes</span>
                        }
                        else
                        {
                            <span style="color:red;"><i class="bi bi-x-circle"></i>&nbsp;No</span>
                        }
                    </td>

                </tr>


                <tr>
                    <td class="table-secondary col-6">
                        @Html.DisplayNameFor(model => model.orderArrivedAckByDriver)
                    </td>


                    <td>
                        @if (Model.orderArrivedAckByDriver == true)
                        {
                            <span style="color:green;"><i class="bi bi-check2-circle"></i>&nbsp;Yes</span>
                        }
                        else
                        {
                            <span style="color:red;"><i class="bi bi-x-circle"></i>&nbsp;No</span>
                        }
                    </td>
                </tr>

            </table>
        </div>
        <!--Activity Timeline-->

        <div id="orderDetail">
            <a class="btn btn-dark" asp-action="Index">Back to List</a>
        </div>

        <br />
    </div>

</div>

