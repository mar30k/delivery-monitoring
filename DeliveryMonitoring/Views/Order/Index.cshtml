@using System.Text.RegularExpressions
@using System.Net
@using DeliveryMonitoring.Helpers
@model OrderViewModel

@{
    ViewData["Title"] = "List of Orders";
}
<div class="p-4 mt-2">
    <div id="alertContainer" style="position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 1050; width: auto;"></div>
    @if (TempData["Message"] != null)
    {
        <div id="tempAlert" class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <script>
            setTimeout(function () {
                var alertBox = document.getElementById('tempAlert');
                if (alertBox) {
                    alertBox.classList.remove('show');
                    alertBox.classList.add('fade');
                    alertBox.style.display = 'none';
                }
            }, 5000);
        </script>
    }
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <h3 class="mb-0">Delivery Orders</h3>
    </div>

    <div class="row card">
        <div class="table-responsive pt-3 pb-3">
            <table class="table compact stripe hover pt-3" id="deliveryOrders" style="font-size: 13px;">
                <thead class="">
                    <tr >
                        <th>
                            Order Number
                        </th>
                        <th class="text-center">
                            Company
                        </th>
                        <th class="text-center">
                            Branch
                        </th>
                        <th class="text-center">
                            Customer
                        </th>
                        <th class="text-center">
                            Phone Number
                        </th>                       
                        <th class="text-center">
                            Customer Adresss
                        </th>
                        <th class="text-center">
                            Order DateTime
                        </th>
                        <th class="text-center">
                            Eta
                        </th>
                        <th class="text-center">
                            Eta Diff
                        </th>
                        <th class="text-center">
                            Status
                        </th>                                                                 
                        <th class="text-center">
                            Status Report
                        </th>                                                                 
                        <th class="text-center">
                            Order Printed
                        </th>                                                                 
                        <th class="text-center">
                            Driver
                        </th>
                        <th class="text-center">
                            Supervisor
                        </th>
                        <th class="text-center">
                            Total
                        </th>
                        <th class="text-center">
                            Payment Method
                        </th>
                        <th style="text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th colspan="13" class="text-end">Page Total:</th>
                        <th class="text-center"></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>@* 
            <a class="btn btn-outline-dark btn-sm"
               data-order='@Html.Raw(testJsonOrder)'
               onclick="openRedispatchModal(this)"
               id="@testOrder.VoucherCode?.ToString()">
                Redispatch
            </a>  <a class="btn btn-outline-dark btn-sm" onclick="openAssignSupervisorModal('@testOrder.VoucherCode')">Assign</a> 
            <a onclick="openChangeBranchModal('@testOrder?.CompanyTin','@testOrder?.CompanyName','@testOrder?.BranchName', '@testOrder?.VoucherCode')"> <i class="fa-solid fa-pen-to-square"></i></a> *@
            

        </div>

        <partial name="~/Views/Shared/ActionModals/_RedispatchModal.cshtml" />
        <partial name="~/Views/Shared/ActionModals/_SupervisorAssignment.cshtml" />
        <partial name="~/Views/Shared/ActionModals/_ChangeBranchModal.cshtml" />        
</div>
@section Scripts {
    <script>
        window.fetchAlertsFlag = true;
    </script>
    <link rel="stylesheet" href="~/css/header-filters.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css">
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="~/js/date-range.js" asp-append-version="true"></script>
    <script src="~/js/table-auto-refresher.js" asp-append-version="true"></script>
    <script src="~/js/header-filter-dropdown.js" asp-append-version="true"></script>
    <script src="~/js/datatable-renderers.js" asp-append-version="true"></script>
    <script src="~/js/datatable-init.js" asp-append-version="true"></script>
    <script src="~/js/modules/branch-change.js" type="module" asp-append-version="true"></script>
    <script src="~/js/modules/dashboard-api.js" type="module" asp-append-version="true"></script>
    <script src="~/js/modules/dispatch.js" type="module" asp-append-version="true"></script>
    <script src="~/js/modules/supervisor.js" type="module" asp-append-version="true"></script>
    <script src="~/js/modules/ui.js" type="module" asp-append-version="true"></script>
    <script type="module">
        import { OrdersTable } from '/js/delivery-orders-table.js?v=@DateTime.Now.Ticks';
        const { table, dateRange } = await OrdersTable.init({
            tableId: "deliveryOrders",
            ajaxUrl: "/getOrders",
        });
    </script>
}
