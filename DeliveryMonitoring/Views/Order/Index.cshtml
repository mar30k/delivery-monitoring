@model OrderViewModel

@{
    ViewData["Title"] = "List of Orders";
    var disTinctSupervisors = Model?.OrderDetail?.DistinctBy(x => x.SupervisedBy).Where(x=> x.SupervisedBy!= null).ToList();
}
<div class="p-4 mt-2">
    <div id="alertContainer" style="position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 1050; width: auto;"></div>
    @if (TempData["Message"] != null)
    {
        <div id="tempAlert" class="alert alert-warning alert-dismissible fade show" role="alert" >
            @TempData["Message"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <script>
            setTimeout(function () {
                var alertBox = document.getElementById('tempAlert');
                if (alertBox) {
                    alertBox.classList.remove('show');
                    alertBox.classList.add('fade');
                    alertBox.style.display = 'none';
                }
            }, 5000);
        </script>
    }
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <h3 class="mb-0">List of Orders</h3>
        <div class="d-flex align-items-center">
            <label for="supervisorSelect" class="form-label mb-0 me-2 fw-semibold">Supervisor:</label>
            <select id="supervisorSelect" class="form-select form-select-sm" style="width: auto; min-width: 200px;">
                <option value="" selected>All Supervisors</option>
                @foreach (var supervisor in disTinctSupervisors ?? new List<OrderDetail>())
                {
                    <option value="@supervisor.SupervisedBy">@Model?.Supervisors?.FirstOrDefault(x => x.UserName == @supervisor.SupervisedBy)?.FirstName @supervisor.SupervisedBy</option>
                }
            </select>
        </div>
    </div>

    <div class="row card">
        <div class="table-responsive pt-3 pb-3">
            <table class="table compact stripe hover pt-3" id="tablelist" style="font-size: 13px;">
                <thead class="">
                    <tr >
                        <th>
                            Order Number
                        </th>
                        <th class="text-center">
                            Customer
                        </th>
                        <th class="text-center">
                            Phone Number
                        </th>                       
                        <th class="text-center">
                            Customer Adresss
                        </th>
                        <th class="text-center">
                            Order DateTime
                        </th>
                        <th class="text-center">
                            Status
                        </th>                                                                 
                        <th class="text-center">
                            Driver
                        </th>
                        <th class="text-center">
                            Supervisor
                        </th>
                        <th class="text-center">
                            Total
                        </th>
                        <th style="text-align: center;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{

                        var statusColors = new Dictionary<string, string>
                        {
                            { "requested", "deepskyblue" },
                            { "arrivedatbranch", "orange" },
                            { "assigned", "lawngreen" },
                            { "declined", "red" },
                            { "accepted", "seagreen" },
                            { "arrived", "coral" },
                            { "ontheway", "darkorange" },
                            { "drivernotfound", "firebrick" },
                            { "sos", "darkred" },
                            { "default", "yellow" }
                        };
                        var voucher = "0939977886-111428-646";
                        var testOrder = new OrderDetail
                        {
                            AssignedDriverPhoneNumber = "0912345678",
                            BranchName = "Main Branch",
                            CompanyCode = 101,
                            CompanyName = "Test Company",
                            CompanyTin = "123456789",
                            SosReason = "",
                            Customer = new CustomerDetail
                            {
                                FirstName = "John",
                                PhoneNumber = "0910000000",
                                GeocodeAddress = "123 Test St",
                                SpecificAddress = "Apt 5B",
                                DeviceID = "DEVICE123",
                                LatLng = new Location
                                {
                                    lat = 9.145,
                                    lng = 40.4897
                                }
                            },
                            DriverAssignedAt = DateTimeOffset.Now.ToUnixTimeMilliseconds(),
                            IsAssignedAck = false,
                            IsNoDriversAck = false,
                            OrderArrivedAckByCustomer = false,
                            OrderArrivedAckByDriver = false,
                            RequestCreatedAt = DateTimeOffset.Now.ToUnixTimeMilliseconds(),
                            RequestCreatedAtIso = DateTime.Now,
                            Status = "DriverNotFound",
                            VoucherCode = "0939977886-152027-221",
                            Platform = "Web",
                            TargetBranchLocation = new Location
                            {
                                lat = 9.034,
                                lng = 38.746
                            }
                        };

                        var testJsonOrder = System.Text.Json.JsonSerializer.Serialize(testOrder, new System.Text.Json.JsonSerializerOptions
                        {
                            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
                            WriteIndented = false
                        });
                        foreach (var order in Model?.OrderDetail ?? new List<OrderDetail>())
                        {
                            var statusKey = order?.Status?.ToLower() ?? "default"; 
                            var bgColor = statusColors.ContainsKey(statusKey)?  statusColors[statusKey] : statusColors["default"];
                            var orderTime = order?.CreatedAt != null ? new DateTimeOffset(DateTime.SpecifyKind(order.CreatedAt.Value, DateTimeKind.Utc))
                                    .ToOffset(TimeSpan.FromHours(3))
                                    .ToString("yyyy-MM-dd HH:mm:ss") : "";

                            <tr data-voucher="@order?.VoucherCode" data-supervisor="@order?.SupervisedBy" style="font-size: 13px;">
                                <td>
                                    @order?.VoucherCode
                                </td>
                                <td class="text-center">
                                    @(order?.CustomerFirstName ?? "N/A")
                                </td>
                                <td class="text-center">
                                    <a href="tel:@order?.CustomerPhoneNumber">
                                        @(order?.CustomerPhoneNumber ?? "N/A")
                                    </a>
                                </td>
                                <td class="text-center">
                                    @($"{order?.CustomerGeocodeAddress} - {order?.CustomerSpecificAddress}")
                                </td>
                                
                                <td data-order="@order?.CreatedAt?.ToString(" yyyy-MM-ddTHH:mm:ss")" data-iso="@orderTime" class="text-center">
                                    @*@order?.CreatedAt.ToString("ddd, MMMM dd, yyyy - hh:mm:ss")*@
                                    @orderTime
                                </td>
                                <td class="status-cell text-center @(bgColor == "lawngreen" || bgColor == "yellow" ? "text-black" : "text-white")" style="background: @bgColor">
                                    @order?.Status
                                </td>
                                <td class="driver-cell text-center" >
                                    @if (!string.IsNullOrWhiteSpace(order?.AssignedDriverPhoneNumber))
                                    {
                                        <a href="tel:@order.AssignedDriverPhoneNumber">@order.AssignedDriverPhoneNumber</a>
                                    }
                                    else
                                    {
                                        @:N/A
                                    }
                                </td>
                                <td class="text-center">
                                    @if (order?.SupervisedBy == null)
                                    {
                                        <a class="btn btn-outline-dark btn-sm" onclick="openAssignSupervisorModal('@order?.VoucherCode')">Assign</a>
                                    }
                                    else
                                    {
                                        var supervisor = Model?.Supervisors?.FirstOrDefault(x => x.UserName == @order?.SupervisedBy);
                                        <a href="tel: @order?.SupervisedBy">@(supervisor!=null ?@supervisor?.FirstName  + " "+ supervisor?.SecondName : @order?.SupervisedBy) </a> <a onclick="openAssignSupervisorModal('@order?.VoucherCode')"> <i class="fa-solid fa-pen-to-square"></i></a>
                                    }
                                </td>
                                <td class="text-center">
                                    @order?.GrandTotal?.ToString("N2")
                                </td>


                                <td style="text-align: center; vertical-align: middle;">
                                    <div style="display: inline-block;">
                                        <a class="btn btn-outline-dark btn-sm" href="/order/@order?.VoucherCode">Details</a>

                                        @if (order?.Status?.ToLower() == "drivernotfound" || order?.Status?.ToLower() == "declined" ||
                                         order?.Status?.ToLower() == "requested" || order?.Status?.ToLower() == "sos" || order?.Status?.ToLower() == "assigned")
                                        {
                                            order.Status = "requested";
                                            order.IsAssignedAck = false;
                                            order.IsNoDriversAck = false;
                                            order.OrderArrivedAckByCustomer = false;
                                            order.OrderArrivedAckByDriver = false;
                                            order.OrderReceiveNotification = null;
                                            order.Alert = null;
                                            order.DriverAssignedAt = 0;
                                            var jsonOrder = System.Text.Json.JsonSerializer.Serialize(order, new System.Text.Json.JsonSerializerOptions
                                            {
                                                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
                                                WriteIndented = false
                                            });
                                            <a class="btn btn-outline-dark btn-sm"
                                               data-order='@Html.Raw(jsonOrder)'
                                               onclick="openRedispatchModal(this)"
                                               id="@order?.VoucherCode?.ToString()"
                                               >
                                                Redispatch
                                            </a>
                                        }
                                    </div>
                                </td>
                                
                            </tr>
                        }
                    }
                </tbody>
            </table>
@*             <a class="btn btn-outline-dark btn-sm"
               data-order='@Html.Raw(testJsonOrder)'
               onclick="openRedispatchModal(this)"
               id="@testOrder.VoucherCode.ToString()">
                Redispatch
            </a>  <a class="btn btn-outline-dark btn-sm" onclick="openAssignSupervisorModal('@voucher')">Assign</a> *@
           
        </div>

        <!-- Re-dispatch Modal -->
        <div class="modal fade" id="reDispatchModal" tabindex="-1" aria-labelledby="reDispatchModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content shadow">
                    <div class="modal-header bg-secondary text-white">
                        <h5 class="modal-title" id="reDispatchModalLabel">Re-dispatch Order <span id="voucherCodeLabel" class="text-warning fw-normal"></span></h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <p class="mb-3 text-muted">Choose how you want to re-dispatch the order:</p>

                        <button class="btn btn-outline-primary w-100 mb-3" id="confirmRedispatchToAll" onclick="confirmRedispatchToAll()">
                            🔄 Re-dispatch to All Available Drivers
                        </button>

                        <hr class="my-3">

                        <label for="driverSelect" class="form-label fw-bold">Or select a specific driver:</label>
                        <select id="driverSelect" class="form-select mb-3">
                            <option value="" selected disabled>Loading drivers...</option>
                        </select>

                        <button class="btn btn-outline-success w-100 mt-2" onclick="confirmRedispatchToDriver()">
                            ✅ Dispatch to Selected Driver
                        </button>
                        <div id="dispatchLoading" class="text-center mt-4 d-none">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Dispatching...</span>
                            </div>
                            <p class="text-muted mt-2">Processing dispatch...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="assignSupervisor" tabindex="-1" aria-labelledby="assignSupervisorModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content shadow">
                    <div class="modal-header bg-secondary text-white">
                        <h5 class="modal-title" id="assignSupervisorModalLabel">Assign Supervisor Order <span id="assignVoucherCodeLabel" class="text-warning fw-normal"></span></h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <p class="mb-3 text-muted">Choose how you want to assign supervisor to the order:</p>

                        <button class="btn btn-outline-primary w-100 mb-3" id="confirmAssignToAll" onclick="confirmAssignToAll()">
                            🔄 Assign to Available Supervisors Randomly
                        </button>

                        <hr class="my-3">

                        <label for="modalSupervisorSelect" class="form-label fw-bold">Or select a specific supervisor:</label>
                        <select id="modalSupervisorSelect" class="form-select mb-3">
                            <option value="" selected disabled>Loading supervisors...</option>
                        </select>

                        <button class="btn btn-outline-success w-100 mt-2" onclick="confirmAssignToSupervisor()">
                            ✅ Assign to Selected Supervisor
                        </button>
                        <div id="assignLoading" class="text-center mt-4 d-none">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Assigning...</span>
                            </div>
                            <p class="text-muted mt-2">Processing supervisor assignment...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/orders.js"></script>
}
