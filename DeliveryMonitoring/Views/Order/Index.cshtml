@using System.Text.RegularExpressions
@using System.Net
@using DeliveryMonitoring.Helpers
@model OrderViewModel

@{
    ViewData["Title"] = "List of Orders";
    var disTinctSupervisors = Model?.OrderDetail?.DistinctBy(x => x.SupervisedBy).Where(x=> x.SupervisedBy!= null).ToList();
}
<div class="p-4 mt-2">
    <div id="alertContainer" style="position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 1050; width: auto;"></div>
    @if (TempData["Message"] != null)
    {
        <div id="tempAlert" class="alert alert-warning alert-dismissible fade show" role="alert" >
            @TempData["Message"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <script>
            setTimeout(function () {
                var alertBox = document.getElementById('tempAlert');
                if (alertBox) {
                    alertBox.classList.remove('show');
                    alertBox.classList.add('fade');
                    alertBox.style.display = 'none';
                }
            }, 5000);
        </script>
    }
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <h3 class="mb-0">List of Orders</h3>
        <div class="d-flex align-items-center">
            <label for="supervisorSelect" class="form-label mb-0 me-2 fw-semibold">Supervisor:</label>
            <select id="supervisorSelect" class="form-select form-select-sm" style="width: auto; min-width: 200px;">
                <option value="" selected>All Supervisors</option>
                @foreach (var supervisor in disTinctSupervisors ?? new List<OrderDetail>())
                {
                    <option value="@supervisor.SupervisedBy">@Model?.Supervisors?.FirstOrDefault(x => x.UserName == @supervisor.SupervisedBy)?.FirstName @supervisor.SupervisedBy</option>
                }
            </select>
        </div>
    </div>

    <div class="row card">
        <div class="table-responsive pt-3 pb-3">
            <table class="table compact stripe hover pt-3" id="deliveryOrders" style="font-size: 13px;">
                <thead class="">
                    <tr >
                        <th>
                            Order Number
                        </th>
                        <th class="text-center">
                            Company
                        </th>
                        <th class="text-center">
                            Branch
                        </th>
                        <th class="text-center">
                            Customer
                        </th>
                        <th class="text-center">
                            Phone Number
                        </th>                       
                        <th class="text-center">
                            Customer Adresss
                        </th>
                        <th class="text-center">
                            Order DateTime
                        </th>
                        <th class="text-center">
                            Eta
                        </th>
                        <th class="text-center">
                            Status
                        </th>                                                                 
                        <th class="text-center">
                            Status Report
                        </th>                                                                 
                        <th class="text-center">
                            Order Printed
                        </th>                                                                 
                        <th class="text-center">
                            Driver
                        </th>
                        <th class="text-center">
                            Supervisor
                        </th>
                        <th class="text-center">
                            Total
                        </th>
                        <th class="text-center">
                            Payment Method
                        </th>
                        <th style="text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th colspan="13" class="text-end">Page Total:</th>
                        <th class="text-center"></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>@* 
            <a class="btn btn-outline-dark btn-sm"
               data-order='@Html.Raw(testJsonOrder)'
               onclick="openRedispatchModal(this)"
               id="@testOrder.VoucherCode?.ToString()">
                Redispatch
            </a>  <a class="btn btn-outline-dark btn-sm" onclick="openAssignSupervisorModal('@testOrder.VoucherCode')">Assign</a> 
            <a onclick="openChangeBranchModal('@testOrder?.CompanyTin','@testOrder?.CompanyName','@testOrder?.BranchName', '@testOrder?.VoucherCode')"> <i class="fa-solid fa-pen-to-square"></i></a> *@
            

        </div>

        <!-- Re-dispatch Modal -->
        <div class="modal fade" id="reDispatchModal" tabindex="-1" aria-labelledby="reDispatchModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content shadow">
                    <div class="modal-header bg-secondary text-white">
                        <h5 class="modal-title text-white" id="reDispatchModalLabel">Re-dispatch Order <span id="voucherCodeLabel" class="text-warning fw-normal"></span></h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <p class="mb-3 text-muted">Choose how you want to re-dispatch the order:</p>

                        <button class="btn btn-outline-primary w-100 mb-3" id="confirmRedispatchToAll" onclick="confirmRedispatchToAll()">
                            🔄 Re-dispatch to All Available Drivers
                        </button>

                        <hr class="my-3">

                        <label for="driverSelect" class="form-label fw-bold">Or select a specific driver:</label>
                        <select id="driverSelect" class="form-select mb-3">
                            <option value="" selected disabled>Loading drivers...</option>
                        </select>

                        <button class="btn btn-outline-success w-100 mt-2" onclick="confirmRedispatchToDriver()">
                            ✅ Dispatch to Selected Driver
                        </button>
                        <div id="dispatchLoading" class="text-center mt-4 d-none">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Dispatching...</span>
                            </div>
                            <p class="text-muted mt-2">Processing dispatch...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assign Supervisor Modal -->
        <div class="modal fade" id="assignSupervisor" tabindex="-1" aria-labelledby="assignSupervisorModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content shadow">
                    <div class="modal-header bg-secondary text-white">
                        <h5 class="modal-title text-white" id="assignSupervisorModalLabel">Assign Supervisor Order <span id="assignVoucherCodeLabel" class="text-warning fw-normal"></span></h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
@*                         <p class="mb-3 text-muted">Choose how you want to assign supervisor to the order:</p>

                        <button class="btn btn-outline-primary w-100 mb-3" id="confirmAssignToAll" onclick="confirmAssignToAll()">
                            🔄 Assign to Available Supervisors Randomly
                        </button>

                        <hr class="my-3">
 *@
                        <label for="modalSupervisorSelect" class="form-label fw-bold"> Select supervisor to be assigned:</label>
                        <select id="modalSupervisorSelect" class="form-select mb-3">
                            <option value="" selected disabled>Loading supervisors...</option>
                        </select>

                        <button class="btn btn-outline-success w-100 mt-2" onclick="confirmAssignToSupervisor()">
                            ✅ Assign to Selected Supervisor
                        </button>
                        <div id="assignLoading" class="text-center mt-4 d-none">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Assigning...</span>
                            </div>
                            <p class="text-muted mt-2">Processing supervisor assignment...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Change Branch Modal -->
        <div class="modal fade" id="changeBranchModal" tabindex="-1" aria-labelledby="changeBranchModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content shadow">
                    <div class="modal-header bg-secondary text-white">
                        <h5 class="modal-title text-white" id="changeBranchModalLabel">
                            Change Branch for <span id="companyNameLable" class="text-warning fw-normal"></span>
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <!-- Voucher Code (readonly) -->
                        <label for="voucherCodeInput" class="form-label fw-bold">Voucher Code:</label>
                        <input id="voucherCodeInput"
                               type="text"
                               class="form-control mb-3"
                               placeholder="No voucher assigned"
                               readonly />

                        <!-- Branch Select -->
                        <label for="branchSelectDropdown" class="form-label fw-bold">Select a branch:</label>
                        <select id="branchSelectDropdown" class="form-select mb-3">
                            <option selected disabled>Loading branches...</option>
                        </select>

                        <!-- Remark Text Area -->
                        <label for="remarkInput" class="form-label fw-bold">Remark:</label>
                        <textarea id="remarkInput"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Add an optional remark..."></textarea>

                        <button class="btn btn-outline-success w-100 mt-2" onclick="confirmBranchChange()">
                            ✅ Change Branch
                        </button>

                        <div id="branchChangeLoading" class="text-center mt-4 d-none">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="text-muted mt-2">Processing branch change...</p>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <link rel="stylesheet" href="~/css/header-filters.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css">
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="~/js/date-range.js" asp-append-version="true"></script>
    <script src="~/js/table-auto-refresher.js" asp-append-version="true"></script>
    <script src="~/js/header-filter-dropdown.js" asp-append-version="true"></script>
    <script src="~/js/datatable-renderers.js" asp-append-version="true"></script>
    <script src="~/js/datatable-init.js" asp-append-version="true"></script>
    <script src="~/js/orders.js" asp-append-version="true"></script>
    <script type="module">
        import { OrdersTable } from '/js/delivery-orders-table.js?v=@DateTime.Now.Ticks';
        OrdersTable.init({
            tableId: "deliveryOrders",
            ajaxUrl: "/getOrders",
        });
    </script>
}
