@model SummaryTableConfig

@{
    ViewData["Title"] = Model.Title;
}

<div class="p-4 mt-2">
    <div class="row align-items-center justify-content-between p-2 mb-3">
        <div class="col-12 col-md-6 mb-2 mb-md-0">
            <div class="d-flex align-items-baseline">
                <h4 class="mb-0 me-2">@Model.Title</h4>
                <button class="btn btn-success btn-sm mb-2" id="exportToExcelBtn">
                    Export Table To Excel
                </button>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="d-flex flex-wrap justify-content-md-end align-items-center gap-2">
                <label for="dateRange" class="form-label mb-0 fw-semibold">Filter by Date:</label>
                <input type="text" id="dateRange" class="form-control" 
                       placeholder="@DateTime.Today:yyyy-MM-dd to @DateTime.Today:yyyy-MM-dd"
                       style="max-width: 220px;" readonly />
            </div>
        </div>
    </div>

    <div class="row card">
        <div class="table-responsive pt-3 pb-3">
            <table class="table compact stripe hover pt-3" id="@Model.TableId" style="font-size: 13px;">
                <thead>
                    @if (Model.Type == "merchant")
                    {
                        <tr>
                            <th class="text-center">Tin</th>
                            <th class="text-center">Company Name</th>
                            <th class="text-center">Branch Name</th>

                            <!-- Dine-In Orders -->
                            <th class="text-center">Dine-In Orders</th>

                            <!-- Dine-In Amount -->
                            <th class="text-center">Dine-In Amount</th>

                            <!-- Takeaway Orders -->
                            <th class="text-center">Takeaway Orders</th>

                            <!-- Takeaway Amount -->
                            <th class="text-center">Takeaway Amount</th>

                            <!-- Delivery Orders -->
                            <th class="text-center">Delivery Orders</th>

                            <!-- Delivery Amount -->
                            <th class="text-center">Delivery Amount</th>

                            <!-- Grand Total -->
                            <th class="text-center">Grand Total</th>

                            <!-- Total Consignee Count -->
                            <th class="text-center">Total Consignee Count</th>
                        </tr>
                    }
                    else if (Model.Type == "consignee")
                    {
                        <tr>
                            <th class="text-center">Phone Number</th>
                            <th class="text-center">Name</th>

                            <!-- Dine-In Orders -->
                            <th class="text-center">Dine-In Orders</th>

                            <!-- Dine-In Amount -->
                            <th class="text-center">Dine-In Amount</th>

                            <!-- Takeaway Orders -->
                            <th class="text-center">Takeaway Orders</th>

                            <!-- Takeaway Amount -->
                            <th class="text-center">Takeaway Amount</th>

                            <!-- Delivery Orders -->
                            <th class="text-center">Delivery Orders</th>

                            <!-- Delivery Amount -->
                            <th class="text-center">Delivery Amount</th>

                            <!-- Grand Total -->
                            <th class="text-center">Grand Total</th>

                            <!-- Total Merchant Count -->
                            <th class="text-center">Total Merchant Count</th>
                        </tr>
                    }
                    else if (Model.Type == "driver")
                    {
                        <tr>
                            <th class="text-center">Phone Number</th>

                            <th class="text-center">Name</th>

                            <!-- Delivery Orders -->
                            <th class="text-center">Delivery Orders</th>

                            <!-- Delivery Amount -->
                            <th class="text-center">Delivery Amount</th>

                            <!-- Total Distance -->
                            <th class="text-center">Total Distance (km)</th>

                            <!-- Time Deviation -->
                            <th class="text-center">Total Eta Difference</th>

                            <!-- Average Rating -->
                            <th class="text-center">Average Rating</th>

                            <!-- Tip -->
                            <th class="text-center">Tip</th>

                            <!-- Total Consignee Count -->
                            <th class="text-center">Total Consignee Count</th>

                            <!-- Total Merchant Count -->
                            <th class="text-center">Total Merchant Count</th>
                        </tr>
                    }
                    else if (Model.Type == "supervisor")
                    {
                        <tr>
                            <th class="text-center">Phone Number</th>
                            <th class="text-center">Name</th>

                            <!-- Delivery Orders -->
                            <th class="text-center">Delivery Orders</th>

                            <!-- Delivery Amount -->
                            <th class="text-center">Delivery Amount</th>

                            <!-- Delivery Amount -->
                            <th class="text-center">Purpose Summary</th>

                            <!-- Total Consignee Count -->
                            <th class="text-center">Total Consignee Count</th>

                            <!-- Total Merchant Count -->
                            <th class="text-center">Total Merchant Count</th>
                        </tr>
                    }
                </thead>

                <tfoot>
                    <tr>
                        @if (Model.Type == "merchant")
                        {
                            <th colspan="3" class="text-end">Totals:</th>
                            <th></th>

                            <!-- Dine-In Orders -->
                            <th></th>

                            <!-- Dine-In Amount -->
                            <th></th>

                            <!-- Takeaway Orders -->
                            <th></th>

                            <!-- Takeaway Amount -->
                            <th></th>

                            <!-- Delivery Orders -->
                            <th></th>

                            <!-- Delivery Amount -->
                            <th></th>

                            <!-- Grand Total -->
                            <th></th>

                            <!-- Total Consignee Count -->
                        }
                        else if (Model.Type == "consignee")
                        {
                            <th colspan="2" class="text-end">Totals:</th>
                            

                            <!-- Dine-In Orders -->
                            <th></th>

                            <!-- Dine-In Amount -->
                            <th></th>

                            <!-- Takeaway Orders -->
                            <th></th>

                            <!-- Takeaway Amount -->
                            <th></th>

                            <!-- Delivery Orders -->
                            <th></th>

                            <!-- Delivery Amount -->
                            <th></th>

                            <!-- Grand Total -->
                            <th></th>

                            <!-- Total Merchant Count -->
                            <th></th>
                        }
                        else if (Model.Type == "driver")
                        {
                            <th colspan="2" class="text-end">Totals:</th>

                            <!-- Delivery Orders -->
                            <th></th>

                            <!-- Delivery Amount -->
                            <th></th>

                            <!-- Total Distance -->
                            <th></th>

                            <!-- Time Deviation -->
                            <th></th>

                            <!-- Average Rating -->
                            <th></th>

                            <!-- Tip -->
                            <th></th>

                            <!-- Total Consignee Count -->
                            <th></th>

                            <!-- Total Merchant Count -->
                            <th></th>
                        }
                        else if (Model.Type == "supervisor")
                        {
                            <th colspan="2" class="text-end">Totals:</th>

                            <!-- Delivery Orders -->
                            <th></th>

                            <!-- Delivery Amount -->
                            <th></th>

                            <!-- Purpose Summary -->
                            <th></th>

                            <!-- Total Consignee Count -->
                            <th></th>

                            <!-- Total Merchant Count -->
                            <th></th>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css">
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <link rel="stylesheet" href="~/css/header-filters.css" asp-append-version="true">
    <script src="~/js/header-filter-dropdown.js" asp-append-version="true"></script>
    <script src="~/js/summary-datatable.js" asp-append-version="true"></script>
    <script src="~/js/export-to-Excel.js" asp-append-version="true"></script>

    <script>
        let startDate = moment().startOf('day');
        let endDate = moment().endOf('day');

        js(() => {
            const tableSelector = "#@Model.TableId";
            const userType = "@Model.Type";
            const isMerchant = userType === "merchant";
            const isConsignee = userType === "consignee";
            const isDriver = userType === "driver";
            const isSupervisor = userType === "supervisor";

            const config = {
                tableSelector,
                ajaxUrl: "@Model.AjaxUrl",
                orderingColumn: isMerchant ? [2, "asc"] : [1, "asc"],
                headerFilterColumns: [],
                nonOrderableTargets: [0],
                columns: [],
                floatCols: [],
                intCols: [],
                avgCols: [],
            };

            if (isMerchant) {
                config.columns = [
                    { data: "tin", className: "text-center" },
                    { data: "companyName", className: "text-center" },
                    { data: "branchName", className: "text-center" },
                    { data: "totalDineInOrders", className: "text-center" },
                    { 
                        data: "dineInAmount",
                        className: "text-center",
                        render: function (d, type, row) {
                            if (type === 'sort' || type === 'type') return parseFloat(d) || 0; // keep numeric value for sorting
                            if (!d) return "0.00";
                            return parseFloat(d).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }   
                    },
                    { data: "totalTakeAwayOrders", className: "text-center" },
                    { 
                        data: "takeawayAmount", 
                        className: "text-center",
                        render: function (d, type, row) {
                            if (type === 'sort' || type === 'type') return parseFloat(d) || 0; // keep numeric value for sorting
                            if (!d) return "0.00";
                            return parseFloat(d).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }
                    },
                    { data: "totalDeliveryOrders", className: "text-center" },
                    { 
                        data: "deliveryAmount",
                        className: "text-center",
                        render: function (d, type, row) {
                            if (type === 'sort' || type === 'type') return parseFloat(d) || 0; // keep numeric value for sorting
                            if (!d) return "0.00";
                            return parseFloat(d).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }
                    },
                    { 
                        data: "grandTotal", 
                        className: "text-center",
                        render: function (d, type, row) {
                            if (type === 'sort' || type === 'type') return parseFloat(d) || 0; // keep numeric value for sorting
                            if (!d) return "0.00";
                            return parseFloat(d).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }
                    },
                    { data: "totalConsigneeCount", className: "text-center" }
                ];

                // merchant column indexes
                config.intCols = [3, 5, 7, 10];   // order counts
                config.floatCols = [4, 6, 8, 9];  // monetary values

                config.headerFilterColumns = [
                    { index: 1, name: 'Company Name' },
                    { index: 2, name: 'Branch Name' }
                ];
            } else if(isConsignee) {
                config.columns = [
                    { data: "phoneNumber", className: "text-center" },
                    { data: "name", className: "text-center" },
                    { data: "totalDineInOrders", className: "text-center" },
                    {
                        data: "dineInAmount", 
                        className: "text-center",
                        render: function (d, type, row) {
                            if (type === 'sort' || type === 'type') return parseFloat(d) || 0; // keep numeric value for sorting
                            if (!d) return "0.00";
                            return parseFloat(d).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }
                    },
                    { data: "totalTakeAwayOrders", className: "text-center" },
                    {
                        data: "takeawayAmount", 
                        className: "text-center",
                        render: function (d, type, row) {
                            if (type === 'sort' || type === 'type') return parseFloat(d) || 0; // keep numeric value for sorting
                            if (!d) return "0.00";
                            return parseFloat(d).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }

                    },
                    { data: "totalDeliveryOrders", className: "text-center" },
                    { 
                        data: "deliveryAmount", 
                        className: "text-center",
                        render: function (d, type, row) {
                            if (type === 'sort' || type === 'type') return parseFloat(d) || 0; // keep numeric value for sorting
                            if (!d) return "0.00";
                            return parseFloat(d).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }
                    },
                    { 
                        data: "grandTotal",
                        className: "text-center",
                        render: function (d, type, row) {
                            if (type === 'sort' || type === 'type') return parseFloat(d) || 0; // keep numeric value for sorting
                            if (!d) return "0.00";
                            return parseFloat(d).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }
                    },
                    { data: "totalMerchantCount", className: "text-center" }
                ];

                // consignee column indexes
                config.intCols = [2, 4, 6, 9];    // order counts
                config.floatCols = [3, 5, 7, 8];  // monetary values

                config.headerFilterColumns = [
                    { index: 1, name: 'Name' }
                ];
            }
            else if (isDriver) {
                config.columns = [
                    { data: "driverPhoneNumber", className: "text-center" },
                    { data: "name", className: "text-center" },
                    { data: "totalDeliveryOrders", className: "text-center" },
                    {
                        data: "deliveryAmount",
                        className: "text-center",
                        render: function (d, type, row) {
                            if (type === 'sort' || type === 'type') return parseFloat(d) || 0;
                            return (!d ? 0 : parseFloat(d)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }
                    },
                    {
                        data: "totalDistance",
                        className: "text-center",
                        render: function (d, type, row) {
                            if (type === 'sort' || type === 'type') return parseFloat(d) || 0;

                            var value = parseFloat(d) || 0;
                            return value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " km";
                        }
                    },
                    {
                        data: "totalTimeDeviation",
                        className: "text-center",
                        render: function (d, type, row) {
                            if (type === 'sort' || type === 'type')
                                return parseFloat(d) || 0;

                            var value = parseFloat(d) || 0;
                            var formatted = value.toLocaleString('en-US', {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            });

                            // Choose color based on value
                            var color = value > 0 ? "green" : value < 0 ? "red" : "gray";

                            // Return colored HTML
                            return `<span style="color:${color}; font-weight:600;">${formatted}</span>`;
                        }
                    },
                    {
                        data: "averageRating",
                        className: "text-center",
                        render: function (d, type, row) {
                            if (type === 'sort' || type === 'type') return parseFloat(d) || 0;

                            var value = parseFloat(d) || 0;

                            // Default color for zero
                            if (value === 0) return value;

                            // Map value 1-5 to color gradient (red → yellow → green)
                            // Simple linear interpolation using HSL: 0=red(0°), 5=green(120°)
                            var hue = ((value - 1) / 4) * 120; // 1=>0°, 5=>120°
                            var color = `hsl(${hue}, 70%, 40%)`;

                            var formatted = value.toFixed(2);

                            return `<span style="color:${color}; font-weight:600;">${formatted}</span>`;
                        }
                    },
                    {
                        data: "tip",
                        className: "text-center",
                        render: function (d, type, row) {
                            if (type === 'sort' || type === 'type') return parseFloat(d) || 0;
                            return (!d ? 0 : parseFloat(d)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }
                    },
                    { data: "totalConsigneeCount", className: "text-center" }, 
                    { data: "totalMerchantCount", className: "text-center" }
                ];

                config.intCols = [2];  // totalDeliveryOrders
                config.floatCols = [3, 4, 5, 7];  // totalDistance, tip, deliveryAmount, timeDeviation
                config.avgCols = [
                    {
                        index: 6, includeZeros: false
                    }
                ];
                config.headerFilterColumns = [
                    { index: 1, name: 'Name' }  // driverName column
                ];
            }
            else if (isSupervisor) {
                config.columns = [
                    { data: "supervisorPhoneNumber", className: "text-center" },
                    { data: "supervisorName", className: "text-center" },
                    { data: "totalDeliveryOrders", className: "text-center" },
                    {
                        data: "deliveryAmount",
                        className: "text-center",
                        render: function (d, type, row) {
                            if (type === 'sort' || type === 'type') return parseFloat(d) || 0;
                            return (!d ? 0 : parseFloat(d)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }
                    },
                    { data: "purposeSummary", className: "text-center" },
                    { data: "totalConsigneeCount", className: "text-center" },  
                    { data: "totalMerchantCount", className: "text-center" }  
                ];

                config.intCols = [2];  // totalDeliveryOrders
                config.floatCols = [3];  // deliveryAmount
                config.headerFilterColumns = [
                    { index: 1, name: 'Name' }  // supervisorName column
                ];
                config.nonOrderableTargets = [4];
            }
            initSummaryTable(config);

            $("#exportToExcelBtn").on("click", function () {
                exportTableToExcel({
                    tableSelector,
                    typePrefix: "@Model.Type" + "_Summary",
                    sheetName: "@Model.SheetName",
                    startDate: startDate,
                    endDate: endDate
                });
            });
        });
    </script>
}
