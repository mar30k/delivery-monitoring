@model List<SupervisorsDTO>
@{
    ViewData["title"] = "Supervisors";
}
<div class="p-4 mt-2">
    <h3 class="mb-4">KOT status</h3>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No records found.
        </div>
    }
    else
    {
        <div class="row card">
            <div class="pt-3 pb-3 col-12 col-xl-12 table-responsive">
                <table class="table compact stripe hover pt-3 mt-3" id="tablelist" style="font-size: 13px;">
                    <thead class="table-bordered">
                        <tr>
                            <th class="text-center">Full Name</th>
                            <th class="text-center">Phone Number</th>
                            <th class="text-center">LoggedIn Status</th>
                            <th class="text-center">Is Active</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var supervisor in Model ?? new List<SupervisorsDTO>())
                        {
                            <tr>
                                <td class="text-center">@supervisor.FirstName @supervisor.SecondName</td>
                                <td class="text-center">@supervisor.UserName</td>
                                <td class="text-center">@supervisor.LoggedInStatus</td>
                                <td class="text-center">@supervisor.IsActive</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }


</div>
@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.js"></script>
    <script>
        var js = jQuery.noConflict(true);
        var tablelist;
        js(document).ready(function () {
            tablelist = js('#tablelist').DataTable({
                responsive: true,
                "order": [[0, "asc"]],
                columnDefs: [
                    { orderable: false, targets: [1, 2, 3] }
                ],
                language: {
                    "emptyTable": "No information to display at the moment!"
                }
            });
        });
    </script>
}
