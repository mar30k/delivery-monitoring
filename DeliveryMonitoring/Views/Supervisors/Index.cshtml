@model OrderViewModel
@{
    ViewData["title"] = "Supervisors";
}
<div class="p-4 mt-2">
    <h3 class="mb-4">Supervisors</h3>
    @if (Model == null || !Model.Supervisors.Any())
    {
        <div class="alert alert-info">
            No records found.
        </div>
    }
    else
    {
        <div class="row card">
            <div class="pt-3 pb-3 col-12 col-xl-12 table-responsive">
                <table class="table compact stripe hover pt-3 mt-3" id="tablelist" style="font-size: 13px;">
                    <thead class="table-bordered">
                        <tr>
                            <th>Full Name</th>
                            <th class="text-center">Phone Number</th>
                            <th class="text-center">Logged In</th>
                            <th class="text-center">Supervised Orders</th>
                            <th class="text-center">Orders Count</th>
                            <th class="text-center">Orders Assigned</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var supervisor in Model?.Supervisors ?? new List<SupervisorsDTO>())
                        {
                            var orders = Model?.OrderDetail?.Where(o => o.SupervisedBy == supervisor.UserName).ToList();
                            int count = orders?.Count ?? 0;
                            <tr>
                                <td>@supervisor.FirstName @supervisor.SecondName</td>
                                <td class="text-center"><a href="tel: @supervisor.UserName">@supervisor.UserName</a></td>
                                <td class="text-center">@((supervisor.LoggedInStatus) ? "Yes" : "No")</td>
                                <td class="text-center">@supervisor.TotalSupervisedOrders</td>
                                <td class="text-center">@count</td>
                                <td class="text-center">
                                    @if (orders != null && orders.Any())
                                    {
                                        @Html.Raw(string.Join(", ", orders.Select(order => $"<a href='/order/{order.VoucherCode}'>{order.VoucherCode}</a>")))
                                    }
                                    else
                                    {
                                        <span class="text-danger">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="row g-3 mt-3">
        @{
            var activeSupervisorPhones = Model?.Supervisors?
                .Select(s => s.UserName)
                .ToHashSet() ?? new HashSet<string?>();

            foreach (var sup in Model?.CompletedOrders?
                .GroupBy(x => x.SupervisorPhoneNumber)
                .OrderByDescending(s => activeSupervisorPhones.Contains(s.Key)) // Active first
                .ThenBy(s => s.FirstOrDefault()?.SupervisorName) // Then sort alphabetically
                .ToList() ?? new List<IGrouping<string?, CompletedOrders>>())
            {
                var now = DateTime.Now;
                int currentYear = now.Year;
                int currentMonth = now.Month;
                int currentDay = now.DayOfYear;
                var supervisorPhone = sup.FirstOrDefault()?.SupervisorPhoneNumber ?? "Unknown";
                var orders = Model?.OrderDetail?.Where(o => o.SupervisedBy == supervisorPhone).ToList();
                int pendingOrders = orders?.Count ?? 0;
                var supervisorName = sup.FirstOrDefault()?.SupervisorName ?? "Unknown";
                var completedOrders = sup.Count(o => o.Status?.ToLower() == "completed");
                // Count orders supervised THIS MONTH
                var supervisedThisMonth = Model?.CompletedOrders?
                .Where(o => o.SupervisorPhoneNumber == supervisorPhone
                && o.RequestCreatedAt.Year == currentYear
                && o.RequestCreatedAt.Month == currentMonth).Count() ?? 0;
                // Count orders supervised Today
                var supervisedToday= Model?.CompletedOrders?
                .Where(o => o.SupervisorPhoneNumber == supervisorPhone
                && o.RequestCreatedAt.Year == currentYear
                && o.RequestCreatedAt.DayOfYear == currentDay)
                .Count() ?? 0;
                <div class="col-lg-3 col-md-6 col-12">
                    <div class="card shadow-sm border-0 rounded-3 h-100">
                        <div class="card-body text-center">
                            <h6 style="font-size: 20px;" class="card-title fw-bold">@supervisorName (@supervisorPhone)</h6>
                            <hr style="  margin-top: 0.25rem;
                                 margin-bottom: 0.25rem;" />
                            <div style="font-size: 14px;">
                                <p class="my-1">
                                    <i class="fas fa-hourglass-half text-warning "></i>
                                    <span class="fw-semibold">Orders Pending:</span>
                                    <span id="pendingOrders_@sup.Key">@pendingOrders</span>
                                </p>
                                <p class="my-1">
                                    <i class="fas fa-calendar-day text-danger "></i>
                                    <span class="fw-semibold">Orders Supervised Today:</span> @supervisedToday
                                </p> 
                                <p class="my-1">
                                    <i class="fas fa-calendar-alt text-dark "></i>
                                    <span class="fw-semibold">Orders Supervised in @(now.ToString("MMM, yyyy")):</span> @supervisedThisMonth
                                </p>

                                <p class="mt-1 mb-0">
                                    <i class="fas fa-check-circle text-success "></i>
                                    <span class="fw-semibold">Total Orders Supervised:</span> @completedOrders
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }

        }
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function (){
            fetchLoop();
        });
        async function fetchLoop() {
            await fetchSupervisors();         // wait until done
            setTimeout(fetchLoop, 30000);     // run again in 1 min
        }
        var js = jQuery.noConflict(true);
        var tablelist;
        js(document).ready(function () {
            tablelist = js('#tablelist').DataTable({
                responsive: true,
                "order": [[0, "asc"]],
                columnDefs: [
                    { orderable: false, targets: [1, 2, 3, 5] },
                    { width: "35%", targets: 5 },
                    { width: "15%", targets: 0 }
                ],
                language: {
                    "emptyTable": "No information to display at the moment!"
                }
            });
        });
        async function fetchSupervisors(){
            try {
                const response = await fetch('order/getAvailableSupervisors');
                let supervisors = await response.json();
                if(!Array.isArray(supervisors), !Array.isArray(data)) return;
                updateSupervisorsTable(supervisors, data);
            }
            catch (error){
                console.error("Error fetching alerts:", error);
            }
        }
        function updateSupervisorsTable(supervisors, orderDetails) {
            let tbody = js('#tablelist tbody');
            tbody.empty(); // Clear old rows

            supervisors.forEach(sup => {
                let orders = orderDetails.filter(o => o.supervisedBy === sup.userName);
                let ordersCount = orders.length;
                $(`#pendingOrders_${sup.userName}`).text(ordersCount);
                let ordersAssigned = ordersCount
                    ? orders.map(o => `<a href="/order/${o.voucherCode}">${o.voucherCode}</a>`).join(", ")
                    : `<span class="text-danger">-</span>`;

                let newRowHtml = `
                    <tr style="font-size:13px;">
                        <td>${sup.firstName ?? ''} ${sup.secondName ?? ''}</td>
                        <td class="text-center"><a href="tel:${sup.userName ?? ''}">${sup.userName ?? ''}</a></td>
                        <td class="text-center">${sup.loggedInStatus ? "Yes" : "No"}</td>
                        <td class="text-center">${sup.totalSupervisedOrders ?? 0}</td>
                        <td class="text-center">${ordersCount}</td>
                        <td class="text-center">${ordersAssigned}</td>
                    </tr>
                `;

                tbody.append(newRowHtml);
            });

            // Preserve current page before redraw
            let currentPage = tablelist.page();

            // Clear DataTable data and re-add rows from updated tbody
            tablelist.clear();
            tablelist.rows.add(tbody.find('tr')).draw(false);

            // Restore the current page and redraw without resetting paging
            tablelist.page(currentPage).draw(false);
        }
    </script>
}
