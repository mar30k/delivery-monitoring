@model List<CompletedOrders>

@functions {
    string GetActivityColor(string name)
    {
        if (string.IsNullOrEmpty(name)) return "#94a3b8";
        var hash = name.GetHashCode();
        var h = Math.Abs(hash % 360);
        return $"hsl({h}, 45%, 35%)";
    }

    string FormatDuration(double totalSeconds)
    {
        if (totalSeconds <= 0) return "0s";
        if (totalSeconds < 60) return $"{(int)totalSeconds}s";
        TimeSpan t = TimeSpan.FromSeconds(totalSeconds);
        return t.TotalHours >= 1
            ? $"{(int)t.TotalHours}h {t.Minutes}m {t.Seconds}s"
            : $"{t.Minutes}m {t.Seconds}s";
    }
}

<div class="precision-monitor">
    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
            <p class="text-muted mt-2">No orders found for the selected range.</p>
        </div>
    }
    else
    {
        @foreach (var order in Model ?? new List<CompletedOrders>())
        {
            var acts = order.Activities?.Activity?.OrderBy(a => a.Time).ToList() ?? new List<ActivityResponse>();

            <div class="order-strip">
                <div class="strip-header">
                    <div class="header-data-scroll">
                        <a class="voucher-anchor text-decoration-none" href="/orderDetail?voucher=@order.VoucherCode" target="_blank">#@order.VoucherCode</a>
                        <div class="meta-item">@order.CustomerName</div>
                        <div class="meta-item">@order.BranchName</div>
                        <div class="meta-item">@order.CompanyName</div>
                        <div class="meta-item">@order.CustomerPhoneNumber</div>
                        <div class="meta-item">@order.OrderDate.ToString("MMM dd hh:mm:ss tt")</div>
                    </div>
                </div>

                <div class="strip-timeline">
                    <div class="timeline-track">
                        @for (int i = 0; i < acts.Count; i++)
                        {
                            var a = acts[i];
                            var color = GetActivityColor(a.Name ?? string.Empty);

                            double durationSec = 0;
                            if (i > 0 && a.Time.HasValue && acts[i - 1].Time.HasValue)
                            {
                                durationSec = (a.Time!.Value - acts[i - 1].Time!.Value).TotalSeconds;
                            }

                            // Natural Log provides the best balance for a 5s to 40m range
                            double widthPx = 70 + (Math.Log(durationSec + 1) * 40);
                            widthPx = Math.Clamp(widthPx, 90, 420);

                            <div class="activity-block" style="flex: 0 0 @(widthPx)px; width: @(widthPx)px; --accent: @color">
                                <div class="block-top">
                                    <span class="block-name" title="@a.Name">@a.Name</span>
                                    <div class="block-meta">
                                        <span class="block-clock">@a.Time?.ToString("HH:mm:ss")</span>
                                        <span class="block-duration">@(i == 0 ? "(0s)" : FormatDuration(durationSec))</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>