@model List<CompletedOrders>
@{
    Layout = null;
    var palette = new[] { "#4e73df", "#1cc88a", "#36b9cc", "#f6c23e", "#e74a3b", "#5a5c69", "#6610f2", "#fd7e14" };
    string GetDynamicColor(string name)
    {
        if (string.IsNullOrEmpty(name)) return "#6e707e";
        int hash = 0;
        foreach (char c in name)
        {
            hash = c + ((hash << 5) - hash);
        }
        int index = Math.Abs(hash) % palette.Length;
        return palette[index];
    }
}

<div class="comparison-wrapper" id="order-list">
    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
            <p class="text-muted mt-2">No orders found for the selected range.</p>
        </div>
    }
    else
    {
        @for (int index = 0; index < Model.Count; index++)
        {
            var order = Model[index];
            var activities = order.Activities?.Activity?.OrderBy(a => a.Time).ToList() ?? new List<ActivityResponse>();

            @* Hide rows beyond the first 10 initially *@
            var hiddenClass = index >= 10 ? "d-none paged-out" : "";

            <div class="order-row timeline-row @hiddenClass">
                <div class="order-sidebar">
                    <span class="voucher-badge">
                        <i class="bi bi-hash"></i> <a href="/orderdetail?voucher=@order.VoucherCode">@order.VoucherCode</a>
                    </span>

                    <div class="data-grid">
                        <div class="data-item">
                            <span class="data-label">Customer</span>
                            <span class="data-value">@order.CustomerName</span>
                        </div>
                        <div class="data-item">
                            <span class="data-label">Branch</span>
                            <span class="data-value">@order.BranchName</span>
                        </div>
                        <div class="data-item">
                            <span class="data-label">Phone</span>
                            <span class="data-value">@order.CustomerPhoneNumber</span>
                        </div>
                        <div class="data-item">
                            <span class="data-label">Company</span>
                            <span class="data-value">@order.CompanyName</span>
                        </div>
                        <div class="data-item">
                            <span class="data-label">Date</span>
                            <span class="data-value text-primary">@order.OrderDate.ToString("MMM dd hh:mm tt")</span>
                        </div>
                    </div>
                </div>

                <div class="timeline-scroll-container">
                    <div class="timeline-flow">
                        @for (int i = 0; i < activities.Count; i++)
                        {
                            var act = activities[i];
                            var bgColor = GetDynamicColor(act.Name ?? string.Empty);

                            <div class="node-item">
                                @if (i > 0)
                                {
                                    var diff = (act.Time ?? DateTime.Now) - (activities[i - 1].Time ?? DateTime.Now);
                                    <div class="time-gap">
                                        @if (diff.TotalSeconds < 60)
                                        {
                                            <span>@((int)diff.TotalSeconds)s</span>
                                        }
                                        else if (diff.TotalHours < 1)
                                        {

                                            <span>@((int)diff.TotalMinutes)m</span>
                                        }
                                        else
                                        {

                                            <span>@((int)diff.TotalHours)h @(diff.Minutes)m</span>
                                        }
                                    </div>
                                }

                                <div class="node-icon" style="background-color: @bgColor">
                                    @(i + 1)
                                </div>
                                <div class="node-text" title="@act.Name">@act.Name</div>
                                <div class="node-subtext">@act.Time?.ToString("hh:mm tt")</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.Count > 10)
        {
            <div class="text-center py-4" id="pagination-trigger">
                <button id="btnShowMore" class="btn btn-outline-primary rounded-pill px-5 shadow-sm">
                    Show More Orders (<span id="remaining-count">@(Model.Count - 10)</span> remaining)
                </button>
            </div>
        }
    }
</div>
<script>
    $(document).ready(function() {
        // We use $(document).on because the button is replaced during AJAX updates
        $(document).on('click', '#btnShowMore', function() {
            // 1. Reveal next 10 hidden rows
            var nextBatch = $('.timeline-row.paged-out').slice(0, 10);
            nextBatch.removeClass('d-none paged-out').hide().fadeIn(400);

            // 2. Update the remaining count on the button
            var remaining = $('.timeline-row.paged-out').length;
            if (remaining > 0) {
                $('#remaining-count').text(remaining);
            } else {
                // 3. If everything is shown, hide the button
                $('#pagination-trigger').fadeOut();
            }
        });
    });
</script>
                        