@model List<CompletedOrders>

@{
    ViewData["Title"] = "Timeline";
}
<link rel="stylesheet" href="~/css/timeline.css" asp-append-version="true" />

<div class="container-fluid p-lg-4 p-2">
    <div class="d-flex align-items-center justify-content-between pb-3 border-bottom">
        <div>
            <h5 class="fw-bold mb-0 text-dark">Order Timeline</h5>
        </div>

        <div class="d-flex align-items-center gap-3">
            <div id="loader" class="spinner-border spinner-border-sm text-primary d-none" role="status"></div>
            <div class="position-relative">
                <i class="bi bi-calendar3 position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                <input type="text" id="dateRange" class="form-control elegant-filter"
                       readonly style="width: 260px; padding-left: 2.5rem;" />
            </div>
        </div>
    </div>

    <div id="timeline-container">
        @await Html.PartialAsync("_OrderTimelinePartial", Model)
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script>
        var js = jQuery.noConflict(true);
    </script>
    <script src="~/js/date-range.js" asp-append-version="true"></script>
    <script src="~/js/timeline.js" asp-append-version="true"></script>
}