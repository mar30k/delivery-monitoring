<!-- Assign Supervisor Modal -->
<div class="modal fade"
     id="assignSupervisor"
     tabindex="-1"
     data-bs-backdrop="static"
     data-bs-keyboard="false"
     aria-labelledby="assignSupervisorModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content shadow">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title text-white" id="assignSupervisorModalLabel">Assign Supervisor Order <span id="assignVoucherCodeLabel" class="text-warning fw-normal"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                @* <p class="mb-3 text-muted">Choose how you want to assign supervisor to the order:</p>

                        <button class="btn btn-outline-primary w-100 mb-3" id="confirmAssignToAll" onclick="SupervisorAssignment.assign(true)">
                            🔄 Assign to Available Supervisors Randomly
                        </button>

                        <hr class="my-3">
 *@
                <label for="modalSupervisorSelect" class="form-label fw-bold"> Select supervisor to be assigned:</label>
                <select id="modalSupervisorSelect" class="form-select mb-3">
                    <option value="" selected disabled>Loading supervisors...</option>
                </select>

                <button id="btnAssignSupervisor" class="btn btn-outline-success w-100 mt-2" onclick="SupervisorAssignment.assign()" disabled>
                    ✅ Assign to Selected Supervisor
                </button>
                <div id="assignLoading" class="text-center mt-4 d-none">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Assigning...</span>
                    </div>
                    <p class="text-muted mt-2">Processing supervisor assignment...</p>
                </div>
            </div>
        </div>
    </div>
</div>