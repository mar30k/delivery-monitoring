@using DeliveryMonitoring.Constants
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject DeliveryMonitoring.Controllers.AuthenticationManager AuthManager
@{
    var adminCompanyTin = AppConstants.Company.AdminTin;
    var companyTin = AuthManager.GetSecureCookie(CNET_WebConstantes.IdentificationCookie);
}
<!DOCTYPE html>
<html lang="en">
    <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DeliveryMonitoring</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/uikit.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/hulubeje.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="https://code.jquery.com/jquery-3.3.1.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js"></script>
</head>

    <body>
        @await Html.PartialAsync("_CopyToClipBoardAlert")


        <!-- Floating Alert Box -->
        <div id="floating-alert" class="floating-alert">
            <div class="alert-content">
                <button type="button" class="close-btn" onclick="closeAlert()">×</button>
                <p><i class="bi bi-exclamation-triangle-fill"></i> New Alerts</p>
                <ul id="alert-list"></ul>
            </div>
        </div>

        <!--sidebar starts here-->
        <div class="sidebar" id="mySidebar">
            <ul>
                <li><a href="/"><!--<img src="/images/cnetlogo.png" alt="CNET logo" width="40" height="40">--><span>&nbsp;Delivery Monitoring</span></a></li>
                <li><a href="/"><i class="bi bi-house"></i><span>Home</span></a></li>
                <li><a href="/drivers"><i class="fa-sharp-duotone fa-solid fa-motorcycle"></i><span>Drivers</span></a></li>
                <li><a href="/orders"><i class="bi bi-cart2"></i><span>Delivery Orders</span></a></li>
                <li><a href="/completedorders"><i class="bi bi-clock-history"></i><span>History</span></a></li>
                @if (companyTin == adminCompanyTin)
                {
                    <li><a href="/companies"><i class="bi bi-building"></i><span>Companies</span></a></li>
                }
                else
                {
                    <li><a href="/companies"><i class="bi bi-building"></i><span>Company</span></a></li>
                }
                <li id="reportMenu">
                    <a class="d-flex justify-content-between align-items-center collapsed"
                       data-bs-toggle="collapse"
                       href="#reportSubmenu"
                       role="button"
                       aria-expanded="false"
                       aria-controls="reportSubmenu">
                        <span><i class="bi bi-file-earmark-text"></i> Reports</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                <ul class="collapse list-unstyled ps-3" id="reportSubmenu">
                        <li><a href="/report"><i class="bi bi-grid"></i> All</a></li>
                        <li><a href="/report/delivery"><i class="bi bi-cart2"></i> Delivery</a></li>
                        <li><a href="/report/dinein"  ><i class="bi bi-shop"></i> Dine-in</a></li>
                        <li><a href="/report/takeaway"  ><i class="bi bi-person-walking"></i> Takeaway</a></li>
                    </ul>
                </li>
                <li id="summaryMenu">
                    <a class="d-flex justify-content-between align-items-center collapsed"
                       data-bs-toggle="collapse"
                       href="#summarySubmenu"
                       role="button"
                       aria-expanded="false"
                       aria-controls="summarySubmenu">
                        <span><i class="bi bi-file-earmark-text"></i> Summaries</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <ul class="collapse list-unstyled ps-3" id="summarySubmenu">
                        <li>
                            <a href="/summary/consignee" >
                                <i class="bi bi-person-badge"></i> Consignee
                            </a>
                        </li>
                        <li>
                            <a href="/summary/driver" >
                            <i class="fa-sharp-duotone fa-solid fa-motorcycle"></i> Driver
                            </a>
                        </li>
                        @if (companyTin == adminCompanyTin)
                        {
                            <li>
                                <a href="/summary/supervisor">
                                    <i class="bi bi-person-badge"></i> Supervisor
                                </a>
                            </li>
                        }
                        <li>
                        <a href="/summary/merchant">
                                <i class="bi bi-shop"></i> Merchant
                            </a>
                        </li>

                    </ul>
                </li>
            </ul>
        </div>
        <div id="main">
            <header>
                <nav class="navbar navbar-expand navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
                    <div class="container-fluid">
                    
                        <a class="w3-bar-item w3-button w3-large m-3" onclick="toggleSidebar()">
                            <i class="bi bi-list"></i>
                        </a>
                                       
                        <div class="navbar-collapse collapse d-flex justify-content-between">
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Home" asp-action="Index" style="margin-top: 8px;"><h5>Dashboard</h5></a>
                                </li>
                            </ul>
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="#" data-toggle="modal" data-target="#logoutModal" style="margin-top: 8px;">
                                        <h5><i class="bi bi-box-arrow-left"></i>&nbsp;Logout</h5>
                                    </a>
                                </li>
                            </ul>
                        </div>                                        
                    </div>
                </nav>
            </header>
            <!--navbar ends here-->
            <!-- Logout Confirmation Modal -->
            <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="logoutModalLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header bg-light">
                            <h5 class="modal-title" id="logoutModalLabel"><i class="bi bi-box-arrow-left"></i>&nbsp;Logout</h5>                       
                        </div>
                        <div class="modal-body">
                            Are you sure you want to Logout?
                        </div>
                        <div class="modal-footer">
                            <a class="btn btn-danger" id="logoutButton">Logout</a>
                            <button type="button" class="btn btn-primary" data-dismiss="modal">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container-fluid g-0">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
            <!--main body ends here-->
        </div> 
        <!--Main container ends here all components without the sidebar-->
    
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/uikit.min.js"></script>
        <script src="~/js/uikit-icons.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.dataTables.min.css" />
        <script src="https://cdn.datatables.net/2.3.2/js/dataTables.min.js"></script>
        <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
        <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
        @await RenderSectionAsync("Scripts", required: false)
    
        <script>
            const screenSize = screen.width;
            const main = document.getElementById("main");
            const sidebar = document.getElementById("mySidebar");

            if (screenSize > 767) {
                sidebar.classList.remove("closed");
                main.classList.remove("full");
            } else {
                sidebar.classList.add("closed");
                main.classList.add("full");
            }

            function toggleSidebar() {
                sidebar.classList.toggle("closed");
                main.classList.toggle("full");
            }
        </script>    
    

    </body>
</html>
