<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DeliveryMonitoring</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DeliveryMonitoring.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>

    <!--sidebar starts here-->
    <div class="sidebar" style="display:none" id="mySidebar">
        <!--sidebar close button starts here-->
        <button class="w3-bar-item w3-button w3-large"
                onclick="w3_close()">
            
            <i class="bi bi-x-circle"></i>
        </button>
        <!--side bar close button ends here-->

        <ul>
            <li><a href="/Home/Index"><i class="bi bi-house"></i><span>Home</span></a></li>
            <li><a href="/Driver/Index"><i class="bi bi-truck"></i><span>Drivers</span></a></li>
            <li><a href="/Order/Index"><i class="bi bi-box"></i><span>Orders</span></a></li>
            <li><a href="/Company/Index"><i class="bi bi-building"></i><span>Companies</span></a></li>
            <li><a href="/Home/Privacy"><i class="bi bi-shield-check"></i><span>Privacy</span></a></li>
        </ul>
    </div>
    <!--sidebar ends here-->

    <!--Main container starts here all components without the sidebar-->
    <div id="main">
        <!--Navbar starts here-->
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
                <div class="container-fluid">
                    <a class="m-3" onclick="w3_open()"><i class="bi bi-list"></i></a>
                
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DeliveryMonitoring</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1" style="text-align: right">

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Driver" asp-action="Index">Drivers</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Order" asp-action="Index">Orders</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Company" asp-action="Index">Companies</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                        </ul>
                    </div>
                    
                    
                </div>
            </nav>
        </header>
        <!--navbar ends here-->

        <!--mainbody starts here-->
        <div class="row">
            <div class="container-fluid">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
        <!--main body ends here-->
    </div> 
    <!--Main container ends here all components without the sidebar-->
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <!--this makes the sidebar responsive-->
    <script>
        function w3_open() {
            document.getElementById("main").style.marginLeft = "15%";
            document.getElementById("mySidebar").style.width = "15%";
            document.getElementById("mySidebar").style.display = "block";
            document.getElementById("openNav").style.display = 'none';
        }
        function w3_close() {
            document.getElementById("main").style.marginLeft = "0%";
            document.getElementById("mySidebar").style.display = "none";
            document.getElementById("openNav").style.display = "inline-block";
        }
    </script>
    <!--sidebar responsiveness ends here-->
</body>
</html>
