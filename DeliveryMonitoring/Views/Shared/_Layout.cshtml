@using CNET_ERP_V7.WebConstants
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var companyTin = HttpContextAccessor.HttpContext?.Request.Cookies["cnet.erp.v6.myId"];
}
<!DOCTYPE html>
<html lang="en">
    <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DeliveryMonitoring</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/uikit.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/hulubeje.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js"></script>
    <style>
        #mySidebar {
            width: 15%;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            overflow-x: hidden;
            transition: transform 0.3s ease;
            transform: translateX(0); /* visible */
            z-index: 1000;
        }

            #mySidebar.closed {
                transform: translateX(-100%); /* hidden */
            }

        #main {
            margin-left: 15%;
            transition: margin-left 0.3s ease;
        }

            #main.full {
                margin-left: 0%;
            }
        .floating-alert {
            position: fixed;
            top: 10%;
            left: 50%;
            transform: translate(-50%, -50%);
            max-width: 700px;
            background: rgba(255, 0, 0, 0.9); /* Semi-transparent red */
            color: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
            text-align: center;
            display: none; /* Hidden by default */
            z-index: 1000; /* Ensures it stays on top */
        }

            .floating-alert .alert-content {
                position: relative;
            }

            .floating-alert ul {
                list-style: none;
                padding: 0;
                margin: 10px 0 0 0;
                text-align: left;
            }

                .floating-alert ul li {
                    margin: 5px 0;
                    font-size: 14px;
                }

            .floating-alert a {
                color: white;
                font-weight: bold;
                text-decoration: underline;
            }

            .floating-alert .close-btn {
                position: absolute;
                top: 5px;
                right: 10px;
                border: none;
                background: transparent;
                color: white;
                font-size: 20px;
                cursor: pointer;
            }

        .alerts {
            text-decoration: none !important; /* No underline */
            color: inherit !important; /* No color change */
            font-weight: inherit !important; /* No font weight change */
            background: transparent !important; /* No background change */
            border: none !important; /* No border */
            outline: none !important; /* No outline */
            box-shadow: none !important; /* No shadow */
            padding: inherit !important; /* No padding change */
            margin: inherit !important; /* No margin change */
        }

            .alerts:hover,
            .alerts:focus,
            .alerts:active {
                text-decoration: none !important;
                color: inherit !important;
                font-weight: inherit !important;
                background: transparent !important;
                border: none !important;
                outline: none !important;
                box-shadow: none !important;
                padding: inherit !important;
                margin: inherit !important;
            }

        .btn:focus {
            outline: none !important;
            box-shadow: none !important;
        }
        @@media (max-width: 767px) {
            .sidebar ul {
                padding-left: 0px !important; /* Reduced padding */
            }
        }
    </style>
</head>

    <body>
        @await Html.PartialAsync("_CopyToClipBoardAlert")
        <script>
            $(document).ready(function () {
                $('#logoutButton').click(function () {
                    // Handle logout logic here, e.g., redirect to the logout action
                    window.location.href = '/Login/Logout';
                });
                closeAlert();
                fetchAlerts();
            });
                    // Mock sessionStorage for testing purposes
            // sessionStorage.setItem("displayedAlerts", JSON.stringify({
            //     "0912492953-15478-219": "Alert 1",
            //     "0912492953-84835-4": "Alert 2"
            // }));

            // // Simulate the fetch function to mock the API response
            // window.fetch = function() {
            //     return Promise.resolve({
            //         json: function() {
            //             return Promise.resolve([
            //                 { voucherCode: "0912492953-15478-219", alert: "New Alert 1" },
            //                 { voucherCode: "0912492953-84835-4", alert: "New Alert 3" },
            //                 { voucherCode: "JKL012", alert: "" }
            //             ]);
            //         }
            //     });
            // };

            var data = {};
            async function fetchAlerts() {
                try {
                    const response = await fetch('/getorders');
                    if (!response.ok) {
                        return;
                    }
                    const newData = await response.json();
                    data = newData;

                    const orderCount =  document.getElementById("orderCount");
                    if(orderCount){
                        orderCount.textContent = data.length;
                    }
                    const alertBox = document.getElementById("floating-alert");
                    const alertList = document.getElementById("alert-list");

                    // Retrieve previously displayed alerts from sessionStorage
                    let storedAlerts = JSON.parse(sessionStorage.getItem("displayedAlerts")) || {};

                    // Filter orders that have non-empty alerts
                    const filteredOrders = data.filter(order => order.alert && order.alert.trim() !== "");

                    // Track alerts that need to be displayed in this refresh
                    let newAlerts = {};
                    let hasNewAlerts = false;
                    filteredOrders.forEach(order => {
                        const { voucherCode, alert } = order;
                        // Only add if it's a completely new alert or the alert message has changed
                        if (!storedAlerts[voucherCode] || storedAlerts[voucherCode] !== alert) {
                            hasNewAlerts = true;
                            newAlerts[voucherCode] = alert;
                        }
                    });

                    // If there are new alerts, update the UI
                    if (hasNewAlerts) {
                        alertList.innerHTML = ""; // Clear alert container

                        for (const voucherCode in newAlerts) {
                            const listItem = document.createElement("li");
                            listItem.innerHTML = `<a class="alerts" style="text-decoration: none;" target="_blank" href="/order/${voucherCode}">Order ${voucherCode}: ${newAlerts[voucherCode]}</a>`;
                            alertList.appendChild(listItem);
                        }

                        // Show the floating alert box only if there are new alerts
                        alertBox.style.display = "block";
                        // playAlertSound();

                        // Update sessionStorage to track displayed alerts
                        sessionStorage.setItem("displayedAlerts", JSON.stringify({ ...storedAlerts, ...newAlerts }));
                    }

                } catch (error) {
                    console.error("Error fetching alerts:", error);
                }
                setTimeout(fetchAlerts, 10000);
            }

            let alertAudio = null;

            function playAlertSound(times = 4) {
                if (alertAudio) {
                    alertAudio.pause(); // Stop any currently playing audio
                    alertAudio.currentTime = 0;
                }

                alertAudio = new Audio('/images/alarm2.mp3');
                let count = 0;

                alertAudio.addEventListener("ended", function () {
                    count++;
                    if (count < times) {
                        alertAudio.currentTime = 0;
                        alertAudio.play();
                    }
                });

                alertAudio.play().catch(error => console.error("Audio play failed:", error));
            }

            function closeAlert() {
                document.getElementById("floating-alert").style.display = "none";

                // Stop the audio
                if (alertAudio) {
                    alertAudio.pause();
                    alertAudio.currentTime = 0;
                }
            }

        </script>
        <!-- Floating Alert Box -->
        <div id="floating-alert" class="floating-alert">
            <div class="alert-content">
                <button type="button" class="close-btn" onclick="closeAlert()">×</button>
                <p><i class="bi bi-exclamation-triangle-fill"></i> New Alerts</p>
                <ul id="alert-list"></ul>
            </div>
        </div>

        <!--sidebar starts here-->
        <div class="sidebar" id="mySidebar">
            <ul>
                <li id="delivery"><a href="/"><!--<img src="/images/cnetlogo.png" alt="CNET logo" width="40" height="40">--><span>&nbsp;Delivery Monitoring</span></a></li>
                <li><a href="/"><i class="bi bi-house"></i><span>Home</span></a></li>
                <li><a href="/drivers"><i class="fa-sharp-duotone fa-solid fa-motorcycle"></i><span>Drivers</span></a></li>
                <li><a href="/orders"><i class="bi bi-cart2"></i><span>Delivery Orders</span></a></li>
                <li><a href="/completedorders"><i class="bi bi-clock-history"></i><span>History</span></a></li>
                @if (companyTin == "0076217301")
                {
                    <li><a href="/companies"><i class="bi bi-building"></i><span>Companies</span></a></li>
                }
                else
                {
                    <li><a href="/companies"><i class="bi bi-building"></i><span>Company</span></a></li>
                }
                <li id="reportMenu">
                    <a class="d-flex justify-content-between align-items-center collapsed"
                       data-bs-toggle="collapse"
                       href="#reportSubmenu"
                       role="button"
                       aria-expanded="false"
                       aria-controls="reportSubmenu">
                        <span><i class="bi bi-file-earmark-text"></i> Reports</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <ul class="collapse list-unstyled ps-3" id="reportSubmenu">
                        <li><a href="/report" ><i class="fa-sharp-duotone fa-solid fa-motorcycle"></i> Delivery</a></li>
                        <li><a href="/report?t=dinein"  ><i class="bi bi-shop"></i> Dine-in</a></li>
                        <li><a href="/report?t=takeaway"  ><i class="bi bi-bag-check"></i> Takeaway</a></li>
                        <li>
                            <a href="/csummary" >
                                <i class="bi bi-person-badge"></i> Consignee
                            </a>
                        </li>
                        <li>
                            <a href="/msummary" >
                                <i class="bi bi-shop"></i> Merchant
                            </a>
                        </li>

                    </ul>
                </li>
            </ul>
        </div>
        <div id="main">
            <header>
                <nav class="navbar navbar-expand navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
                    <div class="container-fluid">
                    
                        <a class="w3-bar-item w3-button w3-large m-3" onclick="toggleSidebar()">
                            <i class="bi bi-list"></i>
                        </a>
                                       
                        <div class="navbar-collapse collapse d-flex justify-content-between">
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Home" asp-action="Index" style="margin-top: 8px;"><h5>Dashboard</h5></a>
                                </li>
                            </ul>
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="#" data-toggle="modal" data-target="#logoutModal" style="margin-top: 8px;">
                                        <h5><i class="bi bi-box-arrow-left"></i>&nbsp;Logout</h5>
                                    </a>
                                </li>
                            </ul>
                        </div>                                        
                    </div>
                </nav>
            </header>
            <!--navbar ends here-->
            <!-- Logout Confirmation Modal -->
            <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="logoutModalLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header bg-light">
                            <h5 class="modal-title" id="logoutModalLabel"><i class="bi bi-box-arrow-left"></i>&nbsp;Logout</h5>                       
                        </div>
                        <div class="modal-body">
                            Are you sure you want to Logout?
                        </div>
                        <div class="modal-footer">
                            <a class="btn btn-danger" id="logoutButton">Logout</a>
                            <button type="button" class="btn btn-primary" data-dismiss="modal">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container-fluid g-0">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
            <!--main body ends here-->
        </div> 
        <!--Main container ends here all components without the sidebar-->
    
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/uikit.min.js"></script>
        <script src="~/js/uikit-icons.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.dataTables.min.css" />
        <script src="https://cdn.datatables.net/2.3.2/js/dataTables.min.js"></script>
        @await RenderSectionAsync("Scripts", required: false)
    
        <script>
            const screenSize = screen.width;
            const main = document.getElementById("main");
            const sidebar = document.getElementById("mySidebar");

            if (screenSize > 767) {
                sidebar.classList.remove("closed");
                main.classList.remove("full");
            } else {
                sidebar.classList.add("closed");
                main.classList.add("full");
            }

            function toggleSidebar() {
                sidebar.classList.toggle("closed");
                main.classList.toggle("full");
            }
        </script>    
    

    </body>
</html>
