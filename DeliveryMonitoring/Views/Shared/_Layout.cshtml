<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DeliveryMonitoring</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DeliveryMonitoring.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>

    <!--sidebar starts here-->
    <div class="sidebar" id="mySidebar">
        <ul>
            <li id="delivery"><a href="/Home/Index"><!--<img src="/images/cnetlogo.png" alt="CNET logo" width="40" height="40">--><span>&nbsp;Delivery Monitoring</span></a></li>
            <li><a href="/Home/Index"><i class="bi bi-house"></i><span>Home</span></a></li>
            <li><a href="/Driver/Index"><i class="bi bi-truck"></i><span>Drivers</span></a></li>
            <li><a href="/Order/Index"><i class="bi bi-box"></i><span>Orders</span></a></li>
            <li><a href="/Company/Index"><i class="bi bi-building"></i><span>Companies</span></a></li>
            <li><a href=""><i class="bi bi-person-circle"></i><span>Logout</span></a></li>
        </ul>
    </div>
    <!--sidebar ends here-->

    <!--Main container starts here all components without the sidebar-->
    <div id="main">
        <!--Navbar starts here-->
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
                <div class="container-fluid">
                    
                    <a class="w3-bar-item w3-button w3-large m-3" onclick="toggleSidebar()">
                        <i class="bi bi-list"></i>
                    </a>
                
                    <!--<a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DeliveryMonitoring</a>-->

                    <!--collapsible navbar code-->
                    <!--
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    -->
                    
                    
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        
                        <ul class="navbar-nav flex-grow-1" style="text-align: right">

                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Driver" asp-action="Index">Drivers</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Order" asp-action="Index">Orders</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Company" asp-action="Index">Companies</a>
                                </li>
                        </ul>
                        
                        
                        <ul class="navbar-nav justify-content-end">
                            <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="" asp-action=""><i class="bi bi-person-circle"></i>Logout</a>
                            </li>
                        </ul>
                    </div>
                    
                    
                </div>
            </nav>
        </header>
        <!--navbar ends here-->

        <!--mainbody starts here-->
        <div class="row">
            <div class="container-fluid">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
        <!--main body ends here-->
    </div> 
    <!--Main container ends here all components without the sidebar-->
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <!--this makes the sidebar responsive-->
    <script>
        var screenSize = screen.width;
        var main = document.getElementById("main");
        var sidebar = document.getElementById("mySidebar");
        
        if (screenSize > 767) {
            sidebar.style.display = "block";
            sidebar.style.width = "15%";
            main.style.marginLeft = "15%";
        }
        else {
            sidebar.style.display = "none";
            sidebar.style.width = "15%";
            main.style.marginLeft = "0%";
        }

        function toggleSidebar() {
            if (sidebar.style.display === "block") {
                // Sidebar is open, so close it
                main.style.marginLeft = "0%";
                sidebar.style.display = "none";
            } else {
                // Sidebar is closed, so open it
                main.style.marginLeft = "15%";
                sidebar.style.display = "block";
            }
        }
    </script>
    <!--sidebar responsiveness ends here-->
</body>
</html>
