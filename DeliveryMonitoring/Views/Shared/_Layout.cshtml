<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DeliveryMonitoring</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
</head>
<body>

    <!--sidebar starts here-->
    <div class="sidebar" id="mySidebar">
        <ul>
            <li id="delivery"><a href="/Home/Index"><!--<img src="/images/cnetlogo.png" alt="CNET logo" width="40" height="40">--><span>&nbsp;Delivery Monitoring</span></a></li>
            <li><a href="/Home/Index"><i class="bi bi-house"></i><span>Home</span></a></li>
            <li><a href="/Driver/Index"><i class="bi bi-truck"></i><span>Drivers</span></a></li>
            <li><a href="/Order/Index"><i class="bi bi-cart2"></i><span>Orders</span></a></li>
            <li><a href="/Company/Index"><i class="bi bi-building"></i><span>Companies</span></a></li>            
        </ul>
    </div>
    <!--sidebar ends here-->

    <!--Main container starts here all components without the sidebar-->
    <div id="main">
        <!--Navbar starts here-->
        <header>
            <nav class="navbar navbar-expand navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
                <div class="container-fluid">
                    
                    <a class="w3-bar-item w3-button w3-large m-3" onclick="toggleSidebar()">
                        <i class="bi bi-list"></i>
                    </a>
                                       
                    <div class="navbar-collapse collapse d-flex justify-content-between">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="Index" style="margin-top: 8px;"><h5>Dashboard</h5></a>
                            </li>
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#" data-toggle="modal" data-target="#logoutModal" style="margin-top: 8px;">
                                    <h5><i class="bi bi-box-arrow-left"></i>&nbsp;Logout</h5>
                                </a>
                            </li>
                        </ul>
                    </div>                                        
                </div>
            </nav>
        </header>
        <!--navbar ends here-->
        <!-- Logout Confirmation Modal -->
        <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="logoutModalLabel" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header bg-light">
                        <h5 class="modal-title" id="logoutModalLabel"><i class="bi bi-box-arrow-left"></i>&nbsp;Logout</h5>                       
                    </div>
                    <div class="modal-body">
                        Are you sure you want to log out?
                    </div>
                    <div class="modal-footer">
                        <a class="btn btn-danger" href="#" id="logoutButton">Logout</a>
                        <button type="button" class="btn btn-primary" data-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
        <!--mainbody starts here-->
        <div class="">
            <div class="container-fluid g-0">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
        <!--main body ends here-->
    </div> 
    <!--Main container ends here all components without the sidebar-->
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <!--this makes the sidebar responsive-->
    <script>
        var screenSize = screen.width;
        var main = document.getElementById("main");
        var sidebar = document.getElementById("mySidebar");
        
        if (screenSize > 767) {
            sidebar.style.display = "block";
            sidebar.style.width = "15%";
            main.style.marginLeft = "15%";
        }
        else {
            sidebar.style.display = "none";
            sidebar.style.width = "15%";
            main.style.marginLeft = "0%";
        }

        function toggleSidebar() {
            if (sidebar.style.display === "block") {
                // Sidebar is open, so close it
                main.style.marginLeft = "0%";
                sidebar.style.display = "none";
            } else {
                // Sidebar is closed, so open it
                main.style.marginLeft = "15%";
                sidebar.style.display = "block";
            }
        }
    </script>
    <!--sidebar responsiveness ends here-->
    
    <script>
        $(document).ready(function () {
            $('#logoutButton').click(function () {
                // Handle logout logic here, e.g., redirect to the logout action
                window.location.href = '/Login/Logout';
            });
        });
    </script>
</body>
</html>
