@model LineItemsDetail

@{
    var lineItems = Model?.LineItems ?? Enumerable.Empty<LineItem>();
    var extraCharges = Model?.ExtraCharge ?? new Dictionary<string, decimal>();
}

<h4 class="ms-4 mb-2">Products</h4>

<div class="px-4 table-responsive table-bordered">
    <table class="table text-center" id="orderTable" style="width:100%; white-space:nowrap;">
        <thead class="table-secondary">
            <tr>
                <th class="text-start">Item Name</th>
                <th>Special Request</th>
                <th>Quantity</th>
                <th>Unit Amount</th>
                <th>Taxable Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in lineItems)
            {
                <tr>
                    <td class="text-start">@item.Name</td>

                    <td>@(string.IsNullOrWhiteSpace(item.Note) ? "N/A" : item.Note)</td>

                    <td>@($"{item.Quantity:F2}")</td>
                    <td>@($"{item.UnitAmount:F2} ETB")</td>
                    <td>@($"{item.TaxableAmount:F2} ETB")</td>
                </tr>
            }

            @foreach (var charge in extraCharges)
            {
                <tr>
                    <td class="text-start">@charge.Key</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td>@($"{charge.Value:F2} ETB")</td>
                </tr>
            }

            <tr class="table-secondary fw-bold">
                <td class="text-start">TOTAL</td>
                <td></td>
                <td></td>
                <td></td>
                <td>@($"{Model?.GrandTotal ?? 0:F2} ETB")</td>
            </tr>
        </tbody>
    </table>
</div>