<link rel="stylesheet" href="~/css/anayltics-dashboard.css" />
<div id="dashboardLoader" class="dashboard-overlay">
    <div class="loader-content">
        <div class="spinner-growth text-primary" role="status"></div>
        <h5 class="mt-3 fw-bold text-dark">Syncing Analytics...</h5>
        <p class="text-muted small">Fetching latest order data from server</p>
    </div>
</div>
<div class="dashboard-bg container-fluid p-3 p-lg-4">

    <div class="row g-3 mb-4">
        <div class="col-xl-2 col-lg-6 col-12">
            <div class="card p-3 border-left-primary h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="stat-label text-primary">Revenue</p>
                        <div id="stat-revenue" class="stat-value">ETB 0</div>
                    </div>
                    <i class="fa-solid fa-wallet kpi-icon"></i>
                </div>
                <div class="mt-2">
                    <span class="badge-today bg-soft-primary">Today: <span id="stat-revenue-today">0</span></span>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-lg-6 col-12">
            <div class="card p-3 border-left-info h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="stat-label text-info">Orders</p>
                        <div id="stat-count" class="stat-value">0</div>
                    </div>
                    <i class="fa-solid fa-box kpi-icon"></i>
                </div>
                <div class="mt-2">
                    <span class="badge-today bg-soft-info">Today: <span id="stat-count-today">0</span></span>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-8 col-12">
            <div class="card p-3 border-left-success h-100">
                <p class="stat-label text-success">Delivery Performance</p>
                <div class="row g-0 h-100">
                    <div class="col-6 perf-divider">
                        <small class="text-uppercase fw-bold text-muted" style="font-size:0.6rem">On-Time</small>
                        <div id="stat-ontime" class="stat-value-sm">0</div>
                        <span class="badge-today bg-soft-success mt-1">Today: <span id="stat-ontime-today">0</span></span>
                    </div>
                    <div class="col-6 ps-3">
                        <small class="text-uppercase fw-bold text-muted" style="font-size:0.6rem">Delayed</small>
                        <div id="stat-delayed" class="stat-value-sm text-danger">0</div>
                        <span class="badge-today bg-soft-danger mt-1">Today: <span id="stat-delayed-today">0</span></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-lg-4 col-12">
            <div class="card p-3 border-left-warning h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="stat-label text-warning">Avg Time</p>
                        <div id="stat-duration" class="stat-value">0m</div>
                    </div>
                    <i class="fa-solid fa-clock kpi-icon"></i>
                </div>
                <div class="mt-2">
                    <span class="badge-today bg-soft-warning">Today: <span id="stat-duration-today">0m</span></span>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-lg-6  col-12">
            <div class="card p-3 border-left-purple h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="stat-label" style="color:var(--purple-soft)">Distance</p>
                        <div id="stat-distance" class="stat-value">0km</div>
                    </div>
                    <i class="fa-solid fa-route kpi-icon"></i>
                </div>
                <div class="mt-2">
                    <span class="badge-today bg-soft-purple">Today: <span id="stat-distance-today">0km</span></span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold m-0 text-primary text-uppercase small">1. Last 7 Days Performance</h6>
                        <span class="badge bg-soft-primary text-primary">Weekly View</span>
                    </div>
                    <div class="chart-container"><canvas id="weeklyPerformanceChart"></canvas></div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-4 text-primary text-uppercase small">2. Payment Methods</h6>
                    <div class="chart-container"><canvas id="paymentMethodChart"></canvas></div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold m-0 text-primary text-uppercase small">3. Traffic Pattern</h6>
                        <input type="date" id="trafficDateSelector"
                               class="form-control form-control-sm w-auto"
                               style="font-size: 0.75rem; border-radius: 8px;"
                               onchange="updateTrafficChart()">
                    </div>
                    <div class="chart-container"><canvas id="hourlyTraficPtterToday"></canvas></div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3 text-primary text-uppercase small">4. Monthly Historical Growth</h6>
                    <div class="chart-container"><canvas id="monthlyTrendChart"></canvas></div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3 text-primary text-uppercase small">5. Daily Volume (30 Days)</h6>
                    <div class="chart-container"><canvas id="dailyOrdersChart"></canvas></div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3 text-primary text-uppercase small">6. Company Revenue</h6>
                    <div class="chart-container"><canvas id="companyRevenueChart"></canvas></div>
                </div>
            </div>
        </div>

        
        
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3 text-primary text-uppercase small">8. Delivery Trend</h6>
                    <div class="chart-container">
                        <canvas id="deliveryTrendChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3 text-primary text-uppercase small">8. Delivery Variance</h6>
                    <div class="chart-container">
                        <canvas id="varianceTrendChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3 text-primary text-uppercase small">7. System Peak Hours</h6>
                    <div class="chart-container" style="height: 350px;">
                        <canvas id="peakHourChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script type="module" src="~/js/dashboard/dashboard-reports.js" asp-append-version="true"></script>