@model IEnumerable<DeliveryMonitoring.Models.Driver>

@{
    ViewData["Title"] = "Index";
}

<div class="container-fluid g-0">
    
    <!--Find the map here-->
    <div class="col-12 col-xl-12 pb-3" id="map">
    </div>
    <!--Map ends here-->
    
    <div class="container-fluid col-10 pt-3 pb-3">
        <a class="btn btn-dark" data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
            <i class="bi bi-filter"></i>Filter
        </a>
    </div>
    
    <div class="container-fluid col-10">
        <div class="collapse" id="collapseExample">
            <form method="get" action="@Url.Action("Filter", "Driver")">

                <div class="row mb-3">
                    <div class="col-12 col-lg-2">
                        <label for="status">Status:</label>
                        <select class="form-control" name="status">
                            <option value="">All</option>
                            <option value="offline">Offline</option>
                            <option value="ready">Ready</option>
                            <option value="accepted">Accepted</option>
                            <option value="delivering">Delivering</option>
                            <option value="completed">Completed</option>
                            <!-- Add other status options as needed -->
                        </select>
                    </div>

                    <div class="col-12 col-lg-2">
                        <label for="companyTin">Company TIN:</label>
                        <input type="text" class="form-control" id="companyTin" name="companyTin" placeholder="Enter Company TIN">
                    </div>

                    <div class="col-2">
                        <br />
                        <button type="submit" class="btn btn-primary">Filter</button>
                    </div>

                </div>
            </form>
        </div>


        <div class="row card">
            <!--The table is Written Here-->
            <div class="pt-3 pb-3 col-12 col-xl-12 table-responsive">
                
                <table class="table compact stripe hover pt-3" id="tablelist">
                    <thead class="">
                        <tr>

                            <th>
                                @Html.DisplayNameFor(model => model.firstName)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.lastUpdatedAt)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.phoneNumber)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.status)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.isDisabled)
                            </th>

                            <th>
                                Driver Details
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {

                            <tr>

                                <td>
                                    @Html.DisplayFor(modelItem => item.firstName)
                                </td>
                                <td>
                                    @DateTimeOffset.FromUnixTimeMilliseconds(item.lastUpdatedAt).DateTime.ToString("HH:mm:ss - ddd, MMMM dd, yyyy")
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.phoneNumber)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.status)
                                </td>
                                <td>
                                    @{
                                        if (item.isDisabled != null)
                                        {
                                            if (item.isDisabled == true)
                                            {
                                                // isDisabled exists and is true
                                                <text>Not Eligible</text>
                                            }
                                            else
                                            {
                                                // isDisabled exists and is false
                                                <text>Eligible</text>
                                            }
                                        }
                                        else
                                        {
                                        // isDisabled does not exist in the API response
                                            <text>Eligible</text>
                                        }
                                    }
                                </td>

                                <td>
                                    <a class="btn btn-outline-dark" asp-controller="Driver" asp-action="Details" asp-route-id="@item.phoneNumber">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <!--this is the table ending-->
        </div>

    </div>
    
    <!--Map JavaScript Implementation Starts Here-->
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDihZpSLFD2uyptHT-UQDSfJm9BKHRK-VU&callback=initMap&libraries=&v=weekly" defer>
    </script>

    <script>
        function initMap() {
            const map = new google.maps.Map(document.getElementById("map"), {
                zoom: 18,
                mapTypeId: google.maps.MapTypeId.ROADMAP
            });
        @{
            if (Model != null && Model.Count() > 0)
            {
                <text>
                        const places = [
                </text>

                foreach (var item in Model)
                {
                    if (item.latLng != null)
                    {
                        <text>
                                { Name: '@item.firstName', LastUpdatedAt: '@DateTimeOffset.FromUnixTimeMilliseconds(item.lastUpdatedAt).DateTime.ToString("yyyy-MM-dd HH:mm:ss")', Phone: '@item.phoneNumber', Status: '@item.status', lat: @item.latLng.lat, lng: @item.latLng.lng},
                        </text>
                    }
                    
                }
                <text>
                                    ];
                </text>
            }
        }

                var marker, i
            for (i = 0; i < places.length; i++) {
                var marker = new google.maps.Marker({
                    position: { lat: places[i].lat, lng: places[i].lng },
                    title: places[i].Name,
                    map: map,
                    icon: {
                        url: '/images/motor.png',
                        scaledSize: new google.maps.Size(31, 61) // Adjust the size as needed
                    }
                });

                map.setCenter(marker.getPosition());

                var content = "<b>Name:</b> " + places[i].Name + "<br/><b>LastUpdatedAt:</b> " + places[i].LastUpdatedAt + "<br/><b>Phone:</b> " + places[i].Phone + "<br/><b>Status:</b> " + places[i].Status

                var infowindow = new google.maps.InfoWindow()

                google.maps.event.addListener(marker, 'mouseover', (function (marker, content, infowindow) {
                    return function () {
                        infowindow.setContent(content);
                        infowindow.open(map, marker);
                    };
                })(marker, content, infowindow));

                google.maps.event.addListener(marker, 'mouseout', (function (infowindow) {
                    return function () {
                        infowindow.close();
                    };
                })(infowindow));
            }
        }
    </script>
    <!--Map JavaScript Implementation Ends Here-->

    <!--Jquery Datatable Starts Here-->
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.js"></script>
    <script>
        var js = jQuery.noConflict(true);
        js(document).ready(function () {
            js('#tablelist').DataTable({
                responsive: true
            });
        });
    </script>
    <!--Jquery Datatable Ends Here-->
</div>
