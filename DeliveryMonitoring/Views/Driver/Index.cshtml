@model IEnumerable<DeliveryMonitoring.Models.Driver>

@{
    ViewData["Title"] = "List of Drivers";
}

<div class="container-fluid g-0">

    <!--Find the map here-->
    <div class="col-12 col-xl-12 pb-3" id="map">
    </div>
    <!--Map ends here-->

    <div class="container-fluid col-10 pt-3 pb-3">
        <a class="btn btn-dark" data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
            <i class="bi bi-filter"></i>Filter
        </a>
    </div>

    <div class="container-fluid col-10">
        <div class="collapse" id="collapseExample">
            <form method="get" action="@Url.Action("Filter", "Driver")">
                <div class="row mb-3">
                    <div class="col-12 col-lg-2">
                        <label for="status">Status:</label>
                        <select class="form-control" name="status">
                            <option value="">All</option>
                            <option value="offline">Offline</option>
                            <option value="ready">Ready</option>
                            <option value="accepted">Accepted</option>
                            <option value="delivering">Delivering</option>
                            <!-- Add other status options as needed -->
                        </select>
                    </div>

                    <div class="col-12 col-lg-2">
                        <label for="companyTin">Company TIN:</label>
                        <input type="text" class="form-control" id="companyTin" name="companyTin" placeholder="Enter Company TIN">
                    </div>

                    <div class="col-2">
                        <br />
                        <button type="submit" class="btn btn-primary">Filter</button>
                    </div>

                </div>
            </form>
        </div>


        <div class="row card">
            <!--The table is Written Here-->
            <div class="pt-3 pb-3 col-12 col-xl-12 table-responsive">

                <table class="table compact stripe hover pt-3" id="tablelist" style="font-size: 13px;">
                    <thead class="">
                        <tr >

                            <th>
                                Name
                            </th>
                            <th class="text-center">
                                Last Updated At
                            </th>
                            <th class="text-center">
                                Phone Number
                            </th>
                            <th class="text-center">
                                Status
                            </th>
                            <th class="text-center">
                                Driver Details
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @functions {
                            public class StatusInfo
                            {
                                public string Color { get; set; }
                                public string Priority { get; set; }
                            }
                        }
                        @{
                            var statusColors = new Dictionary<string, StatusInfo>
                            {
                                { "offline",    new StatusInfo { Color = "#dc3545", Priority = "2" } }, // Bootstrap danger
                                { "ready",      new StatusInfo { Color = "#43A047", Priority = "5" } }, // Bootstrap success
                                { "accepted",   new StatusInfo { Color = "#0d6efd", Priority = "3" } }, // Bootstrap primary
                                { "delivering", new StatusInfo { Color = "#fd7e14", Priority = "2" } }, // Bootstrap orange
                                { "default",    new StatusInfo { Color = "#ffc107", Priority = "1" } }  // Bootstrap warning
                            };

                        }

                        @foreach (var driver in Model)
                        {
                            var statusKey = driver?.status ?? "default";
                            var statusInfo = statusColors.ContainsKey(statusKey) 
                                ? statusColors[statusKey] 
                                : statusColors["default"];

                            var bgColor = statusInfo.Color;
                            var priority = statusInfo.Priority;

                            <tr data-phone="@driver?.phoneNumber">

                                <td>
                                    @driver?.firstName
                                </td>
                                <td data-order="@driver?.lastUpdatedAt" class="text-center">
                                    @DateTimeOffset.FromUnixTimeMilliseconds(driver?.lastUpdatedAt ?? new long()).ToOffset(TimeSpan.FromHours(3)).DateTime.ToString("yyyy-MM-dd hh:mm:ss")
                                </td>
                                <td class="text-center">
                                    <a href="tel:@driver?.phoneNumber">
                                        @driver?.phoneNumber
                                    </a>
                                </td>
                                <td class="text-center" data-status style="background: @bgColor; color: white;" data-order="@priority">
                                    @driver?.status
                                </td>
                                <td class="text-center">
                                    <a class="btn btn-outline-dark btn-sm" href="/driverdetail/@driver?.phoneNumber">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.js"></script>

    <script src="~/js/driver.js"></script>
}