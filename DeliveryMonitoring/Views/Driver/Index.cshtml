@model IEnumerable<DeliveryMonitoring.Models.Driver>
@using DeliveryMonitoring.Models;
@{
    ViewData["Title"] = "List of Drivers";
}

<div class="container-fluid g-0">

    <!--Find the map here-->
    <div class="col-12 col-xl-12 pb-3" id="map">
    </div>
    <!--Map ends here-->

    <div class="container-fluid col-10 pt-3 pb-3">
        <a class="btn btn-dark" data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
            <i class="bi bi-filter"></i>Filter
        </a>
    </div>

    <div class="container-fluid col-10">
        <div class="collapse" id="collapseExample">
            <form id="driverFilterForm">
                <div class="row mb-3">
                    <div class="col-12 col-lg-2">
                        <label for="status">Status:</label>
                        <select class="form-control" name="status">
                            <option value="">All</option>
                            <option value="offline">Offline</option>
                            <option value="ready">Ready</option>
                            <option value="accepted">Accepted</option>
                            <option value="delivering">Delivering</option>
                            <!-- Add other status options as needed -->
                        </select>
                    </div>

                    <div class="col-12 col-lg-2">
                        <label for="companyTin">Company TIN:</label>
                        <input type="text" class="form-control" id="companyTin" name="companyTin" placeholder="Enter Company TIN">
                    </div>

                    <div class="col-2">
                        <br />
                        <button type="submit" class="btn btn-primary">Filter</button>
                        <button type="button" class="btn btn-secondary" onclick="resetFilters()">Reset</button>
                    </div>

                </div>
            </form>
        </div>


        <div class="row card">
            <!--The table is Written Here-->
            <div class="pt-3 pb-3 col-12 col-xl-12 table-responsive">

                <table class="table compact stripe hover pt-3" id="tablelist" style="font-size: 13px;">
                    <thead class="">
                        <tr >

                            <th>
                                Name
                            </th>
                            <th class="text-center">
                                Company
                            </th>
                            <th class="text-center">
                                Last Updated At
                            </th>
                            <th class="text-center">
                                Phone Number
                            </th>
                            <th class="text-center">
                                Status
                            </th>
                            <th class="text-center">
                                Is Active
                            </th>
                            <th class="text-center">
                                Driver Details
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var statusColors = StatusInfo.StatusMap;
                        }
                        @foreach (var driver in Model.OrderByDescending(d => d != null && d.IsDisabled))
                        {
                            var statusKey = driver?.Status?.ToLower() ?? "default";
                            var statusInfo = statusColors.ContainsKey(statusKey) 
                                ? statusColors[statusKey] 
                                : statusColors["default"];

                            var bgColor = statusInfo.Color;
                            var priority = statusInfo.Priority;

                            <tr data-phone="@driver?.PhoneNumber">

                                <td >
                                    @driver?.FirstName
                                </td>
                                <td class="text-center">
                                    @driver?.CompanyTin
                                </td>
                                <td data-order="@driver?.UpdatedAt?.ToString("yyyy-MM-ddTHH:mm:ss")" class="text-center">
                                    @(driver?.UpdatedAt != null
                                        ? new DateTimeOffset(DateTime.SpecifyKind(driver.UpdatedAt.Value, DateTimeKind.Utc))
                                        .ToOffset(TimeSpan.FromHours(3))
                                        .ToString("yyyy-MM-dd hh:mm:ss tt")
                                        : "")
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a href="tel:@driver?.PhoneNumber">@(driver?.PhoneNumber ?? "N/A")</a>
                                        @if (!string.IsNullOrEmpty(driver?.PhoneNumber))
                                        {
                                            <a onclick="copyToClipboard('@driver?.PhoneNumber')" title="Copy to clipboard" class="text-primary text-decoration-none">
                                                    <i class="bi bi-clipboard"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                                <td class="text-center" data-status style="background: @bgColor; color: white;" data-order="@priority">
                                    @driver?.Status
                                </td>
                                <td class="text-center">
                                    @((driver !=null && driver.IsDisabled) ? "no" : "yes")
                                </td>
                                <td class="text-center">
                                    <a class="btn btn-outline-dark btn-sm" href="/driverdetail/@driver?.PhoneNumber">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/driver.js" asp-append-version="true"></script>
}