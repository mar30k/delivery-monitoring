@model IEnumerable<DeliveryMonitoring.Models.Driver>
@using DeliveryMonitoring.Models;
@{
    ViewData["Title"] = "List of Drivers";
}

<div class="container-fluid g-0">


    <div class="pb-3" id="map">
    </div>
    <div class="p-4">
        <div class="row card">
            <!--The table is Written Here-->
            <div class="pt-3 pb-3 col-12 col-xl-12 table-responsive">

                <table class="table compact stripe hover pt-3" id="tablelist" style="font-size: 13px;">
                    <thead class="">
                        <tr >

                            <th>
                                Name
                            </th>
                            <th class="text-center">
                                Company
                            </th>
                            <th class="text-center">
                                Last Updated At
                            </th>
                            <th class="text-center">
                                Phone Number
                            </th>
                            <th class="text-center">
                                Status
                            </th>
                            <th class="text-center">
                                Is Active
                            </th>
                            <th class="text-center">
                                Battery
                            </th>
                            <th class="text-center">
                                Order
                            </th>
                            <th class="text-center">
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var statusColors = StatusInfo.StatusMap;
                        }
                        @foreach (var driver in Model.OrderByDescending(d => d != null && d.IsDisabled))
                        {
                            var statusKey = driver?.Status?.ToLower() ?? "default";
                            var statusInfo = statusColors.ContainsKey(statusKey) 
                                ? statusColors[statusKey] 
                                : statusColors["default"];

                            var bgColor = statusInfo.Color;
                            var priority = statusInfo.Priority;

                            <tr data-phone="@driver?.PhoneNumber">

                                <td >
                                    @driver?.FirstName
                                </td>
                                <td class="text-center">
                                    @driver?.CompanyTin
                                </td>
                                <td data-order="@driver?.UpdatedAt?.ToString("yyyy-MM-ddTHH:mm:ss")" class="text-center">
                                    @(driver?.UpdatedAt != null
                                        ? new DateTimeOffset(DateTime.SpecifyKind(driver.UpdatedAt.Value, DateTimeKind.Utc))
                                        .ToOffset(TimeSpan.FromHours(3))
                                        .ToString("yyyy-MM-dd hh:mm:ss tt")
                                        : "")
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a href="tel:@driver?.PhoneNumber">@(driver?.PhoneNumber ?? "N/A")</a>
                                        @if (!string.IsNullOrEmpty(driver?.PhoneNumber))
                                        {
                                            <a onclick="copyToClipboard('@driver?.PhoneNumber')" title="Copy to clipboard" class="text-primary text-decoration-none">
                                                    <i class="bi bi-clipboard"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                                <td class="text-center" data-status style="background: @bgColor; color: white;" data-order="@priority">
                                    @driver?.Status
                                </td>
                                <td class="text-center">
                                    @((driver !=null && driver.IsDisabled) ? "no" : "yes")
                                </td>
                                <td class="text-center" data-order="@driver?.BatteryStatus">
                                    @{
                                        int? battery = driver?.BatteryStatus;
                                        string color = BatteryColor(battery);
                                    }
                                    @if (battery != null)
                                    {
                                        <span style="font-weight:600; color:@color;">@battery%</span>
                                    }
                                    else
                                    {
                                        <span style="color:#777;">N/A</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @{
                                        if (driver?.AssignedOrders?.Any() ?? false)
                                        {
                                            foreach (var order in driver?.AssignedOrders ?? new List<string>())
                                            {
                                                <div>
                                                    <a target="_blank" href="/order/@order">@order</a>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div>
                                                N/A
                                            </div>
                                        }
                                    }
                                </td>
                                <td class="text-center">
                                    <a class="btn btn-outline-secondary btn-sm px-1 py-0 text-decoration-none" href="/driverdetail/@driver?.PhoneNumber">Details</a>
                                    <a class="btn btn-outline-secondary btn-sm px-1 py-0 text-decoration-none" href="/review/@driver?.PhoneNumber">Reviews</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <link rel="stylesheet" href="~/css/header-filters.css" asp-append-version="true">
    <script src="~/js/header-filter-dropdown.js" asp-append-version="true"></script>
    <script src="~/js/driver.js" asp-append-version="true"></script>
}
@functions{
    string BatteryColor(int? battery)
    {
        if (battery == null)
            return "#777777"; // gray for N/A

        int b = Math.Clamp(battery.Value, 0, 100);

        if (b < 20) return "#ff0000";      // red
        if (b < 40) return "#ff6600";      // orange
        if (b < 60) return "#ffcc00";      // yellow
        if (b < 80) return "#99cc00";      // yellow-green
        return "#00cc00";                  // green
    }
}