@model IEnumerable<DeliveryMonitoring.Models.Driver>

@{
    ViewData["Title"] = "Index";
}

<div class="container-fluid g-0">

    <!--Find the map here-->
    <div class="col-12 col-xl-12 pb-3" id="map">
    </div>
    <!--Map ends here-->

    <div class="container-fluid col-10 pt-3 pb-3">
        <a class="btn btn-dark" data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
            <i class="bi bi-filter"></i>Filter
        </a>
    </div>

    <div class="container-fluid col-10">
        <div class="collapse" id="collapseExample">
            <form method="get" action="@Url.Action("Filter", "Driver")">

                <div class="row mb-3">
                    <div class="col-12 col-lg-2">
                        <label for="status">Status:</label>
                        <select class="form-control" name="status">
                            <option value="">All</option>
                            <option value="offline">Offline</option>
                            <option value="ready">Ready</option>
                            <option value="accepted">Accepted</option>
                            <option value="delivering">Delivering</option>
                            <option value="completed">Completed</option>
                            <!-- Add other status options as needed -->
                        </select>
                    </div>

                    <div class="col-12 col-lg-2">
                        <label for="companyTin">Company TIN:</label>
                        <input type="text" class="form-control" id="companyTin" name="companyTin" placeholder="Enter Company TIN">
                    </div>

                    <div class="col-2">
                        <br />
                        <button type="submit" class="btn btn-primary">Filter</button>
                    </div>

                </div>
            </form>
        </div>


        <div class="row card">
            <!--The table is Written Here-->
            <div class="pt-3 pb-3 col-12 col-xl-12 table-responsive">

                <table class="table compact stripe hover pt-3" id="tablelist">
                    <thead class="">
                        <tr>

                            <th>
                                @Html.DisplayNameFor(model => model.firstName)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.lastUpdatedAt)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.phoneNumber)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.status)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.isDisabled)
                            </th>

                            <th>
                                Driver Details
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {

                            <tr>

                                <td>
                                    @Html.DisplayFor(modelItem => item.firstName)
                                </td>
                                <td>
                                    @DateTimeOffset.FromUnixTimeMilliseconds(item.lastUpdatedAt).DateTime.ToString("HH:mm:ss - ddd, MMMM dd, yyyy")
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.phoneNumber)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.status)
                                </td>
                                <td>
                                    @{
                                        if (item.isDisabled != null)
                                        {
                                            if (item.isDisabled == true)
                                            {
                                                // isDisabled exists and is true
                                                <text>Not Eligible</text>
                                            }
                                            else
                                            {
                                                // isDisabled exists and is false
                                                <text>Eligible</text>
                                            }
                                        }
                                        else
                                        {
                                        // isDisabled does not exist in the API response
                                            <text>Eligible</text>
                                        }
                                    }
                                </td>

                                <td>
                                    <a class="btn btn-outline-dark" asp-controller="Driver" asp-action="Details" asp-route-id="@item.phoneNumber">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <!--this is the table ending-->
        </div>

    </div>

    <script>
    fetch('/Map/GetMapData')
    .then(response => response.text())
    .then(script => {
    // Execute the received script
    eval(script);
    })
    .catch(error => console.error('Error loading Google Maps API:', error));
    </script>

    <script>
        // var index = -1;
        var marker;
        var markers = [];
        function initMap() {
            // Default center coordinates
            const defaultLat = 9.0165102; // Replace with your default latitude
            const defaultLng = 38.7656678; // Replace with your default longitude

            const map = new google.maps.Map(document.getElementById("map"), {
                center: { lat: defaultLat, lng: defaultLng },
                zoom: 18,
                mapTypeId: google.maps.MapTypeId.ROADMAP
            });
            // map.setCenter();
            // Create an array to store the relevant information

            function fetchDataAndUpdateMarkers() {
                // index++;

                fetch(`/Driver/LiveLocation`)
                    .then(response => response.json())
                    .then(data => {
                        // Iterate over each object in the array
                        var places = [];
                        data.forEach(driver => {
                            // Extract the relevant information from each object
                            if (driver.latLng && typeof driver.latLng === 'object' && driver.latLng.lat !== undefined && driver.latLng.lng !== undefined) {
                                var placeInfo = {
                                    Name: driver.firstName,
                                    lat: driver.latLng.lat,
                                    lng: driver.latLng.lng,
                                    Phone: driver.phoneNumber,
                                    Status: driver.status
                                };
                            }
                            places.push(placeInfo);
                        })

                        // if(index == 0){
                        //     places[0].lat = 9.0166004;
                        //     places[0].lng = 38.7631881;
                        //     places[1].lat = 9.01191;
                        //     places[1].lng = 38.76275;

                        // }
                        // if (index == 1) {
                        //     places[0].lat = 9.0147;
                        //     places[0].lng = 38.76265;
                        //     places[1].lat = 9.01123;
                        //     places[1].lng = 38.76264;
                        // }
                        // if (index == 2) {
                        //     places[0].lat = 9.01394;
                        //     places[0].lng = 38.76294;
                        //     places[1].lat = 9.01103;
                        //     places[1].lng = 38.76267;
                        // }
                        // Push the extracted information into the places array
                        // Filter out undefined values
                        places = places.filter(place => place !== undefined);
                        // Process the places array after fetching the data

                        markers.forEach(marker => marker.setMap(null));
                        markers = []; // Reset the array

                        places.forEach(place => {
                            marker = new google.maps.Marker({
                                position: { lat: place.lat, lng: place.lng },
                                title: place.Name,
                                map: map,
                                icon: {
                                    url: '/images/motor.png',
                                    scaledSize: new google.maps.Size(31, 61) // Adjust the size as needed
                                }
                            });

                            markers.push(marker);

                            // Add a listener for the marker
                            var content = "<b>Name:</b> " + place.Name + "<br/><b>Phone:</b> " + place.Phone + "<br/><b>Status:</b> " + place.Status;

                            var infowindow = new google.maps.InfoWindow();

                            google.maps.event.addListener(marker, 'mouseover', (function (marker, content, infowindow) {
                                return function () {
                                    infowindow.setContent(content);
                                    infowindow.open(map, marker);
                                };
                            })(marker, content, infowindow));

                            google.maps.event.addListener(marker, 'mouseout', (function (infowindow) {
                                return function () {
                                    infowindow.close();
                                };
                            })(infowindow));
                        });
                        // console.log(places);
                        // console.log(index);

                    })
                    .catch(error => console.error('Error fetching live location:', error, error.responseText));
            }
            // Call the function immediately to show the initial view
            fetchDataAndUpdateMarkers();
            // setInterval(fetchDataAndUpdateMarkers, 10000);
                                
        }
    </script>
    <!--Map JavaScript Implementation Ends Here-->
    <!--Jquery Datatable Starts Here-->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.js"></script>
    <script>
        var js = jQuery.noConflict(true);
        js(document).ready(function () {
            js('#tablelist').DataTable({
                responsive: true
            });
        });
    </script>
    <!--Jquery Datatable Ends Here-->
</div>
