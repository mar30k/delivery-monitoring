@model DriverReview

@{
    ViewData["Title"] = "Driver Reviews";
}

<div class="container mt-4">
    <div class="card shadow-sm rounded-3">
        <div class="card-body">

            <h3 class="card-title mb-3">Driver Reviews</h3>
            <div class="d-flex align-items-center mb-3">
                @if (Model != null)
                {
                    <h4 class="mb-0 me-3 text-warning">
                        @Model?.Rating.ToString("0.0")
                        <i class="bi bi-star-fill"></i>
                    </h4>
                    <span class="text-muted">(@Model?.Count reviews)</span>
                }
                else
                {
                    <span class="text-muted">(0 reviews)</span>
                }
            </div>
            <hr />
            @if (Model?.Reviews != null && Model.Reviews.Any())
            {
                <div class="mb-3">
                    <button class="btn btn-outline-secondary btn-sm" onclick="filterByRating(0)">All</button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="filterByRating(5)">5 <i class="bi bi-star-fill text-warning"></i></button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="filterByRating(4)">4 <i class="bi bi-star-fill text-warning"></i></button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="filterByRating(3)">3 <i class="bi bi-star-fill text-warning"></i></button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="filterByRating(2)">2 <i class="bi bi-star-fill text-warning"></i></button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="filterByRating(1)">1 <i class="bi bi-star-fill text-warning"></i></button>
                </div>
                <div id="noReviewsMessage" class="alert alert-info d-none">
                    No reviews found for the selected rating.
                </div>
                <div class="row">
                    @for (int i = 0; i < Model.Reviews.Count; i++)
                    {
                        var review = Model.Reviews[i];
                        var imageUrl = (review.Image ?? "/images/default-avatar.png");
                        if (imageUrl.StartsWith("http://"))
                        {
                            imageUrl = "/images/default-avatar.png";
                        }

                        <div class="col-md-6 mb-4" data-rating="@review.Rating">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-body d-flex">
                                    <div class="me-4">
                                        <img src="@imageUrl"
                                             class="rounded-circle border"
                                             alt="img"
                                             width="64" height="64" />
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center mb-1">
                                            <h5 class="mb-0 me-2">@review.FullName</h5>
                                            @if (review.IsVerifiedUser)
                                            {
                                                <i class="bi bi-patch-check-fill text-primary" title="Verified"></i>
                                            }
                                        </div>
                                        <div class="text-warning mb-1">
                                            @for (int j = 1; j <= 5; j++)
                                            {
                                                <i class="bi @(j <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                        <small class="text-muted d-block mb-2">@review.Date.ToString("MMMM dd, yyyy • h:mm tt")</small>
                                        <small class="text-muted d-block mb-2">@review.ReferenceVoucher</small>

                                        @if (!string.IsNullOrWhiteSpace(review.Review))
                                        {
                                            <p class="mb-2">@review.Review</p>
                                        }
                                        else
                                        {
                                            <p class="text-muted fst-italic mb-2">No written review provided.</p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(review.Reply))
                                        {
                                            <div class="bg-light p-3 rounded border-start border-primary border-3">
                                                <strong class="text-primary">Reply:</strong>
                                                <div>@review.Reply</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info text-center mt-4">
                    No reviews found for this driver.
                </div>
            }
        </div>
    </div>
</div>
@section Scripts {
    <script>
        function filterByRating(rating) {
            let found = false;
            document.querySelectorAll('[data-rating]').forEach(card => {
                const cardRating = parseInt(card.getAttribute('data-rating'), 10);
                if (rating === 0 || cardRating === rating) {
                    card.style.display = '';
                    found = true;
                } else {
                    card.style.display = 'none';
                }
            });

            // Show or hide "No reviews" message
            const msg = document.getElementById('noReviewsMessage');
            if (!found) {
                msg.classList.remove('d-none');
            } else {
                msg.classList.add('d-none');
            }
        }
    </script>
}