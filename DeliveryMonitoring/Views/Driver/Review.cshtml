@model DriverReview

@{
    ViewData["Title"] = "Driver Reviews";
}

<div class="container mt-4">
    <div class="card shadow-sm rounded-3">
        <div class="card-body">

            <h3 class="card-title mb-3">Driver Reviews</h3>
            <div class="d-flex align-items-center mb-3">
                @if (Model != null)
                {
                    <h4 class="mb-0 me-3 text-warning">
                        @Model?.Rating.ToString("0.0")
                        <i class="bi bi-star-fill"></i>
                    </h4>
                    <span class="text-muted">(@Model?.Count reviews)</span>
                }
                else
                {
                    <span class="text-muted">(0 reviews)</span>
                }
            </div>
            <hr />@if (Model?.Reviews != null && Model.Reviews.Any())
            {
                <div class="mb-3">
                    <button class="btn btn-outline-secondary btn-sm active" data-rating="0" onclick="filterByRating(this)">All</button>
                    <button class="btn btn-outline-secondary btn-sm" data-rating="5" onclick="filterByRating(this)">5 <i class="bi bi-star-fill text-warning"></i></button>
                    <button class="btn btn-outline-secondary btn-sm" data-rating="4" onclick="filterByRating(this)">4 <i class="bi bi-star-fill text-warning"></i></button>
                    <button class="btn btn-outline-secondary btn-sm" data-rating="3" onclick="filterByRating(this)">3 <i class="bi bi-star-fill text-warning"></i></button>
                    <button class="btn btn-outline-secondary btn-sm" data-rating="2" onclick="filterByRating(this)">2 <i class="bi bi-star-fill text-warning"></i></button>
                    <button class="btn btn-outline-secondary btn-sm" data-rating="1" onclick="filterByRating(this)">1 <i class="bi bi-star-fill text-warning"></i></button>
                </div>

                <div id="noReviewsMessage" class="alert alert-info d-none">
                    No reviews found for this driver.
                </div>

                <div class="row" id="reviewsContainer">
                    @for (int i = 0; i < Model.Reviews.Count; i++)
                    {
                        var review = Model.Reviews[i];
                        var imageUrl = (review.Image ?? "/images/default-avatar.png");
                        if (imageUrl.StartsWith("http://"))
                        {
                            imageUrl = "/images/default-avatar.png";
                        }

                        <div class="col-md-6 mb-4 col-12 col-lg-4 review-card" data-rating="@review.Rating">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-body d-flex">
                                    <div class="me-4">
                                        <img src="@imageUrl"
                                             class="rounded-circle border"
                                             alt="img"
                                             width="64" height="64" />
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center mb-1">
                                            <h5 class="mb-0 me-2">@review.FullName</h5>
                                            @if (review.IsVerifiedUser)
                                            {
                                                <i class="bi bi-patch-check-fill text-primary" title="Verified"></i>
                                            }
                                        </div>
                                        <div class="text-warning mb-1">
                                            @for (int j = 1; j <= 5; j++)
                                            {
                                                <i class="bi @(j <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                        <small class="text-muted d-block mb-2">@review.Date.ToString("MMMM dd, yyyy • h:mm tt")</small>
                                        <a class="text-decoration-none" target="_blank"
                                           href="/orderdetail?voucher=@review.ReferenceVoucher">@review.ReferenceVoucher</a>

                                        @if (!string.IsNullOrWhiteSpace(review.Review))
                                        {
                                            <p class="mb-2">@review.Review</p>
                                        }
                                        else
                                        {
                                            <p class="text-muted fst-italic mb-2">No written review provided.</p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(review.Reply))
                                        {
                                            <div class="bg-light p-3 rounded border-start border-primary border-3">
                                                <strong class="text-primary">Reply:</strong>
                                                <div>@review.Reply</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                <nav>
                    <ul class="pagination justify-content-center mt-4" id="paginationContainer"></ul>
                </nav>
            }
            else
            {
                <div class="alert alert-info text-center mt-4">
                    No reviews found for this driver.
                </div>
            }
        </div>
    </div>
</div>
@section Scripts {
    <script>
        const reviewsPerPage = 12;
        let currentPage = 1;
        let currentRating = 0;

        function renderPagination(totalReviews) {
            const totalPages = Math.ceil(totalReviews / reviewsPerPage);
            const paginationContainer = document.getElementById('paginationContainer');
            paginationContainer.innerHTML = '';

            if (totalPages <= 1) return;

            const createPageItem = (page, text = null, disabled = false, active = false) => {
                const li = document.createElement('li');
                li.className = 'page-item' + (disabled ? ' disabled' : '') + (active ? ' active' : '');
                li.innerHTML = `<a class="page-link text-decoration-none" href="#">${text || page}</a>`;
                if (!disabled && !active) {
                    li.addEventListener('click', function (e) {
                        e.preventDefault();
                        currentPage = page;
                        filterByRating(null, currentRating);
                    });
                }
                return li;
            };

            // Previous button
            paginationContainer.appendChild(createPageItem(currentPage - 1, '«', currentPage === 1));

            // Show first page
            if (currentPage > 3) {
                paginationContainer.appendChild(createPageItem(1, '1'));
                if (currentPage > 4) {
                    const ellipsis = document.createElement('li');
                    ellipsis.className = 'page-item disabled';
                    ellipsis.innerHTML = `<span class="page-link">…</span>`;
                    paginationContainer.appendChild(ellipsis);
                }
            }

            // Pages around current page
            for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) {
                paginationContainer.appendChild(createPageItem(i, null, false, i === currentPage));
            }

            // Show last page
            if (currentPage < totalPages - 2) {
                if (currentPage < totalPages - 3) {
                    const ellipsis = document.createElement('li');
                    ellipsis.className = 'page-item disabled';
                    ellipsis.innerHTML = `<span class="page-link">…</span>`;
                    paginationContainer.appendChild(ellipsis);
                }
                paginationContainer.appendChild(createPageItem(totalPages, totalPages));
            }

            // Next button
            paginationContainer.appendChild(createPageItem(currentPage + 1, '»', currentPage === totalPages));
        }
        function filterByRating(button, rating = null) {
            if (button) {
                const selectedRating = parseInt(button.getAttribute('data-rating'), 10);
                const isActive = button.classList.contains('active');
                currentRating = isActive && selectedRating !== 0 ? 0 : selectedRating;

                document.querySelectorAll('.mb-3 button[data-rating]').forEach(btn => btn.classList.remove('active'));
                if (currentRating === 0) {
                    document.querySelector('.mb-3 button[data-rating="0"]').classList.add('active');
                } else {
                    button.classList.add('active');
                }

                currentPage = 1; // Reset page on filter change
            }

            const allReviews = document.querySelectorAll('.review-card');
            let filteredReviews = [];
            allReviews.forEach(card => {
                const cardRating = parseInt(card.getAttribute('data-rating'), 10);
                if (currentRating === 0 || cardRating === currentRating) {
                    filteredReviews.push(card);
                }
                card.style.display = 'none';
            });

            // Show only current page reviews
            const start = (currentPage - 1) * reviewsPerPage;
            const end = start + reviewsPerPage;
            filteredReviews.slice(start, end).forEach(card => card.style.display = '');

            // Show/hide "No reviews" message
            const msg = document.getElementById('noReviewsMessage');
            if (filteredReviews.length === 0) {
                const messages = {
                    0: "No reviews found for this driver.",
                    1: "No 1-star reviews found.",
                    2: "No 2-star reviews found.",
                    3: "No 3-star reviews found.",
                    4: "No 4-star reviews found.",
                    5: "No 5-star reviews found.",
                }
                msg.textContent = messages[currentRating] || "No reviews found.";
                msg.classList.remove('d-none');
            } else {
                msg.classList.add('d-none');
            }

            // Render pagination
            renderPagination(filteredReviews.length);
        }

        // Initial render
        document.addEventListener('DOMContentLoaded', function () {
            filterByRating(null, 0);
        });
    </script>
}