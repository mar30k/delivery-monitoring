@model DriverReview

@{
    ViewData["Title"] = "Driver Reviews";
}

<div class="container mt-4">
    <div class="card shadow-sm rounded-3">
        <div class="card-body">

            <h3 class="card-title mb-3">Driver Reviews</h3>
            <div class="d-flex align-items-center mb-3">
                <h4 id="averageRating" class="mb-0 me-3 text-warning">
                    @Model?.Rating.ToString("0.0")
                    <i class="bi bi-star-fill"></i>
                </h4>
                <span id="reviewCount" class="text-muted">(@Model?.Count reviews)</span>
            </div>
            <hr />
            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert alert-info text-center mt-4">
                    @ViewBag.Error
                </div>
            }
            @if (Model?.Reviews != null && Model.Reviews.Any())
            {
                <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap">
                    <!-- Rating buttons -->
                    <div class="btn-group mb-2" role="group" aria-label="Rating filters">
                        <button type="button" class="btn btn-outline-secondary btn-sm active" data-rating="0" onclick="handleRatingClick(this)">All</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-rating="5" onclick="handleRatingClick(this)">5 <i class="bi bi-star-fill text-warning"></i></button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-rating="4" onclick="handleRatingClick(this)">4 <i class="bi bi-star-fill text-warning"></i></button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-rating="3" onclick="handleRatingClick(this)">3 <i class="bi bi-star-fill text-warning"></i></button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-rating="2" onclick="handleRatingClick(this)">2 <i class="bi bi-star-fill text-warning"></i></button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-rating="1" onclick="handleRatingClick(this)">1 <i class="bi bi-star-fill text-warning"></i></button>
                    </div>

                    <!-- Date range picker -->
                    <div class="mb-2">
                        <input type="text" id="dateRange" class="form-control form-control-sm" style="width: 250px;" readonly />
                    </div>
                </div>

                <div id="noReviewsMessage" class="alert alert-info d-none">
                    No reviews found for this driver.
                </div>

                <div class="row" id="reviewsContainer">
                    @for (int i = 0; i < Model.Reviews.Count; i++)
                    {
                        var review = Model.Reviews[i];
                        var imageUrl = (review.Image ?? "/images/default-avatar.png");
                        if (imageUrl.StartsWith("http://"))
                        {
                            imageUrl = "/images/default-avatar.png";
                        }

                        <div class="col-md-6 mb-4 col-12 col-lg-4 review-card" data-rating="@review.Rating">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-body d-flex">
                                    <div class="me-4">
                                        <img src="@imageUrl"
                                             class="rounded-circle border"
                                             alt="img"
                                             width="64" height="64" />
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center mb-1">
                                            <h5 class="mb-0 me-2">@review.FullName</h5>
                                            @if (review.IsVerifiedUser)
                                            {
                                                <i class="bi bi-patch-check-fill text-primary" title="Verified"></i>
                                            }
                                        </div>
                                        <div class="text-warning mb-1">
                                            @for (int j = 1; j <= 5; j++)
                                            {
                                                <i class="bi @(j <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                        <small class="text-muted d-block mb-2">@review.Date.ToString("MMMM dd, yyyy • h:mm tt")</small>
                                        <a class="text-decoration-none" target="_blank"
                                           href="/orderdetail?voucher=@review.ReferenceVoucher">@review.ReferenceVoucher</a>

                                        @if (!string.IsNullOrWhiteSpace(review.Review))
                                        {
                                            <p class="mb-2">@review.Review</p>
                                        }
                                        else
                                        {
                                            <p class="text-muted fst-italic mb-2">No written review provided.</p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(review.Reply))
                                        {
                                            <div class="bg-light p-3 rounded border-start border-primary border-3">
                                                <strong class="text-primary">Reply:</strong>
                                                <div>@review.Reply</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                <nav>
                    <ul class="pagination justify-content-center mt-4" id="paginationContainer"></ul>
                </nav>
            }
        </div>
    </div>
</div>
@section Scripts {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css">
<script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
<script src="~/js/driver-reviews.js" asp-append-version="true"></script>
}