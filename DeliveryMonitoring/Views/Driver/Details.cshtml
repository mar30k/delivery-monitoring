@using System.Text
@model DeliveryMonitoring.Models.Driver
@{
    ViewData["Title"] = "Driver Details";
    var Orders = ViewData["Orders"] as List<OrderDetail>;
    var routedata = ViewData["Routedata"] as RouteModel;

    var coordinatesJson = Newtonsoft.Json.JsonConvert.SerializeObject(Model?.Coordinates);
    double totalRating = Model?.Review?.totalRating ?? 0.0;
    double totalReviews = Model?.Review?.totalReviews ?? 0;
    double rating = totalRating / totalReviews;

    string GetStarRating(double rating)
    {
        int fullStars = (int)rating;
        bool hasHalfStar = rating - fullStars >= 0.5;
        StringBuilder stars = new StringBuilder();
        for (int i = 1; i <= 5; i++)
        {
            if (i <= fullStars)
            {
                stars.Append("<i class='bi bi-star-fill'></i>"); // Assuming you're using Bootstrap Icons
            }
            else if (i == fullStars + 1 && hasHalfStar)
            {
                stars.Append("<i class='bi bi-star-half'></i>");
            }
            else
            {
                stars.Append("<i class='bi bi-star'></i>");
            }
        }
        return stars.ToString();
    }
}

<!-- Add this line to include the custom CSS -->
<link rel="stylesheet" href="~/css/driverDetail.css" />

<div class="container-fluid">

    <!--Find the map here-->
    <div class="col-12 col-md-12" id="map">
    </div>
    <!--Map ends here-->

    <div class="container-fluid col-11 col-lg-7 pt-3">
        <div class="card border-1 p-2" id="orderCard">
            <div class="row pt-3" id="orderDetail">
                <div class="col-4">
                    <h4><i class="fa-sharp-duotone fa-solid fa-motorcycle"></i> Driver</h4>
                </div>
                
                <div class="col-8 d-flex justify-content-center gap-2">
                    <div>
                        <a class="btn btn-success btn-sm" href="/updatedriverinfo/@Model?.PhoneNumber">
                            <i class="bi bi-pencil-square"></i> Update Driver Info
                        </a>
                    </div>
                    <div>
                        <a class="btn btn-primary btn-sm" href="/review/@Model?.PhoneNumber">
                            <i class="bi bi-chat-left-text"></i>&nbsp;Reviews
                        </a>
                    </div>
                </div>
            </div>

            <div class="container pb-3">
                <div class="card shadow-sm">
                    <div class="row g-0">
                        <div class="col-md-4 text-center p-3 border-end">
                            <img src="@Model?.Detail?.ProfilePicture"
                                 alt="Profile Picture"
                                 class="zoomable img-thumbnail mb-2"
                                 data-img="@Model?.Detail?.ProfilePicture">

                            <img src="@Model?.Detail?.IdAttachment"
                                 alt="ID Attachment"
                                 class="zoomable img-thumbnail"
                                 data-img="@Model?.Detail?.IdAttachment">
                        </div>
                        <partial name="_ImageModal" />
                        <!-- Right Column: Details -->
                        <div class="col-md-8 p-3">
                            <h4 class="mb-3">@Model?.FirstName</h4>

                            <!-- Status -->
                            @{
                                var statusColors = StatusInfo.StatusMap;
                                var statusKey = Model?.Status?.ToLower() ?? "default";
                                var statusInfo = statusColors.ContainsKey(statusKey)
                                ? statusColors[statusKey]
                                : statusColors["default"];
                                var bgColor = statusInfo.Color;
                            }
                            <p>
                                <span class="fw-bold">Status: </span>
                                <span class="text-white px-2 py-1 rounded" id="statusInfo" style="background-color: @bgColor;">
                                    @Model?.Status
                                </span>
                            </p>

                            <!-- Assigned Orders -->
                            @if ((Orders ?? new List<OrderDetail>()).Any(o => o.AssignedDriverPhoneNumber == @Model?.PhoneNumber))
                            {
                                var assignedOrders = (Orders ?? new List<OrderDetail>())
                                .Where(o => o.AssignedDriverPhoneNumber == @Model?.PhoneNumber).ToList();
                                <p>
                                    <span class="fw-bold">Orders: </span>
                                    @foreach (var order in assignedOrders)
                                    {
                                        <a href="/order/@order.VoucherCode" class="me-2 text-decoration-none" target="_blank">
                                            @order.VoucherCode
                                        </a>
                                    }
                                </p>
                            }

                            <!-- General Info Grid -->
                            <div class="row">
                                <div class="col-sm-6 mb-2">
                                    <span class="fw-bold">Last Updated: </span>
                                    <span id="lastUpdatedAtInfo">
                                        @(Model?.UpdatedAt != null
                                                ? new DateTimeOffset(DateTime.SpecifyKind(Model.UpdatedAt.Value, DateTimeKind.Utc))
                                                .ToOffset(TimeSpan.FromHours(3))
                                                .ToString("yyyy-MM-dd hh:mm:ss tt")
                                                : "")
                                    </span>
                                </div>
                                <div class="col-sm-6 mb-2">
                                    <span class="fw-bold">Company TIN: </span>
                                    <a href="/company/@Model?.CompanyTin">@Html.DisplayFor(model => model.CompanyTin)</a>
                                </div>
                                <div class="col-sm-6 mb-2">
                                    <span class="fw-bold">Phone: </span>
                                    <a href="tel:@Model?.PhoneNumber">@Model?.PhoneNumber</a>
                                </div>
                                <div class="col-sm-6 mb-2">
                                    <span class="fw-bold">Plate Number: </span>
                                    <span>@(Model?.Detail?.PlateNumber ?? "N/A")</span>
                                </div>
                                <div class="col-sm-6 mb-2">
                                    <span class="fw-bold">Email: </span>
                                    @if (!string.IsNullOrEmpty(Model?.Detail?.Email))
                                    {
                                        <a href="mailto:@Model?.Detail?.Email">@Model?.Detail?.Email</a>
                                    }
                                    else
                                    {
                                        <span>N/A</span>
                                    }
                                </div>
                                <div class="col-sm-6 mb-2">
                                    <span class="fw-bold">Gender: </span>
                                    <span>@(Model?.Detail?.Gender ?? "N/A")</span>
                                </div>
                                <div class="col-sm-6 mb-2">
                                    <span class="fw-bold">Accepted Orders: </span>
                                    <span>@(Model?.NumberOfAcceptedOrders.ToString() ?? "N/A")</span>
                                </div>
                                <div class="col-sm-6 mb-2">
                                    <span class="fw-bold">Rejected Orders: </span>
                                    <span>@(Model?.NumberOfRejectedOrders.ToString() ?? "N/A")</span>
                                </div>
                                <div class="col-sm-6 mb-2">
                                    <span class="fw-bold">Completed Orders: </span>
                                    <span id="completed">Loading...</span>
                                </div>
                                <div class="col-sm-6 mb-2">
                                    <span class="fw-bold">Traveled Distance: </span>
                                    <span>@(Model?.Detail?.TotalKm != null ? Model?.Detail?.TotalKm?.ToString("0.00") + " km" : "N/A")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let infowindow = null;
        const statusColors = {
            offline:         { color: "#dc3545", priority: "1" },
            default:         { color: "#ffc107", priority: "2" },
            completed:       { color: "#20c997", priority: "3" },
            arrived:         { color: "#F7BEA2", priority: "4" },
            arrivedatbranch: { color: "coral",   priority: "5" },
            accepted:        { color: "seagreen", priority: "6" },
            delivering:      { color: "darkorange", priority: "7" },
            ready:           { color: "#28a745", priority: "8" }
        };
        var routeCoordinates = @Html.Raw(coordinatesJson);
        var coordinate = {
            lat: @(@Model?.LatLng?.lat ?? 0),
            lng: @(@Model?.LatLng?.lng ?? 0)
        };
        if(routeCoordinates == null){
            routeCoordinates = [];
            routeCoordinates.push(coordinate);
        }
        fetch('/Map/GetMapData')
            .then(response => response.text())
            .then(script => {
                // Execute the received script
                eval(script);
            })
            .catch(error => console.error('Error loading Google Maps API:', error));
        function initMap() {
            var marker2;
            var bearing = 0;
            var map = new google.maps.Map(document.getElementById("map"), {
                zoom: 16,
                mapTypeId: google.maps.MapTypeId.HYBRID
            });
            //initializes the map with specified parameters - ends here
            var directionsRenderer = new google.maps.DirectionsRenderer();
            directionsRenderer.setMap(map);

            details();

            //google map's direction service to draw the line in real road setting ends here
            function details() {

                var place = null;
                var orderAssigned = false;

                @{
                    if (Model != null)
                    {
                        var status = Model.Status?.ToLower();
                        var driverOrder = Orders?.FirstOrDefault(x => x.AssignedDriverPhoneNumber == Model.PhoneNumber);
                        string destLat = "0.0";
                        string destLng = "0.0";
                        
                        if (status == "delivering" || status == "arrivedatbranch")
                        {
                            destLat = driverOrder?.CustomerLat?.ToString() ?? "0.0";
                            destLng = driverOrder?.CustomerLng?.ToString() ?? "0.0";
                        }
                        else if (status == "accepted")
                        {
                            destLat = driverOrder?.TargetBranchLat?.ToString() ?? "0.0";
                            destLng = driverOrder?.TargetBranchLng?.ToString() ?? "0.0";
                        }
                        else if (driverOrder != null)
                        {
                            destLat = driverOrder?.CustomerLat?.ToString() ?? "0.0";
                            destLng = driverOrder?.CustomerLng?.ToString() ?? "0.0";
                        }
                        <text>
                        place = {
                            Name: '@Model.FirstName',
                            LastUpdatedAt: '@(
                                        Model?.UpdatedAt != null
                                                ? new DateTimeOffset(DateTime.SpecifyKind(Model.UpdatedAt.Value, DateTimeKind.Utc))
                                                        .ToOffset(TimeSpan.FromHours(3))
                                                        .ToString("yyyy-MM-dd hh:mm:ss tt")
                                                : ""
                            )',
                            Phone: '@Model?.PhoneNumber',
                            Status: '@Model?.Status',
                            lat: @(@Model?.LatLng?.lat ?? 0.0),
                            lng: @(@Model?.LatLng?.lng ?? 0.0),
                            DestLat: @destLat,
                            DestLng: @destLng
                        };                                      
                        </text>

                        if (driverOrder != null)
                        {
                            <text>orderAssigned = true;</text>
                        }
                    }
                }
                marker = new google.maps.Marker({
                    position: { lat: routeCoordinates[0].lat, lng: routeCoordinates[0].lng},
                    title:place.Name,
                    map: map,
                    icon: {
                        path: google.maps.SymbolPath.FORWARD_CLOSED_ARROW,
                        scale: 4,
                        strokeColor: "#FF0000", // Outline color
                        fillColor: "#FF0000",   // Fill color
                        fillOpacity: 1,         // Optional: controls fill transparency
                        rotation: 90            // Optional: rotate the arrow if needed
                    },
                });

                map.setCenter(marker.getPosition());

                const statusKey = (place.Status || "default").toLowerCase();
                const statusColor = statusColors[statusKey]?.color || statusColors.default.color;
                const content = `
                    <b>Name:</b> ${place.Name}<br/>
                    <b>LastUpdatedAt:</b> ${place.LastUpdatedAt}<br/>
                    <b>Phone:</b> ${place.Phone}<br/>
                    <b>Status:</b> <span style="background-color:${statusColor}; color:white; padding:2px 6px; border-radius:4px;">${place.Status}</span>
                `;

                infowindow = new google.maps.InfoWindow();


                google.maps.event.addListener(marker, 'mouseover', (function (marker, content, infowindow) {
                    return function () {
                        infowindow.setContent(content);
                        infowindow.open(map, marker);
                    };
                })(marker, content, infowindow));

                google.maps.event.addListener(marker, 'mouseout', (function (infowindow) {
                    return function () {
                        infowindow.close();
                    };
                })(infowindow));

                var liveLocation = [routeCoordinates[0].lat, routeCoordinates[0].lng];

                let currentPolyline = null; // Declare at the outer scope

                if (orderAssigned) {
                    marker2 = new google.maps.Marker({
                        position: {
                            lat: routeCoordinates[routeCoordinates.length - 1].lat,
                            lng: routeCoordinates[routeCoordinates.length - 1].lng
                        },
                        title: 'Order Destination',
                        map: map,
                        icon: {
                            url: '/images/Destination.png',
                            scaledSize: new google.maps.Size(25, 25)
                        },
                    });

                    currentPolyline = new google.maps.Polyline({
                        path: routeCoordinates,
                        geodesic: true,
                        strokeColor: "red",
                        strokeOpacity: 1.0,
                        strokeWeight: 4
                    });
                    currentPolyline.setMap(map);

                    var destinationPosition = new google.maps.LatLng(place.DestLat, place.DestLng);

                    var apiResponseInterval = setInterval(function () {
                        if (liveLocation.length > 0) {
                            liveLocation.pop();
                            liveLocation.pop();
                        }

                        fetch(`/Driver/LiveLocation/${place.Phone}`)
                            .then(response => response.json())
                            .then(data => {
                                routeCoordinates = data.coordinates;

                                if (data.latLng.lat !== undefined && data.latLng.lng !== undefined) {
                                    liveLocation.push(routeCoordinates[0].lat);
                                    liveLocation.push(routeCoordinates[0].lng);
                                }

                                moveCar();
                                updateDriverInfo(data.status, data.updatedAt, data.phoneNumber, data.firstName);

                                // Remove old marker and polyline if they exist
                                if (marker2) marker2.setMap(null);
                                if (currentPolyline) currentPolyline.setMap(null);

                                marker2 = new google.maps.Marker({
                                    position: {
                                        lat: routeCoordinates[routeCoordinates.length - 1].lat,
                                        lng: routeCoordinates[routeCoordinates.length - 1].lng
                                    },
                                    title: 'Order Destination',
                                    map: map,
                                    icon: {
                                        url: '/images/Destination.png',
                                        scaledSize: new google.maps.Size(25, 25)
                                    },
                                });

                                currentPolyline = new google.maps.Polyline({
                                    path: routeCoordinates,
                                    geodesic: true,
                                    strokeColor: "red",
                                    strokeOpacity: 1.0,
                                    strokeWeight: 4
                                });
                                currentPolyline.setMap(map);

                                if (
                                    marker.getPosition().lat() === destinationPosition.lat() &&
                                    marker.getPosition().lng() === destinationPosition.lng() ||
                                    data.status === "completed"
                                ) {
                                    clearInterval(apiResponseInterval);
                                    marker2.setMap(null);
                                    marker.setMap(null);
                                    if (currentPolyline) currentPolyline.setMap(null);
                                    details();
                                }
                            })
                            .catch(error => console.error('Error fetching live location:', error));
                    }, 10000);
                }
                else {
                    var AR = setInterval(function () {
                        if (liveLocation.length > 0) {
                            liveLocation.pop();
                            liveLocation.pop();
                        }

                        fetch(`/Driver/LiveLocation/${place.Phone}`)
                            .then(response => response.json())
                            .then(data => {
                                if (data.latLng.lat !== undefined && data.latLng.lng !== undefined) {
                                    liveLocation.push(data.latLng.lat);
                                    liveLocation.push(data.latLng.lng);
                                }
                                moveCar();
                                updateDriverInfo(data.status, data.updatedAt, data.phoneNumber, data.firstName);
                                if (data.status === "delivering" || data.status==="arrivedatbranch" || data.status==="accepted") {
                                    clearInterval(AR);
                                    marker.setMap(null);
                                    details();
                                }
                            })
                            .catch(error => console.error('Error fetching live location:', error));
                    }, 10000);
                }

                function moveCar() {
                    if (liveLocation.length > 0 &&
                        (liveLocation[0] !== marker.getPosition().lat() || liveLocation[1] !== marker.getPosition().lng())) {

                        const startLatLng = marker.getPosition();
                        const endLatLng = new google.maps.LatLng(liveLocation[0], liveLocation[1]);
                        const bearing = google.maps.geometry.spherical.computeHeading(startLatLng, endLatLng);

                        const duration = 2000; // total animation duration in ms
                        const startTime = performance.now();

                        function animate(time) {
                            const elapsed = time - startTime;
                            const t = Math.min(elapsed / duration, 1); // progress from 0 to 1
                            const interpolatedPosition = google.maps.geometry.spherical.interpolate(startLatLng, endLatLng, t);
                            marker.setPosition(interpolatedPosition);
                            marker.setIcon({
                                path: google.maps.SymbolPath.FORWARD_CLOSED_ARROW,
                                scale: 4,
                                strokeColor: "#FF0000", // Outline color
                                fillColor: "#FF0000",   // Fill color
                                fillOpacity: 1,         // Optional: controls fill transparency
                                rotation: bearing,
                            });

                            if (t < 1) {
                                requestAnimationFrame(animate);
                            } else {
                                marker.setPosition(endLatLng);
                                map.setCenter(endLatLng);
                            }
                        }

                        requestAnimationFrame(animate);
                    }
                }

            }
        }
        function updateDriverInfo(status, lastUpdatedAt, phoneNumber, name) {
            const formatted = moment(lastUpdatedAt).format("YYYY-MM-DD hh:mm:ss A");
            const key = status.toString().toLowerCase();
            const backGround = statusColors[key] || statusColors['default'];
            $("#statusInfo")
                .text(status)
                .css("background-color", backGround.color)

            $("#lastUpdatedAtInfo").text(formatted);
            if (infowindow) {
                const updatedContent = `
                    <b>Name:</b> ${name}<br/>
                    <b>LastUpdatedAt:</b> ${formatted}<br/>
                    <b>Phone:</b> ${phoneNumber}<br/>
                    <b>Status:</b> <span style="background-color:${backGround.color}; color:white; padding:2px 6px; border-radius:4px;">${status}</span>
                `;
                infowindow.setContent(updatedContent);
            }
        }
        async function getCompletedOrders(phoneNumber){
            const response = await fetch('/getcompletedorders');
            const completedOrders = await response.json();
            if (!Array.isArray(completedOrders.data)) {
                return ;
            }
            const driverOrders = completedOrders.data.filter(order => order.driverPhoneNumber === phoneNumber);
            return driverOrders ? driverOrders.length : null;
        }
        $(document).ready(async function () {
            const phoneNumber = '@Model?.PhoneNumber';// static value or load dynamically
            const count = await getCompletedOrders(phoneNumber);
            $("#completed").text(count !== null ? count : "0");
        });
    </script>
}

