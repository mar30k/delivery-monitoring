@model DeliveryMonitoring.Models.Driver

@{
    ViewData["Title"] = "Details";
}


<div class="container-fluid pt-5">
    
    
    <div class="row">
        <div class="col-12 col-md-5">
            <h4>Driver Details</h4>
            <hr />
            <div class="row">
                
                    <!--First Name Beginning-->
                    <dt class="col-sm-5">
                        @Html.DisplayNameFor(model => model.firstName)
                    </dt>
                    <dd class="col-sm-7">
                        @Html.DisplayFor(model => model.firstName)
                    </dd>
                    <!--First Name Ending-->
                    <!--Last Updated at Beginning-->
                    <dt class="col-sm-5">
                        @Html.DisplayNameFor(model => model.lastUpdatedAt)
                    </dt>
                    <dd class="col-sm-7">
                        @{
                            long unixtimestamp = Model.lastUpdatedAt;
                        }
                        @DateTimeOffset.FromUnixTimeMilliseconds(unixtimestamp).DateTime.ToString("yyyy-MM-dd HH:mm:ss")
                    </dd>
                    <!--Last Updated at Ending-->
                    <!--Phone Number Beginning-->
                    <dt class="col-sm-5">
                        @Html.DisplayNameFor(model => model.phoneNumber)
                    </dt>
                    <dd class="col-sm-7">
                        @Html.DisplayFor(model => model.phoneNumber)
                    </dd>
                    <!--Phone Number Ending-->
                    <!--Driver Status Beginning-->
                    <dt class="col-sm-5">
                        @Html.DisplayNameFor(model => model.status)
                    </dt>
                    <dd class="col-sm-7">
                        @Html.DisplayFor(model => model.status)
                    </dd>
                    <!--Driver Status Ending-->
                    <!--Address Beginning-->
                    @{
                        double latitude = Model.latLng.lat;
                        double longtiude = Model.latLng.lng;
                        @*yet to be implemented*@
                    }
                    <!--Address Ending-->
                    <a data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
                        Additional Info
                    </a>
            </div>
                

                <div class="collapse pt-3 row" id="collapseExample">
                    <div class="card card-body">
                        <dl>
                        <dt class="col-sm-5">
                            @Html.DisplayNameFor(model => model.companyTin)
                        </dt>
                        <dd class="col-sm-7">
                            @Html.DisplayFor(model => model.companyTin)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.deviceID)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.deviceID)
                        </dd>
                        </dl>
                        
                    </div>
                </div>
            
            

            <div class="pt-3 pb-3">
                <a class="btn btn-outline-dark" asp-action="Index">Back to List</a>
            </div>
        </div>
        <div class="col-12 col-md-7" id="map">

        </div>
        
    </div>

    

