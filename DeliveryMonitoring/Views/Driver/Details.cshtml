@model DeliveryMonitoring.Models.DriverDetailsViewModel

@{
    ViewData["Title"] = "Details";
}


<div class="container-fluid pt-5">
    
    
    <div class="row">
        <div class="col-12 col-md-5">
            <h4>Driver Details</h4>
            <hr />
            <div class="row">
                
                    <!--First Name Beginning-->
                    <dt class="col-sm-5">
                        @Html.DisplayNameFor(model => model.Drivers.firstName)
                    </dt>
                    <dd class="col-sm-7">
                        @Model.Drivers.firstName
                    </dd>
                    <!--First Name Ending-->
                    <!--Last Updated at Beginning-->
                    <dt class="col-sm-5">
                        @Html.DisplayNameFor(model => model.Drivers.lastUpdatedAt)
                    </dt>
                    <dd class="col-sm-7">
                        @{
                            long unixtimestamp = Model.Drivers.lastUpdatedAt;
                        }
                        @DateTimeOffset.FromUnixTimeMilliseconds(unixtimestamp).DateTime.ToString("yyyy-MM-dd HH:mm:ss")
                    </dd>
                    <!--Last Updated at Ending-->
                    <!--Phone Number Beginning-->
                    <dt class="col-sm-5">
                        @Html.DisplayNameFor(model => model.Drivers.phoneNumber)
                    </dt>
                    <dd class="col-sm-7">
                        @Html.DisplayFor(model => model.Drivers.phoneNumber)
                    </dd>
                    <!--Phone Number Ending-->
                    <!--Driver Status Beginning-->
                    <dt class="col-sm-5">
                        @Html.DisplayNameFor(model => model.Drivers.status)
                    </dt>
                    <dd class="col-sm-7">
                        @Html.DisplayFor(model => model.Drivers.status)
                    </dd>
                    <!--Driver Status Ending-->
                    <a data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
                        Additional Info
                    </a>
            </div>
                

                <div class="collapse pt-3 row" id="collapseExample">
                    <div class="card card-body">
                        <dl>
                        <dt class="col-sm-5">
                            @Html.DisplayNameFor(model => model.Drivers.companyTin)
                        </dt>
                        <dd class="col-sm-7">
                            @Html.DisplayFor(model => model.Drivers.companyTin)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.Drivers.deviceID)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.Drivers.deviceID)
                        </dd>
                        </dl>
                        
                    </div>
                </div>
            
            

            <div class="pt-3 pb-3">
                <a class="btn btn-outline-dark" asp-action="Index">Back to List</a>
            </div>

        </div>
        <div class="col-12 col-md-7" id="map">

        </div>
        
    </div>

    

    <!--Map JavaScript Implementation Starts Here-->
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDihZpSLFD2uyptHT-UQDSfJm9BKHRK-VU&callback=initMap&libraries=places,geometry&v=weekly" defer>
    </script>

    <script>

        function initMap() {
            // Initialize an array to hold live location
            let index = 0;
            var bearing = 0;
            const places = [];

            const map = new google.maps.Map(document.getElementById("map"), {
                zoom: 20,
                mapTypeId: google.maps.MapTypeId.ROADMAP
            });
            //initializes the map with specified parameters - ends here

            //google map's direction service to draw the line in real road setting
            var directionsService = new google.maps.DirectionsService();
            var directionsRenderer = new google.maps.DirectionsRenderer();
            directionsRenderer.setMap(map);
            //google map's direction service to draw the line in real road setting ends here

            //this takes all the information from the api response and save it in a places array
        @{
            if (Model != null)
            {
                foreach (var item in Model.Orders)
                {
                    if (@item.assignedDriverPhoneNumber == @Model.Drivers.phoneNumber)
                    {
                                        <text>
                                            places.push({   
                                                Name: '@Model.Drivers.firstName',
                                                LastUpdatedAt: '@DateTimeOffset.FromUnixTimeMilliseconds(Model.Drivers.lastUpdatedAt).DateTime.ToString("yyyy-MM-dd HH:mm:ss")', 
                                                Phone: '@Model.Drivers.phoneNumber', 
                                                Status: '@Model.Drivers.status', 
                                                lat: @Model.Drivers.latLng.lat, 
                                                lng: @Model.Drivers.latLng.lng, 
                                                DestLat: @item.customer.latLng.lat, 
                                                DestLng: @item.customer.latLng.lng});
                                        </text>
                    }
                    else
                    {
                                        <text>
                                            places.push({ 
                                                Name: '@Model.Drivers.firstName', 
                                                LastUpdatedAt: '@DateTimeOffset.FromUnixTimeMilliseconds(Model.Drivers.lastUpdatedAt).DateTime.ToString("yyyy-MM-dd HH:mm:ss")', 
                                                Phone: '@Model.Drivers.phoneNumber', 
                                                Status: '@Model.Drivers.status', 
                                                lat: @Model.Drivers.latLng.lat, 
                                                lng: @Model.Drivers.latLng.lng});
                                        </text>
                    }

                }
            }
        }
                    //this takes all the information from the api response and save it in a places array - ends here

                    //sets the marker in the specified position
                                        var marker;
                                        var i = 0;
            
                marker = new google.maps.Marker({
                    position: { lat: places[0].lat, lng: places[0].lng },
                    title: places[i].Name,
                    map: map,
                    icon: {
                        path: google.maps.SymbolPath.FORWARD_CLOSED_ARROW,
                        scale: 4,

                    },

                });

                map.setCenter(marker.getPosition());
                //sets the marker in the specified position - ends here

                //content for each driver starts here
                var content = "<b>Name:</b> " + places[i].Name + "<br/><b>LastUpdatedAt:</b> " + places[i].LastUpdatedAt + "<br/><b>Phone:</b> " + places[i].Phone + "<br/><b>Status:</b> " + places[i].Status

                var infowindow = new google.maps.InfoWindow()

                google.maps.event.addListener(marker, 'mouseover', (function (marker, content, infowindow) {
                    return function () {
                        infowindow.setContent(content);
                        infowindow.open(map, marker);
                    };
                })(marker, content, infowindow));

                google.maps.event.addListener(marker, 'mouseout', (function (infowindow) {
                    return function () {
                        infowindow.close();
                    };
                })(infowindow));
                ////content for each driver ends here
            let liveLocation = [places[0].lat, places[0].lng];
            //this one moves the driver if status is delivering
            if (places[0].Status == "delivering") {
                
                var beginPosition = new google.maps.LatLng(places[0].lat, places[0].lng);
                var destinationPosition = new google.maps.LatLng(places[0].DestLat, places[0].DestLng);

                // Update the directions request
                var request = {
                    origin: beginPosition,
                    destination: destinationPosition,
                    travelMode: google.maps.TravelMode.DRIVING
                };

                directionsService.route(request, function (result, status) {
                    if (status == google.maps.DirectionsStatus.OK) {
                        directionsRenderer.setDirections(result);
                        
                        // Set an interval to fetch the updated location from the API and call moveCar
                        var apiResponseInterval = setInterval(function () {
                            
                            console.log('Live Location Before:', liveLocation[0], liveLocation[1]);
                            if (liveLocation.length > 0) {
                                
                                liveLocation.pop();
                                liveLocation.pop();
                            }
                            // Fetch the updated location from the API
                            fetch(`/Driver/LiveLocation/${places[0].Phone}`)
                                .then(response => response.json())
                                .then(data => {
                                    console.log('API Response:', data);
                                    // Update live location array with new data
                                    //if (data && data.latLng && data.latLng.lat !== undefined && data.latLng.lng !== undefined) {
                                        // Update live location array with new data
                                    //liveLocation.push(data.latLng.lat);
                                    //liveLocation.push(data.latLng.lat);
                                    
                                    if (index === 0) 
                                    { 
                                        liveLocation.push(9.0147);
                                        liveLocation.push(38.76265);
                                    }
                                    if (index === 1) {
                                        liveLocation.push(9.01394);
                                        liveLocation.push(38.76294);

                                    }
                                    if (index === 2) {
                                        liveLocation.push(9.01191);
                                        liveLocation.push(38.76275);

                                    }
                                    if (index === 3) {
                                        liveLocation.push(9.01123);
                                        liveLocation.push(38.76264);

                                    }
                                    if (index === 4) {
                                        liveLocation.push(9.01123);
                                        liveLocation.push(38.76264);

                                    }
                                    
                                    
                                    console.log('marker inside fetch:', marker.getPosition().lat(), marker.getPosition().lng());
                                    console.log('Live Location After:', liveLocation[0], liveLocation[1]);
                                    //}
                               
                                    moveCar();

                                    if (marker.getPosition().lat() == destinationPosition.lat() && marker.getPosition().lng() == destinationPosition.lng() || data.status !== "offline") {
                                        clearInterval(apiResponseInterval);
                                        directionsRenderer.setMap(null); // Hide the directions
                                        //marker.setPosition(destinationPosition)
                                        //marker.setIcon({
                                        //path: google.maps.SymbolPath.FORWARD_CLOSED_ARROW,
                                        //scale: 4,
                                        //rotation: bearing,
                                        //});
                                        map.setCenter(marker.getPosition());
                                        console.log('marker inside last stop:', marker.getPosition().lat(), marker.getPosition().lng());
                                    }
                                })
                                .catch(error => console.error('Error fetching live location:', error, error.responseText));
                           
                            
                        }, 8000); // Adjust the interval time as needed

                    } else {
                        console.error('Initial directions request failed with status:', status);
                    }
                });

                function moveCar() {
                    
                    index++;
                            // Check if the driver's location has changed
                    if (liveLocation[0] !== marker.getPosition().lat() || liveLocation[1] !== marker.getPosition().lng()) {

                        var liveLatLng = new google.maps.LatLng(liveLocation[0], liveLocation[1]);
                        // Calculate the bearing between the previous location and the current location
                        bearing = google.maps.geometry.spherical.computeHeading(marker.getPosition(), liveLatLng);

                        // Calculate the step size for interpolation
                        var numSteps = 100;
                        var step = 0;


                        // Use setInterval for interpolation and smooth sliding
                        var interval = setInterval(function () {
                            step += 1;

                            // Calculate the interpolated position
                            var interpolatedPosition = google.maps.geometry.spherical.interpolate(marker.getPosition(), liveLatLng, step / numSteps);

                            // Set the marker position
                            marker.setPosition(interpolatedPosition);

                            // Set the marker icon with rotation
                            marker.setIcon({
                                path: google.maps.SymbolPath.FORWARD_CLOSED_ARROW,
                                scale: 4,
                                rotation: bearing,
                            });

                            // Check if reached the final position
                            if (step == numSteps) {
                                clearInterval(interval);
                                marker.setPosition(liveLatLng);
                            }
                        }, 70);
                    }
                }
            }
            //this one moves the driver if status is delivering - ends here


        }

    </script>
</div>

