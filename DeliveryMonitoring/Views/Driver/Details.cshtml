@model DeliveryMonitoring.Models.Driver

@{
    ViewData["Title"] = "Details";
}


<div class="container-fluid pt-5">
    
    
    <div class="row">
        <div class="col-12 col-md-5">
            <h4>Driver Details</h4>
            <hr />
            <div class="row">
                
                    <!--First Name Beginning-->
                    <dt class="col-sm-5">
                        @Html.DisplayNameFor(model => model.firstName)
                    </dt>
                    <dd class="col-sm-7">
                        @Html.DisplayFor(model => model.firstName)
                    </dd>
                    <!--First Name Ending-->
                    <!--Last Updated at Beginning-->
                    <dt class="col-sm-5">
                        @Html.DisplayNameFor(model => model.lastUpdatedAt)
                    </dt>
                    <dd class="col-sm-7">
                        @{
                            long unixtimestamp = Model.lastUpdatedAt;
                        }
                        @DateTimeOffset.FromUnixTimeMilliseconds(unixtimestamp).DateTime.ToString("yyyy-MM-dd HH:mm:ss")
                    </dd>
                    <!--Last Updated at Ending-->
                    <!--Phone Number Beginning-->
                    <dt class="col-sm-5">
                        @Html.DisplayNameFor(model => model.phoneNumber)
                    </dt>
                    <dd class="col-sm-7">
                        @Html.DisplayFor(model => model.phoneNumber)
                    </dd>
                    <!--Phone Number Ending-->
                    <!--Driver Status Beginning-->
                    <dt class="col-sm-5">
                        @Html.DisplayNameFor(model => model.status)
                    </dt>
                    <dd class="col-sm-7">
                        @Html.DisplayFor(model => model.status)
                    </dd>
                    <!--Driver Status Ending-->
                    <!--Address Beginning-->
                    @{
                        double latitude = Model.latLng.lat;
                        double longtiude = Model.latLng.lng;
                            @*yet to be implemented*@
                    }
                    <!--Address Ending-->
                    <a data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
                        Additional Info
                    </a>
            </div>
                

                <div class="collapse pt-3 row" id="collapseExample">
                    <div class="card card-body">
                        <dl>
                        <dt class="col-sm-5">
                            @Html.DisplayNameFor(model => model.companyTin)
                        </dt>
                        <dd class="col-sm-7">
                            @Html.DisplayFor(model => model.companyTin)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.deviceID)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.deviceID)
                        </dd>
                        </dl>
                        
                    </div>
                </div>
            
            

            <div class="pt-3 pb-3">
                <a class="btn btn-outline-dark" asp-action="Index">Back to List</a>
            </div>
        </div>
        <div class="col-12 col-md-7" id="map">

        </div>
        
    </div>

    

    <!--Map JavaScript Implementation Starts Here-->
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDihZpSLFD2uyptHT-UQDSfJm9BKHRK-VU&callback=initMap&libraries=places,geometry&v=weekly" defer>
    </script>

    <script>
        //the coordinates the motor moves starts here
        const coordinates = [
            [9.01664, 38.76288],
            [9.0147, 38.76265],
            [9.01394, 38.76294],
            [9.01191, 38.76275],
            [9.01123, 38.76264],
            [9.01103, 38.76267],
            [9.01083, 38.76275],
            [9.01074, 38.76367],
            [9.01051, 38.76633],
            [9.01032, 38.7682],
            [9.01003, 38.7712],
            [9.01002, 38.7722],
            [9.01013, 38.77301],
            [9.01085, 38.77477],
            [9.0118, 38.77658],
            [9.01408, 38.78115],
            [9.01481, 38.78347],
            [9.01541, 38.78597],
            [9.01722, 38.79408],
            [9.01811, 38.79689],
            [9.01811, 38.79689],
          
        ];
        //the coordinates the motor moves ends here
        function initMap() {

            //initializes the map with specified parameters
            const map = new google.maps.Map(document.getElementById("map"), {
                zoom: 22,
                mapTypeId: google.maps.MapTypeId.ROADMAP
            });
            //initializes the map with specified parameters - ends here

            //google map's direction service to draw the line in real road setting
            var directionsService = new google.maps.DirectionsService();
            var directionsRenderer = new google.maps.DirectionsRenderer();
            directionsRenderer.setMap(map);
            //google map's direction service to draw the line in real road setting ends here
        
            //this takes all the information from the api response and save it in a places array
        @{
            if (Model != null)
            {
                    <text>
                        const places = [{ Name: '@Model.firstName', LastUpdatedAt: '@DateTimeOffset.FromUnixTimeMilliseconds(Model.lastUpdatedAt).DateTime.ToString("yyyy-MM-dd HH:mm:ss")', Phone: '@Model.phoneNumber', Status: '@Model.status', lat: @Model.latLng.lat, lng: @Model.latLng.lng},];
                    </text>
            }
        }
            //this takes all the information from the api response and save it in a places array - ends here

            //sets the marker in the specified position
                                var marker, i;
            for (i = 0; i < places.length; i++) {
                var marker = new google.maps.Marker({
                    position: { lat: coordinates[0][0], lng: coordinates[0][1] },
                    title: places[i].Name,
                    map: map,
                    icon: {
                        path: google.maps.SymbolPath.FORWARD_CLOSED_ARROW,
                        scale: 4,
                        //url: '/images/motor2.svg'
                        //rotation: bearing,
                        //url: '/images/motor.png', // Specify your custom icon URL
                        //scaledSize: new google.maps.Size(32, 32), // Adjust the size as needed
                        //anchor: new google.maps.Point(16, 16), // Center the anchor point
                    },

                });

                map.setCenter(marker.getPosition());
                //sets the marker in the specified position - ends here

                //content for each driver starts here
                var content = "<b>Name:</b> " + places[i].Name + "<br/><b>LastUpdatedAt:</b> " + places[i].LastUpdatedAt + "<br/><b>Phone:</b> " + places[i].Phone + "<br/><b>Status:</b> " + places[i].Status

                var infowindow = new google.maps.InfoWindow()

                google.maps.event.addListener(marker, 'mouseover', (function (marker, content, infowindow) {
                    return function () {
                        infowindow.setContent(content);
                        infowindow.open(map, marker);
                    };
                })(marker, content, infowindow));

                google.maps.event.addListener(marker, 'mouseout', (function (infowindow) {
                    return function () {
                        infowindow.close();
                    };
                })(infowindow));
                ////content for each driver ends here
            }

            var index = 0; // Index to keep track of the current coordinate
            var destinationLat = coordinates[coordinates.length - 1][0]; // Example latitude
            var destinationLng = coordinates[coordinates.length - 1][1]; // Example longitude
            //var marker;

            function moveCar() {
                // Update the car's position
                if (index < coordinates.length - 1) {
                    index++;
                } else {
                    // Car has reached the final destination, clear the interval
                    clearInterval(intervalId);
                    return;
                }

                var startPosition = new google.maps.LatLng(coordinates[index - 1][0], coordinates[index - 1][1]);
                var endPosition = new google.maps.LatLng(coordinates[index][0], coordinates[index][1]);
                console.log('startPosition:', startPosition);
                console.log('endPosition:', endPosition);
                // Calculate the step size for interpolation
                var numSteps = 100; // You can adjust the number of steps for smoother movement
                var step = 0;
                
                // Update the directions request
                var request = {
                    origin: startPosition,
                    destination: new google.maps.LatLng(destinationLat, destinationLng),
                    travelMode: google.maps.TravelMode.DRIVING
                };
                
                directionsService.route(request, function (result, status) {
                    if (status == google.maps.DirectionsStatus.OK) {
                        directionsRenderer.setDirections(result);

                        // Get the overview path of the route
                        var path = result.routes[0].overview_path;
                        console.log('path:', path.length);
                        // Check if the path is not empty
                        if (path && path.length > 1) {
                            // Compute the bearing (rotation angle) between consecutive points
                            var bearing = google.maps.geometry.spherical.computeHeading(path[0], path[1]);
                            console.log('bearing:', bearing);
                            // Use setInterval for interpolation and smooth sliding
                            var interval = setInterval(function () {
                                step += 1;

                                // Calculate the interpolated position
                                var interpolatedPosition = google.maps.geometry.spherical.interpolate(startPosition, endPosition, step / numSteps);

                                // Set the marker position
                                marker.setPosition(interpolatedPosition);
                                // Set the marker icon with rotation
                                marker.setIcon({
                                    path: google.maps.SymbolPath.FORWARD_CLOSED_ARROW,
                                    scale: 4,
                                    //url: '/images/motor2.svg'
                                    rotation: bearing,
                                });

                                // Check if reached the final position
                                if (step == numSteps) {
                                    clearInterval(interval);
                                }
                            }, 20); // You can adjust the interval time for smoother movement
                        }
                    } else {
                        console.error('Directions request failed with status:', status);
                    }
                });
            }

            // Set a lower interval time for smoother movement
            var intervalId = setInterval(moveCar, 2000);


        }
        
    </script>
</div>

