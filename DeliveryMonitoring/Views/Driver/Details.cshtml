@using System.Text
@model DeliveryMonitoring.Models.Driver
@{
    ViewData["Title"] = "Driver Details";
    var Orders = ViewData["Orders"] as List<OrderDetail>;

    double totalRating = Model?.review?.totalRating ?? 0.0;
    double totalReviews = Model?.review?.totalReviews ?? 0;
    double rating = totalRating / totalReviews;

    string GetStarRating(double rating)
    {
        int fullStars = (int)rating;
        bool hasHalfStar = rating - fullStars >= 0.5;
        StringBuilder stars = new StringBuilder();
        for (int i = 1; i <= 5; i++)
        {
            if (i <= fullStars)
            {
                stars.Append("<i class='bi bi-star-fill'></i>"); // Assuming you're using Bootstrap Icons
            }
            else if (i == fullStars + 1 && hasHalfStar)
            {
                stars.Append("<i class='bi bi-star-half'></i>");
            }
            else
            {
                stars.Append("<i class='bi bi-star'></i>");
            }
        }
        return stars.ToString();
    }
}

<!-- Add this line to include the custom CSS -->
<link rel="stylesheet" href="~/css/driverDetail.css" />

<div class="container-fluid">

    <!--Find the map here-->
    <div class="col-12 col-md-12" id="map">
    </div>
    <!--Map ends here-->

    <div class="container-fluid col-11 col-lg-7 pt-3">
        <div class="card border-1" id="orderCard">
            <div class="row pt-3" id="orderDetail">
                <div class="col-4">
                    <h4><i class="bi bi-car-front icon"></i>Driver</h4>
                </div>
                
                <div class="col-8 d-flex justify-content-center gap-2">
                    <div>
                        <a class="btn btn-success" href="/updatedriverinfo/@Model?.phoneNumber">
                            <i class="bi bi-pencil-square"></i>&nbsp;Update Driver Info
                        </a>
                    </div>
                    <div>
                        <a class="btn btn-primary" href="/review/@Model?.phoneNumber">
                            <i class="bi bi-chat-left-text"></i>&nbsp;Reviews
                        </a>
                    </div>
                </div>
            </div>

            <div class="row" id="orderDetail">               
                <div class="col-6">
                    <img src="@Model?.detail?.profilePicture" alt="" class="half-size-img">
                </div>
                <div class="col-6">
                    <span id="letters">Name: </span>
                    <span id="outputs">@Model?.firstName</span>
                    <a id="outputs">
                        @{
                            var statusColors = new Dictionary<string, string>
                                {
                                    { "offline", "red" },
                                    { "ready", "orange" },
                                    { "accepted", "yellow" },
                                    { "delivering", "deepskyblue" },
                                    { "completed", "lawngreen" }
                                };

                            if (Model?.status != null && statusColors.ContainsKey(Model.status))
                            {
                                <div style="background-color: @statusColors[Model.status]; border-radius: 20px; color: black; display: inline-block; padding: 5px 5px;">
                                    @Html.DisplayFor(model => model.status)
                                </div>
                            }
                        }
                    </a>
                    @{
                        foreach (var item in (Orders ?? new List<OrderDetail>()).Where(o => o.AssignedDriverPhoneNumber == @Model?.phoneNumber))
                        {
                            var voucher = item.VoucherCode;
                            <a class=""href="/order/@voucher" style="margin-left: 0px; text-decoration: none;">- Order Details</a>
                        }
                    }

                    <div>
                        <span id="letters">Last updated at: </span>
                        <span id="outputs">
                            @DateTimeOffset.FromUnixTimeMilliseconds(Model?.lastUpdatedAt ?? new long()).ToOffset(TimeSpan.FromHours(3)).DateTime.ToString("yyyy-MM-dd hh:mm:ss")
                        </span>
                    </div>
                    <div>
                        <span id="letters">@Html.DisplayNameFor(model => model.companyTin):</span>
                        <span id="outputs"><a href="/company/@Model?.companyTin">@Html.DisplayFor(model => model.companyTin)</a></span>
                    </div>
                    <div>
                        <span id="letters">Phone Number:</span>
                        <span id="outputs">
                            <a href="tel:@Model?.phoneNumber">@Model?.phoneNumber</a>
                        </span>
                    </div>
                    <div>
                        <span id="letters">Plate Number:</span>
                        <span id="outputs">@(Model?.detail?.plateNumber ?? "N/A")</span>
                    </div>
                    <div>
                        <span id="letters">Email: </span>
                        @if (!string.IsNullOrEmpty(Model?.detail?.email))
                        {
                            <a id="outputs" href="mailto:@@Model.detail.email">@Model.detail.email</a>
                        }
                        else
                        {
                            <span>N/A</span>
                        }
                    </div>
                    <div>
                        <span id="letters">Gender: </span>
                        <a id="outputs">@(Model?.detail?.gender ?? "N/A")</a>
                    </div>
                    <div>
                        <span id="letters">Number Of Accepted Orders:</span>
                        <span id="outputs">@(Model?.numberOfAcceptedOrders.ToString() ?? "N/A")</span>
                    </div>
                    <div>
                        <span id="letters">Number Of Rejected Orders:</span>
                        @if (!string.IsNullOrEmpty(Model?.numberOfRejectedOrders.ToString()))
                        {
                            <span id="outputs">@Model?.numberOfRejectedOrders.ToString()</span>
                        }
                        else
                        {
                            <span id="outputs">N/A</span>
                        }
                    </div>
                    <div>
                        <span id="letters">Traveled Distance:</span>
                        <span id="outputs">@(Model?.traveledDistance != null ? Model?.traveledDistance + " km" : "N/A")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        fetch('/Map/GetMapData')
            .then(response => response.text())
            .then(script => {
                // Execute the received script
                eval(script);
            })
            .catch(error => console.error('Error loading Google Maps API:', error));
    </script>

    <script>
        function initMap() {
            var map;
            var orderAssigned = false;
            var marker;
            var marker2;
            var i = 0;
            var bearing = 0;
            var places = [];
            map = new google.maps.Map(document.getElementById("map"), {
                zoom: 16,
                mapTypeId: google.maps.MapTypeId.ROADMAP
            });
            //initializes the map with specified parameters - ends here

            //google map's direction service to draw the line in real road setting
            var directionsService = new google.maps.DirectionsService();
            var directionsRenderer = new google.maps.DirectionsRenderer();
            directionsRenderer.setMap(map);

            details();

            //google map's direction service to draw the line in real road setting ends here
            function details() {
                // let index = 0;
                //this takes all the information from the api response and save it in a places array
                @{
                    if (Model != null)
                    {
                        <text>
                                    places =[{
                                        Name: '@Model.firstName',
                                        LastUpdatedAt: '@DateTimeOffset.FromUnixTimeMilliseconds(Model.lastUpdatedAt).DateTime.ToString("yyyy-MM-dd HH:mm:ss")',
                                        Phone: '@Model.phoneNumber',
                                        Status: '@Model.status',
                                        lat: @Model?.latLng?.Lat,
                                        lng: @Model?.latLng?.Lng}];
                        </text>
                        if (Orders != null)
                        {
                            foreach (var item in Orders ?? new List<OrderDetail>())
                            {
                                if (item.AssignedDriverPhoneNumber == Model?.phoneNumber)
                                {
                                    <text>
                                        places = [{
                                            Name: '@Model?.firstName',
                                            LastUpdatedAt: '@DateTimeOffset.FromUnixTimeMilliseconds(Model.lastUpdatedAt).DateTime.ToString("yyyy-MM-dd HH:mm:ss")',
                                            Phone: '@Model?.phoneNumber',
                                            Status: '@Model?.status',
                                            lat: @Model?.latLng?.Lat,
                                            lng: @Model?.latLng?.Lng,
                                            DestLat: @(item?.Customer?.LatLng?.Lat ?? 0.0),
                                            DestLng: @(item?.Customer?.LatLng?.Lng ?? 0.0)
                                        }];
                                    </text>
                                }
                            }
                        }
                    }
                }
                marker = new google.maps.Marker({
                    position: { lat: places[0].lat, lng: places[0].lng },
                    title: places[i].Name,
                    map: map,
                    icon: {
                        path: google.maps.SymbolPath.FORWARD_CLOSED_ARROW,
                        scale: 4,
                    },
                });

                map.setCenter(marker.getPosition());
                //sets the marker in the specified position - ends here

                //content for each driver starts here
                var content = "<b>Name:</b> " + places[i].Name + "<br/><b>LastUpdatedAt:</b> " + places[i].LastUpdatedAt + "<br/><b>Phone:</b> " + places[i].Phone + "<br/><b>Status:</b> " + places[i].Status

                var infowindow = new google.maps.InfoWindow()

                google.maps.event.addListener(marker, 'mouseover', (function (marker, content, infowindow) {
                    return function () {
                        infowindow.setContent(content);
                        infowindow.open(map, marker);
                    };
                })(marker, content, infowindow));

                google.maps.event.addListener(marker, 'mouseout', (function (infowindow) {
                    return function () {
                        infowindow.close();
                    };
                })(infowindow));
                ////content for each driver ends here

                var liveLocation = [places[0].lat, places[0].lng];

                //this one moves the driver if status is delivering
                if (orderAssigned) {
                    marker2 = new google.maps.Marker({
                        position: { lat: places[0].DestLat, lng: places[0].DestLng },
                        title: 'Order Destination',
                        map: map,
                        icon: {
                            url: '/images/Destination.png',
                            scaledSize: new google.maps.Size(48, 48)
                        },
                    });

                    var beginPosition = new google.maps.LatLng(places[0].lat, places[0].lng);
                    var destinationPosition = new google.maps.LatLng(places[0].DestLat, places[0].DestLng);

                    // Update the directions request
                    var request = {
                        origin: beginPosition,
                        destination: destinationPosition,
                        travelMode: google.maps.TravelMode.DRIVING
                    };

                    directionsService.route(request, function (result, status) {
                        if (status == google.maps.DirectionsStatus.OK) {
                            directionsRenderer.setDirections(result);

                            // Set an interval to fetch the updated location from the API and call moveCar
                            var apiResponseInterval = setInterval(function () {

                                if (liveLocation.length > 0) {

                                    liveLocation.pop();
                                    liveLocation.pop();
                                }
                                // Fetch the updated location from the API
                                fetch(`/Driver/LiveLocation/${places[0].Phone}`)
                                    .then(response => response.json())
                                    .then(data => {

                                        if (data.latLng.lat !== undefined && data.latLng.lng !== undefined) {
                                            liveLocation.push(data.latLng.lat);
                                            liveLocation.push(data.latLng.lng);
                                        }

                                        moveCar();

                                        if (marker.getPosition().lat() == destinationPosition.lat() && marker.getPosition().lng() == destinationPosition.lng() || data.status === "completed") {
                                            clearInterval(apiResponseInterval);
                                            marker2.setMap(null);
                                            marker.setMap(null);
                                            directionsRenderer.setMap(null); // Hide the directions
                                            details();
                                        }
                                    })
                                    .catch(error => console.error('Error fetching live location:', error, error.responseText));


                            }, 10000); // Adjust the interval time as needed

                        } else {
                            // Set an interval to fetch the updated location from the API and call moveCar
                            var apiResponse = setInterval(function () {
                                if (liveLocation.length > 0) {
                                    liveLocation.pop();
                                    liveLocation.pop();
                                }
                                // Fetch the updated location from the API
                                fetch(`/Driver/LiveLocation/${places[0].Phone}`)
                                    .then(response => response.json())
                                    .then(data => {
                                        // console.log(data)
                                        if (data.latLng.lat !== undefined && data.latLng.lng !== undefined) {
                                            liveLocation.push(data.latLng.lat);
                                            liveLocation.push(data.latLng.lng);
                                        }

                                        // if (index === 0) {
                                        //     liveLocation.push(9.0147);
                                        //     liveLocation.push(38.76265);
                                        // }
                                        // if (index === 1) {
                                        //     liveLocation.push(9.01394);
                                        //     liveLocation.push(38.76294);
                                        // }
                                        // if (index === 2) {
                                        //     liveLocation.push(9.01191);
                                        //     liveLocation.push(38.76275);
                                        // }
                                        // if (index === 3) {
                                        //     liveLocation.push(9.01123);
                                        //     liveLocation.push(38.76264);
                                        // }

                                        moveCar();

                                        if (marker.getPosition().lat() == destinationPosition.lat() && marker.getPosition().lng() == destinationPosition.lng() || data.status === "completed") {
                                            clearInterval(apiResponse);
                                            marker2.setMap(null);
                                            marker.setMap(null);
                                            details();
                                        }
                                    })
                                    .catch(error => console.error('Error fetching live location:', error, error.responseText));
                            }, 10000); // Adjust the interval time as needed
                        }
                    });
                }
                //this one moves the driver if order is assigned - ends here
                else {
                    // Set an interval to fetch the updated location from the API and call moveCar
                    var AR = setInterval(function () {
                        if (liveLocation.length > 0) {
                            liveLocation.pop();
                            liveLocation.pop();
                        }
                        // Fetch the updated location from the API
                        fetch(`/Driver/LiveLocation/${places[0].Phone}`)
                            .then(response => response.json())
                            .then(data => {
                                // console.log(data)
                                if (data.latLng.lat !== undefined && data.latLng.lng !== undefined) {
                                    liveLocation.push(data.latLng.lat);
                                    liveLocation.push(data.latLng.lng);
                                }

                                moveCar();

                                if (data.status === "delivering") {
                                    clearInterval(AR);
                                    marker.setMap(null);
                                    details();
                                }
                            })
                            .catch(error => console.error('Error fetching live location:', error, error.responseText));
                    }, 10000); // Adjust the interval time as needed
                }
                function moveCar() {
                    // index++;
                    // Check if the driver's location has changed
                    if (liveLocation.length > 0 && (liveLocation[0] !== marker.getPosition().lat() || liveLocation[1] !== marker.getPosition().lng())) {

                        var liveLatLng = new google.maps.LatLng(liveLocation[0], liveLocation[1]);
                        // Calculate the bearing between the previous location and the current location
                        bearing = google.maps.geometry.spherical.computeHeading(marker.getPosition(), liveLatLng);

                        // Calculate the step size for interpolation
                        var numSteps = 100;
                        var step = 0;

                        // Use setInterval for interpolation and smooth sliding
                        var interval = setInterval(function () {
                            step += 1;

                            // Calculate the interpolated position
                            var interpolatedPosition = google.maps.geometry.spherical.interpolate(marker.getPosition(), liveLatLng, step / numSteps);

                            // Set the marker position
                            marker.setPosition(interpolatedPosition);

                            // Set the marker icon with rotation
                            marker.setIcon({
                                path: google.maps.SymbolPath.FORWARD_CLOSED_ARROW,
                                scale: 4,
                                rotation: bearing,
                            });

                            // Check if reached the final position
                            if (step == numSteps) {
                                clearInterval(interval);
                                marker.setPosition(liveLatLng);
                                map.setCenter(marker.getPosition());
                            }
                        }, 70);
                    }
                }
            }
        }
    </script>
</div>

