@model DeliveryMonitoring.Models.UpdateDriverModel

@{
    ViewData["Title"] = "Update";
}

<div class="container-fluid col-10 col-md-7">
    <div class="row pt-5">
        

        <div class="card">
            <div class="col-10" style="margin-left: 30px;">
                <br /><br />
                <h3>Update Driver</h3>
                <form id="myForm" method="patch" action="@Url.Action("Update", "Driver", new { phoneNumber = Model.phoneNumber })">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="companyTin" class="control-label"></label>
                        <input asp-for="companyTin" class="form-control" pattern="^[0-9]*$" title="Company TIN must contain only numbers." required />
                        <span asp-validation-for="companyTin" class="text-danger"></span>
                    </div>
                    <br />

                    <div class="form-group">
                        <label asp-for="firstName" class="control-label"></label>
                        <input asp-for="firstName" class="form-control" required />
                        <span asp-validation-for="firstName" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="form-group">
                        <label asp-for="phoneNumber" class="control-label"></label>
                        <input asp-for="phoneNumber" class="form-control" readonly />
                        <span asp-validation-for="phoneNumber" class="text-danger"></span>
                    </div>
                    <br />


                    <div class="form">
                        <label asp-for="isDisabled" class="control-label"></label>
                        <br />
                        <input type="radio" id="enableRadio" name="isDisabled" value="false" @(Model != null && !Model.isDisabled ? "checked" : "")>
                        <label for="isDisabled">Enable&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</label>
                        <input type="radio" id="disableRadio" name="isDisabled" value="true" @(Model != null && Model.isDisabled ? "checked" : "")>
                        <label for="isDisabled">Disable</label>
                    </div>
                    <br />

                    <div class="row">
                        <div class="col-5">
                            <a class="btn btn-danger" asp-controller="Driver" asp-action="Details" asp-route-id="@Model.phoneNumber">Back</a>
                        </div>

                        <div class="form-group col-5">
                            <button id="saveButton" type="button" class="btn btn-primary"><i class="bi bi-floppy"></i>&nbsp;&nbsp;Save</button>
                        </div>
                    </div>


                </form>
                <br /><br /><br /><br />
            </div>
        </div>
        
    </div>


</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
<script src="https://ajax.aspnetcdn.com/ajax/jquery/jquery-3.6.0.min.js"></script>
<script src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.17.0/jquery.validate.min.js"></script>
<script src="https://ajax.aspnetcdn.com/ajax/mvc/5.2.3/jquery.validate.unobtrusive.min.js"></script>

<script>
    document.getElementById("saveButton").addEventListener("click", function () {

        // Get form data and convert it to JSON
        var formData = {
            companyTin: document.getElementById("companyTin").value,
            firstName: document.getElementById("firstName").value,
            phoneNumber: document.getElementById("phoneNumber").value,
            isDisabled: document.querySelector('input[name="isDisabled"]:checked').value === "true"
        };

        // Send a PATCH request using fetch API
        fetch('@Url.Action("Update", "Driver", new { phoneNumber = Model.phoneNumber })', {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(formData)
        }).then(function (response) {
            //if (response.ok) {
                //Successfully updated, redirect to details page
                window.location.href = '@Url.Action("Index", "Driver")';
                //} else if (response.status === 404) {
                // Return a 404 Not Found response if no driver is found.
                //console.log('Not Found');
            //}
        }).catch(function (error) {
            // Handle fetch error
            console.error('Fetch Error:', error);
        });
    });
</script>