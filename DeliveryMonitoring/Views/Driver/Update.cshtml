@model DeliveryMonitoring.Models.UpdateDriverModel

@{
    ViewData["Title"] = "Update Driver Info";
}

<div class="container-fluid col-10 col-lg-6">
    <div class="row pt-5">
        

        <div class="card">
            <div class="col-10" style="margin-left: 30px;">
                <br /><br />
                <h3>Update Driver Info</h3>
                <br/>
                <form id="myForm" method="post" action="@Url.Action("Update", "Driver", new { phoneNumber = Model.phoneNumber })">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="companyTin" class="control-label">Company TIN *</label>
                        <input asp-for="companyTin" class="form-control" id="companyTin" pattern="^[0-9]*$" title="Company TIN must contain only numbers." required />
                        <span asp-validation-for="companyTin" class="text-danger"></span>
                    </div>
                    <br />

                    <div class="form-group">
                        <label asp-for="firstName" class="control-label">Name *</label>
                        <input asp-for="firstName" class="form-control" id="firstName" required />
                        <span asp-validation-for="firstName" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="form-group">
                        <label asp-for="phoneNumber" class="control-label"></label>
                        <input asp-for="phoneNumber" class="form-control" id="phoneNumber" readonly />
                        <span asp-validation-for="phoneNumber" class="text-danger"></span>
                    </div>
                    <br />


                    <div class="form">
                        <label asp-for="isDisabled" class="control-label"></label>
                        <br />
                        <input type="radio" id="enableRadio" name="isDisabled" value="false" @(Model != null && !Model.isDisabled ? "checked" : "")>
                        <label for="isDisabled">Enable&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</label>
                        <input type="radio" id="disableRadio" name="isDisabled" value="true" @(Model != null && Model.isDisabled ? "checked" : "")>
                        <label for="isDisabled">Disable</label>
                    </div>
                    <br />

                    <div class="row">
                        <div class="col-5">
                            <a class="btn btn-danger" href="/driverdetail/@Model?.phoneNumber" >Back</a>
                        </div>

                        <div class="form-group col-5">
                            <button id="saveButton" type="button" class="btn btn-primary"><i class="bi bi-floppy"></i>&nbsp;&nbsp;Save</button>
                        </div>
                    </div>


                </form>
                <br /><br /><br /><br />
            </div>
        </div>
        
    </div>


</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js" integrity="sha512-WMEKGZ7L5LWgaPeJtw9MBM4i5w5OSBlSjTjCtSnvFJGSVD26gE5+Td12qN5pvWXhuWaWcVwF++F7aqu9cvqP0A==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

<script>
    // Function to enable or disable the save button based on the input fields
    function toggleSaveButton() {
        var companyTinValue = document.getElementById("companyTin").value;
        var firstNameValue = document.getElementById("firstName").value;

        var saveButton = document.getElementById("saveButton");

        // Check if companyTIN contains only numbers and has a length of 10
        var isCompanyTinValid = /^\d+$/.test(companyTinValue) && companyTinValue.length === 10;

        if (companyTinValue.trim() === "" || firstNameValue.trim() === "" || !isCompanyTinValid) {
            // Disable the button if companyTIN or firstName is empty or if companyTIN is not valid
            saveButton.disabled = true;
        } else {
            // Enable the button if both fields are not empty and companyTIN is valid
            saveButton.disabled = false;
        }

        // Trigger validation immediately on input
        var companyTinValidationMessage = document.querySelector('[data-valmsg-for="companyTin"]');
        var firstNameValidationMessage = document.querySelector('[data-valmsg-for="firstName"]');

        if (companyTinValue.trim() === "") {
            companyTinValidationMessage.textContent = "Company TIN is required.";
        } else if (!isCompanyTinValid) {
            companyTinValidationMessage.textContent = "Company TIN must be exactly 10 numbers and It must not contain letters.";
        } else {
            companyTinValidationMessage.textContent = "";
        }

        if (firstNameValue.trim() === "") {
            firstNameValidationMessage.textContent = "Name is required.";
        } else {
            firstNameValidationMessage.textContent = "";
        }
    }

    // Attach the toggleSaveButton function to the input events of the relevant fields
    document.getElementById("companyTin").addEventListener("input", toggleSaveButton);
    document.getElementById("firstName").addEventListener("input", toggleSaveButton);

    // Trigger validation immediately on page load
    toggleSaveButton();

    document.getElementById("saveButton").addEventListener("click", function () {
        var formData = {
            companyTin: document.getElementById("companyTin").value,
            firstName: document.getElementById("firstName").value,
            phoneNumber: document.getElementById("phoneNumber").value,
            isDisabled: document.querySelector('input[name="isDisabled"]:checked').value === "true"
        };

        fetch('@Url.Action("Update", "Driver", new { phoneNumber = Model.phoneNumber })', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
        })
        .then(response => {
            if (response.ok) {
                $('#successModal').modal('show');
                setTimeout(() => {
                    $('#successModal').modal('hide');
                    window.location.href = '@Url.Action("Index", "Driver")';
                }, 2000);
            } else {
                return response.text().then(text => { throw new Error(text) });
            }
        })
        .catch(error => {
            console.error('Fetch Error:', error);
            alert("Failed to update driver: " + error.message);
        });
    });
</script>


<!-- Bootstrap Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" role="dialog" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <!-- Added bg-success for green background and text-white for white text -->
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="successModalLabel">Success</h5>
            </div>
            <div class="modal-body">
                <span>Driver Info Updated Successfully!</span>
            </div>

        </div>
    </div>
</div>

