@model DeliveryMonitoring.Models.UpdateDriverModel

@{
    ViewData["Title"] = "Update Driver Info";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h3 class="card-title mb-4">Update Driver Info</h3>
                    
                    <form id="myForm">
                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                        <!-- Company TIN -->
                        <div class="mb-3">
                            <label asp-for="companyTin" class="form-label fw-bold">Company TIN *</label>
                            <input asp-for="companyTin" class="form-control" id="companyTin" placeholder="e.g. 1234567890" required />
                            <span asp-validation-for="companyTin" class="text-danger small"></span>
                        </div>

                        <!-- Name -->
                        <div class="mb-3">
                            <label asp-for="firstName" class="form-label fw-bold">Name *</label>
                            <input asp-for="firstName" class="form-control" id="firstName" required />
                            <span asp-validation-for="firstName" class="text-danger small"></span>
                        </div>

                        <!-- Phone (Read Only) -->
                        <div class="mb-3">
                            <label asp-for="phoneNumber" class="form-label fw-bold">Phone Number</label>
                            <input asp-for="phoneNumber" class="form-control bg-light" id="phoneNumber" readonly />
                        </div>

                        <div class="row mb-4">
                            <!-- Status Radio -->
                            <div class="col-6">
                                <label class="form-label d-block fw-bold">
                                    Eligibility To Work
                                </label>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="isDisabled" id="statusActive" value="false" @(Model != null && !Model.isDisabled ? "checked" : "")>
                                    <label class="form-check-label" for="statusActive">Enable</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="isDisabled" id="statusDisabled" value="true" @(Model != null && Model.isDisabled ? "checked" : "")>
                                    <label class="form-check-label" for="statusDisabled">Disable</label>
                                </div>
                            </div>

                            <!-- Freelance Radio -->
                            <div class="col-6">
                                <label class="form-label d-block fw-bold">Freelance?</label>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="isFreelance" id="freelanceYes" value="true" @(Model != null && Model.isFreelance ? "checked" : "")>
                                    <label class="form-check-label" for="freelanceYes">Yes</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="isFreelance" id="freelanceNo" value="false" @(Model != null && !Model.isFreelance ? "checked" : "")>
                                    <label class="form-check-label" for="freelanceNo">No</label>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex justify-content-between align-items-center border-top pt-3">
                            <a class="btn btn-outline-secondary" href="/driverdetail/@Model?.phoneNumber">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>
                            <button id="saveButton" type="button" class="btn btn-primary px-4">
                                <i class="bi bi-floppy"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-body text-center p-4">
                <div class="text-success mb-2">
                    <i class="bi bi-check-circle-fill" style="font-size: 3rem;"></i>
                </div>
                <h5>Updated!</h5>
                <p class="text-muted mb-0">Driver info has been saved.</p>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

<script>
    function toggleSaveButton() {
        const companyTin = document.getElementById("companyTin");
        const firstName = document.getElementById("firstName");
        const saveButton = document.getElementById("saveButton");

        const isTinValid = /^\d{10}$/.test(companyTin.value);
        const isNameValid = firstName.value.trim() !== "";

        // UI Feedback
        const tinError = document.querySelector('[data-valmsg-for="companyTin"]');
        if (companyTin.value && !isTinValid) {
            tinError.textContent = "Must be exactly 10 digits.";
        } else {
            tinError.textContent = "";
        }

        saveButton.disabled = !(isTinValid && isNameValid);
    }

    document.getElementById("companyTin").addEventListener("input", toggleSaveButton);
    document.getElementById("firstName").addEventListener("input", toggleSaveButton);
    window.onload = toggleSaveButton;

    document.getElementById("saveButton").addEventListener("click", function () {
        const formData = {
            companyTin: document.getElementById("companyTin").value,
            firstName: document.getElementById("firstName").value,
            phoneNumber: document.getElementById("phoneNumber").value,
            isDisabled: document.querySelector('input[name="isDisabled"]:checked').value === "true",
            isFreelance: document.querySelector('input[name="isFreelance"]:checked').value === "true"
        };

        fetch('@Url.Action("Update", "Driver")', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
        })
        .then(response => {
            if (response.ok) {
                const myModal = new bootstrap.Modal(document.getElementById('successModal'));
                myModal.show();
                setTimeout(() => window.location.href = '@Url.Action("Index", "Driver")', 1500);
            } else {
                alert("Error updating record.");
            }
        })
        .catch(err => console.error(err));
    });
</script>