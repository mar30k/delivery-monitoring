@model DeliveryMonitoring.Models.HomeViewModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject DeliveryMonitoring.Controllers.AuthenticationManager AuthManager
@using DeliveryMonitoring.Constants
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Add this line to include the custom CSS -->
<link rel="stylesheet" href="~/css/homeIndex.css" />

<div class="container-fluid col-11 mt-3">
    @await Html.PartialAsync("_HomePageCharts")
</div>
@section Scripts{
    <script src="/js/dashboard/dashboard-config.js" asp-append-version="true"></script>
    <script src="/js/dashboard/dashboard-utils.js" asp-append-version="true"></script>
    <script src="/js/dashboard/dashboard-charts.js" asp-append-version="true"></script>
    <script src="/js/dashboard/dashboard-init.js" asp-append-version="true"></script>
}