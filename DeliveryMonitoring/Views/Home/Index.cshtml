@model DeliveryMonitoring.Models.HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid col-11 mt-3">
    <div class="row">
        <div class="col-12 col-md-4 mb-3">
            <div class="card border-0" style="border-radius:5px;" id="orderCard">                
                    <div class="row">
                        <div class="col-3" id="dashboardIcon">
                            <i class="bi bi-truck"></i>
                        </div>
                        <div class="card-body col-7">
                            <p class="card-title">Total Drivers</p>
                            <h1 class="card-text">@Model.Drivers.Count</h1>
                        </div>
                    </div>    
            </div>
        </div>

        <div class="col-12 col-md-4 mb-3">
            <div class="card border-0" style="border-radius: 5px;" id="orderCard">
                <div class="row">
                    <div class="col-3" id="dashboardIcon">
                        <i class="bi bi-cart2"></i>
                    </div>
                    <div class="card-body col-7">
                        <p class="card-title">Total Orders</p>
                        <h1 class="card-text">@Model.Orders.Count</h1>
                    </div>
                </div>                
            </div>
        </div>

        <div class="col-12 col-md-4 mb-3">
            <div class="card border-0" style="border-radius: 5px;" id="orderCard">
                <div class="row">
                    <div class="col-3" id="dashboardIcon">
                        <i class="bi bi-building"></i>
                    </div>
                    <div class="card-body col-7">
                        <p class="card-title">Companies</p>
                        <h1 class="card-text">@Model.Comps.companyTins.Count</h1>
                    </div>
                </div>               
            </div>
        </div>
    </div>

   
    <div class="row mt-3">
        <!--The Donut Chart and the Map Starts Here-->
        <div class="col-12 col-md-6 mb-3">
            <div class="card border-0" style="border-radius: 5px;" id="orderCard">
                <div class="" id="donut">
                    <h4 style="margin-left: 30px; margin-top: 10px;">Drivers Status</h4>                                       
                </div>
                <div class="">
                    <div class="collapse show col-12" id="donutchart">
                        <canvas id="myChart"></canvas>
                    </div>
                </div>
            </div>            
        </div>
        <!--The donut chart and the map ends here-->

        <!--The Bar Chart and the Map Starts Here-->
        <div class="col-12 col-md-6">
            <div class="card border-0" style="border-radius: 5px;" id="orderCard">
                <div class="" id="donut">
                    <h4 style="margin-left: 30px; margin-top: 10px;">Work Eligibility</h4>
                </div>
                <div class="">
                    <div class="collapse show col-12" id="barchart">
                        <canvas id="myChart2" style="margin-left: 0px;"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <!--The Bar Chart and the Map Ends Here-->
    </div>
    
    
    <!--code to display the donught chart starts here-->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        @{
            int offlineCount = 0;
            int readyCount = 0;
            int acceptedCount = 0;
            int deliveringCount = 0;
            int completedCount = 0;

            int eligibleCount = 0;
            int ineligibleCount = 0;

            foreach(var access in Model.Drivers)
            {
                if (access.status == "offline")
                {
                    offlineCount++;
                }
                if (access.status == "ready")
                {
                    readyCount++;
                }
                if (access.status == "accepted")
                {
                    acceptedCount++;
                }
                if (access.status == "delivering")
                {
                    deliveringCount++;
                }
                if (access.status == "completed")
                {
                    completedCount++;
                }
                if(access.isDisabled == true)
                {
                    ineligibleCount++;
                }
                if (access.isDisabled == false)
                {
                    eligibleCount++;
                }
            }
        }
        const ctx = document.getElementById('myChart');
        

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Offline', 'Ready', 'Accepted', 'Delivering', 'Completed'],
                datasets: [{
                    label: 'Drivers',
                    data: [@offlineCount, @readyCount, @acceptedCount, @deliveringCount, @completedCount],
                    backgroundColor: [
                        'rgb(255, 127, 127)',
                        'rgb(255, 165, 0)',
                        'rgb(255, 255, 127)',
                        'rgb(3, 138, 255)',
                        'rgb(60, 179, 113)'
                    ],
                    hoverOffset: 4
                }]
            }, 

        });

        const ctx2 = document.getElementById('myChart2');
        
        new Chart(ctx2, {
            type: 'bar',
            data: {
                labels: ['Eligible', 'Ineligible'],
                datasets: [{
                    label: 'Drivers',
                    data: [@eligibleCount, @ineligibleCount],
                    backgroundColor: [
                        'rgb(60, 179, 113)',
                        'rgb(255, 127, 127)',
                        
                    ],
                    borderColor: [
                        'rgb(0, 0, 0)',
                        'rgb(0, 0, 0)',
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    x: {
                        grid: {
                            display: false
                        }
                    },
                    y: {
                        grid: {
                            display: false
                        }
                    }
                }
            },
            
        });
    </script>
    <!--code to display the donught chart ends here-->
    
</div>
