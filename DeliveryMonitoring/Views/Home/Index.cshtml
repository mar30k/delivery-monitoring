    <div class="row mt-3 gy-2">
        <!-- Chart 1 -->
        <div class="col-md-6 mb-2">
            <div class="card border-1 pb-2" id="driverCard">
                <div class="d-flex justify-content-center align-items-center">
                    <div class="collapse show col-12" id="donutchart">
                        <canvas id="driversChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart 2 -->
        <div class="col-md-6">
            <div class="card border-1 pb-2">
                <div class="d-flex justify-content-center align-items-center">
                    <div class="collapse show col-12" id="donutchart">
                        <canvas id="ordersChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-2">
        <!-- Chart 3 -->
        <div class="col-md-6 mb-3">
            <div class="card border-1 pb-2">
                <div class="d-flex justify-content-center align-items-center">
                    <div class="collapse show col-12" id="donutchart">
                        <canvas id="completdChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart 4 -->
        <div class="col-md-6">
            <div class="card border-1 pb-2">
                <div class="d-flex justify-content-center align-items-center">
                    <div class="collapse show col-12" id="donutchart">
                        <canvas id="completedTotalChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
       
    <!--code to display the donught chart starts here-->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @{
        //counts related to drivers
        int offlineCount = Model.Drivers.Count(d => d.Status == "offline");
        int readyCount = Model.Drivers.Count(d => d.Status == "ready");
        int acceptedCount = Model.Drivers.Count(d => d.Status == "accepted");
        int deliveringCount = Model.Drivers.Count(d => d.Status == "delivering");
        int completedCount = Model.Drivers.Count(d => d.Status == "completed");
        int arrivedatbranchCount = Model.Drivers.Count(d => d.Status?.ToLower() == "arrivedatbranch");
        int arrivedCount = Model.Drivers.Count(d => d.Status?.ToLower() == "arrived");
        //counts related to orders
        int completedOrdersCount = Model.Orders.Count(d => d.Status == "completed");
        int requestedOrdersCount = Model.Orders.Count(d => d.Status == "requested");
        int assignedOrdersCount = Model.Orders.Count(d => d.Status == "assigned");
        int acceptedOrdersCount = Model.Orders.Count(d => d.Status == "accepted");
        int onTheWayOrdersCount = Model.Orders.Count(d => d.Status?.ToLower() == "ontheway");
        int declinedOrdersCount = Model.Orders.Count(d => d.Status == "declined");
        int driverNotFoundOrdersCount = Model.Orders.Count(d => d.Status == "driverNotFound");
        int arrivedOrdersCount = Model.Orders.Count(d => d.Status == "arrived");
        int arrivedAtBranchOrdersCount = Model.Orders.Count(d => d.Status == "arrivedAtBranch");
        int sosOrdersCount = Model.Orders.Count(d => d.Status == "sos");

        //counts related to completed ordres
        var today = DateTime.Today;

        int deliveryOrdersCount = Model?.CompletedOrders?.Data?
        .Count(x => x.RequestCreatedAt.Date == today) ?? 0;

        int dineinOrdersCount = Model?.DineInOrders?.Data?
        .Count(x => x.RequestCreatedAt.Date == today) ?? 0;

        int takeawayOrdersCount = Model?.TakeAwayOrders?.Data?
        .Count(x => x.RequestCreatedAt.Date == today) ?? 0;

        double deliveryOrdersTotalCount = Model?.CompletedOrders?.Data?
        .Where(x => x.RequestCreatedAt.Date == today).Sum(x => x.TotalAmount) ?? 0;

        double dineinOrdersTotalCount = Model?.DineInOrders?.Data?
        .Where(x => x.RequestCreatedAt.Date == today).Sum(x => x.TotalAmount) ?? 0;

        double takeawayOrdersTotalCount = Model?.TakeAwayOrders?.Data?
        .Where(x => x.RequestCreatedAt.Date == today).Sum(x=> x.TotalAmount)?? 0;
    }
    <script>
        const ctx = document.getElementById('driversChart');
        const completedChart = document.getElementById('completdChart');
        const completedTotalChart = document.getElementById('completedTotalChart');
        const orderChart = document.getElementById('ordersChart');
        var driverDataSet = [ @readyCount,@offlineCount, @acceptedCount, @deliveringCount, @completedCount , @arrivedatbranchCount, @arrivedCount];
        var completeDataSet = [ @takeawayOrdersCount, @deliveryOrdersCount, @dineinOrdersCount];
        var completeTotalAmountDataSet = [ @takeawayOrdersTotalCount, @deliveryOrdersTotalCount, @dineinOrdersTotalCount];
        var orderDataSet = [@completedOrdersCount,@requestedOrdersCount,@assignedOrdersCount,@acceptedOrdersCount,@onTheWayOrdersCount,
                            @declinedOrdersCount,@driverNotFoundOrdersCount,@arrivedAtBranchOrdersCount,@arrivedOrdersCount,@sosOrdersCount ];


         function createDoughnutChart(ctx, label, labels, dataSet, colors, titleText) {
            return new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        label: label,
                        data: dataSet,
                        backgroundColor: colors,
                        hoverOffset: 4
                    }]
                },
                options: {
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: {
                                    size: 14
                                }
                            }
                        },
                        title: {
                            display: true,
                            text: titleText,
                            font: {
                                size: 18
                            }
                        }
                    }
                }
            });
        }
        const driverChart = createDoughnutChart(
            ctx,
            'Drivers',
            ['Ready', 'Offline', 'Accepted', 'Delivering', 'Completed', 'ArrivedAtBranch', 'Arrived'],
            driverDataSet,
            [
                '#28a745',     // Ready
                '#dc3545',     // Offline
                'seagreen',    // Accepted
                'darkorange',  // Delivering
                '#20c997',     // Completed
                'coral',       // ArrivedAtBranch
                '#F7BEA2'      // Arrived
            ],
            'Drivers Status'
        );

        // Completed Orders Chart
        const completdOrderschart = createDoughnutChart(
            completedChart,
            'Orders',
            ['Takeaway (@takeawayOrdersCount)', 'Delivery (@deliveryOrdersCount)', 'Dine-in (@dineinOrdersCount)'],
            completeDataSet,
            [
                '#17a2b8', // Takeaway
                '#007bff', // Delivery
                '#ffc107'  // Dine-in
            ],
            'Completed Orders @(DateTime.Today.ToString("yyyy-MM-dd"))'
        );


        // Completed Orders Total Chart
        const completedOrdersTotalChart = createDoughnutChart(
            completedTotalChart,
            'Orders',
            [
                'Takeaway (@takeawayOrdersTotalCount.ToString("N2"))',
                'Delivery (@deliveryOrdersTotalCount.ToString("N2"))',
                'Dine-in (@dineinOrdersTotalCount.ToString("N2"))'
            ],
            completeTotalAmountDataSet,
            [
                '#17a2b8', // Takeaway
                '#007bff', // Delivery
                '#ffc107'  // Dine-in
            ],
            'Completed Orders Total'
        );

        // Orders Status Chart
        const ordersStatusChart = createDoughnutChart(
            orderChart,
            'Orders',
            [
                'Completed',
                'Requested',
                'Assigned',
                'Accepted',
                'On The Way',
                'Declined',
                'Driver Not Found',
                'ArrivedAtBranch',
                'Arrived',
                'sos'
            ],
            orderDataSet,
            [
                'green',       // Completed
                'deepskyblue', // Requested
                'lawngreen',   // Assigned
                'seagreen',    // Accepted
                'darkorange',  // On The Way
                'red',         // Declined
                'firebrick',   // Driver Not Found
                'coral',       // ArrivedAtBranch
                '#F7BEA2',     // Arrived
                'darkred'      // SOS
            ],
            'Orders Status'
        );

        function updateChart() {
            const statusCounts = {
                completed: 0,
                requested: 0,
                assigned: 0,
                accepted: 0,
                ontheway: 0,
                declined: 0,
                driverNotFound: 0,
                arrivedAtBranch: 0,
                arrived: 0,
                sos: 0
            };

            // Count orders by status
            data.forEach(order => {
                if (statusCounts.hasOwnProperty(order.status)) {
                    statusCounts[order.status]++;
                }
            });

            // Update chart data
            ordersStatusChart.data.datasets[0].data = [
                statusCounts.completed,
                statusCounts.requested,
                statusCounts.assigned,
                statusCounts.accepted,
                statusCounts.ontheway,
                statusCounts.declined,
                statusCounts.driverNotFound,
                statusCounts.arrivedAtBranch,
                statusCounts.arrived,
                statusCounts.sos
            ];

            ordersStatusChart.update();
        }

        setInterval(function () {
            updateChart();
        }, 10000);
        </script>
    <!--code to display the donught chart ends here-->
    
</div>
