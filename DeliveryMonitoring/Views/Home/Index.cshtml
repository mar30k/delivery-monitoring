@model DeliveryMonitoring.Models.HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-12 col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Drivers Registered</h5>
                    <h1 class="card-text">@Model.Drivers.Count</h1>
                    <a href="/Driver/Index" class="card-link btn btn-success">See All</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Total Orders</h5>
                    <h1 class="card-text">@Model.Orders.Count</h1>
                    <a href="/Order/Index" class="card-link btn btn-success">See All</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Companies Count</h5>
                    <h1 class="card-text">@Model.Comps.companyTins.Count</h1>
                    <a href="/Company/Index" class="card-link btn btn-success">See All</a>
                </div>
            </div>
        </div>
    </div>

    <!--The Donut Chart and the Map Starts Here-->
    <div class="row mt-3">
        <div class="col-12 col-md-5">
            <div class="" id="donut">
                <h3>Check Drivers Status</h3>
                <hr/>
                <button class="colbut" data-bs-toggle="collapse" data-bs-target="#donutchart" aria-expanded="false" aria-controls="donutchart">
                    <i class="bi bi-arrow-up"></i> Collapse
                </button>
            </div>
            <div class="">
                <div class="collapse show col-12" id="donutchart">
                    <canvas id="myChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-7" id="map">
           
        </div>
        
    </div>
    <!--The donut chart and the map ends here-->
    
    <!--code to display the donught chart starts here-->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        @{
            int offlineCount = 0;
            int readyCount = 0;
            int acceptedCount = 0;
            int deliveringCount = 0;
            int completedCount = 0;
            foreach(var access in Model.Drivers)
            {
                if (access.status == "offline")
                {
                    offlineCount++;
                }
                if (access.status == "ready")
                {
                    readyCount++;
                }
                if (access.status == "accepted")
                {
                    acceptedCount++;
                }
                if (access.status == "delivering")
                {
                    deliveringCount++;
                }
                if (access.status == "completed")
                {
                    completedCount++;
                }
            }
        }
        const ctx = document.getElementById('myChart');
        

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Offline', 'Ready', 'Accepted', 'Delivering', 'Completed'],
                datasets: [{
                    label: 'Drivers',
                    data: [@offlineCount, @readyCount, @acceptedCount, @deliveringCount, @completedCount],
                    backgroundColor: [
                        'rgb(255, 99, 132)',
                        'rgb(54, 162, 235)',
                        'rgb(255, 205, 86)',
                        'rgb(0, 128, 0)',
                        'rgb(0, 0, 0)'
                    ],
                    hoverOffset: 4
                }]
            },

        });
    </script>
    <!--code to display the donught chart ends here-->
    <!--Map JavaScript Implementation Starts Here-->
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAA8U3kqWJt2stT_CX_r8md8FKsj0-rmiQ&callback=initMap&libraries=&v=weekly" defer>
    </script>

    <script>
        function initMap() {
            const map = new google.maps.Map(document.getElementById("map"), {
                zoom: 22,
                mapTypeId: google.maps.MapTypeId.ROADMAP
            });
        @{
            if (Model != null && Model.Drivers.Count() > 0)
            {
                <text>
                                        const places = [
                </text>

                foreach (var item in Model.Drivers)
                {
                    <text>
                            { Name: '@item.firstName', LastUpdatedAt: '@DateTimeOffset.FromUnixTimeMilliseconds(item.lastUpdatedAt).DateTime.ToString("yyyy-MM-dd HH:mm:ss")', Phone: '@item.phoneNumber', Status: '@item.status', lat: @item.latLng.lat, lng: @item.latLng.lng},
                    </text>
                }
                <text>
                                                    ];
                </text>
            }
        }

                        var marker, i
            for (i = 0; i < places.length; i++) {
                var marker = new google.maps.Marker({
                    position: { lat: places[i].lat, lng: places[i].lng },
                    title: places[i].Name,
                    map: map,
                    icon: '/images/motor.png'
                });

                map.setCenter(marker.getPosition());

                var content = "<b>Name:</b> " + places[i].Name + "<br/><b>LastUpdatedAt:</b> " + places[i].LastUpdatedAt + "<br/><b>Phone:</b> " + places[i].Phone + "<br/><b>Status:</b> " + places[i].Status

                var infowindow = new google.maps.InfoWindow()

                google.maps.event.addListener(marker, 'mouseover', (function (marker, content, infowindow) {
                    return function () {
                        infowindow.setContent(content);
                        infowindow.open(map, marker);
                    };
                })(marker, content, infowindow));

                google.maps.event.addListener(marker, 'mouseout', (function (infowindow) {
                    return function () {
                        infowindow.close();
                    };
                })(infowindow));
            }
        }
    </script>
    <!--Map JavaScript Implementation Ends Here-->
</div>
