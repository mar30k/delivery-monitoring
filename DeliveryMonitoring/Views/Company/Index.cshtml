@model DeliveryMonitoring.Models.CompanyIndex

@{
    ViewData["Title"] = "Index";
}

<div class="container-fluid pt-5 col-lg-11">

    <h3>List of Companies</h3>
    <div class="pt-3">
        <table class="table compact stripe hover pt-3" id="tablelist">
            <thead class="">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.company.brandName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Companies.companyTins)
                    </th>
                    <th>Company Details</th>
                </tr>
            </thead>
            <tbody>
                @{
                    foreach (var item in Model.Companies.companyTins)
                    {
                        @if (item == Model.company.tin)
                        {
                            <tr>
                                <td>
                                    @Model.company.brandName
                                </td>
                                <td>
                                    @item
                                </td>
                                <td>
                                    <a class="btn btn-outline-dark" asp-controller="Company" asp-action="Details" asp-route-id="@item">Details</a>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td>
                                    @Model.company.brandName
                                </td>
                                <td>
                                    @item
                                </td>
                                <td>
                                    <a class="btn btn-outline-dark" asp-controller="Company" asp-action="Details" asp-route-id="@item">Details</a>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>


    <!--Jquery Datatable Starts Here-->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.js"></script>
    <script>
        var js = jQuery.noConflict(true);
        js(document).ready(function () {
            js('#tablelist').DataTable({

            });
        });
    </script>
    <!--Jquery Datatable Ends Here-->
</div>

