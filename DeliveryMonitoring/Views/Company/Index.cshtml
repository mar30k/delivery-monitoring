@model DeliveryMonitoring.Models.CompanyIndex

@{
    ViewData["Title"] = "Index";
}

<div class="container-fluid pt-5 col-11">

    <h3>List of Companies</h3>
    <div class="card pt-3 pb-3 row">
        <table class="table compact stripe hover pt-3 col-11" id="tablelist">
            <thead class="">
                <tr>
                    <th>Company Name</th>
                    <th>
                        Company TIN
                    </th>
                    <th>Company Details</th>
                </tr>
            </thead>
            <tbody>
                @{
                    for (int i = 0; i < Model.Companies.companyTins.Count; i++)
                    {
                        <tr>
                            <td>@Model.company[i].brandName</td>
                            <td>@Model.Companies.companyTins[i]</td>
                            <td>
                                <a class="btn btn-outline-dark" asp-controller="Company" asp-action="Details" asp-route-id="@Model.Companies.companyTins[i]">Details</a>
                            </td>
                        </tr>
                    }
                }
            
            </tbody>
        </table>
    </div>


    <!--Jquery Datatable Starts Here-->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.js"></script>
    <script>
        var js = jQuery.noConflict(true);
        js(document).ready(function () {
            js('#tablelist').DataTable({

            });
        });
    </script>
    <!--Jquery Datatable Ends Here-->
</div>

