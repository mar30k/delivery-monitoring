@model DeliveryMonitoring.Models.CompanyIndex

@{
    ViewData["Title"] = "Companies List";
}

<div class="container-fluid pt-5 col-11">

    <h3>List of Companies</h3>
    <div class="card pt-3 pb-3 row">
        <table class="table compact stripe hover pt-3 col-11" id="tablelist" style="font-size: 13px;">
            <thead class="">
                <tr>
                    <th class="text-start">Company Name</th>
                    <th class="text-center">
                        Company TIN
                    </th>
                    <th class="text-center">Company Details</th>
                    <th class="text-center">Check Drivers</th>
                </tr>
            </thead>
            <tbody>
                @{
                    @foreach (var tin in Model.Companies.companyTins)
                    {
                        var company = Model.Company.FirstOrDefault(c => c?.Tin == tin);

                        <tr class="text-center">
                            <td class="text-start">@(company?.BrandName ?? "N/A")</td>
                            <td class="text-center">@(tin ?? "N/A")</td>
                            <td class="text-center">
                                <a class="btn btn-outline-secondary btn-sm text-decoration-none" href="/company/@tin">Details</a>
                            </td>
                            <td class="text-center">
                                <a class="btn btn-outline-secondary btn-sm text-decoration-none" href="/drivers?tin=@tin">Drivers</a>
                            </td>
                        </tr>
                    }
                }
            
            </tbody>
        </table>
    </div>
</div>
@section Scripts {
    <script>
        var js = jQuery.noConflict(true);
        js(document).ready(function () {
            js('#tablelist').DataTable({
                responsive: true,
                columnDefs: [
                    { orderable: false, targets: [2, 3] }
                ]
            });
        });
    </script>
}

