@using System.Text

@model DeliveryMonitoring.Models.Company

@{
    ViewData["Title"] = "Details";
}

@functions {
    // Helper function to convert a numeric rating to a star representation
    string GetStarRating(double rating)
    {
        int fullStars = (int)rating;
        bool hasHalfStar = rating - fullStars >= 0.5;
        StringBuilder stars = new StringBuilder();
        for (int i = 1; i <= 5; i++)
        {
            if (i <= fullStars)
            {
                stars.Append("<i class='bi bi-star-fill'></i>"); // Assuming you're using Bootstrap Icons
            }
            else if (i == fullStars + 1 && hasHalfStar)
            {
                stars.Append("<i class='bi bi-star-half'></i>");
            }
            else
            {
                stars.Append("<i class='bi bi-star'></i>");
            }
        }
        return stars.ToString();
    }
}
<body>
    <div class="container-fluid pt-5 col-9">
        <div class="card row">
            <div class="row pt-3 pb-3">
                @* <h4><i class="bi bi-building icon"></i>Company</h4> *@
                <div class="col-12 col-lg-6">
                    <img src="@Model.attachments[0]" alt="company logo">
                </div>
                <div class="col-12 col-lg-6 d-flex flex-column justify-content-center">
                    <div>
                        <span id="letters">Name:</span>
                        <span id="outputs">@Html.DisplayFor(model => model.brandName)</span>
                    </div>                    
                    <div>
                        <span id="letters">Rating:</span>
                        <span id="outputs">
                            @Html.Raw(GetStarRating(Model.rating))
                        </span>
                    </div>
                    <div>
                        <span id="letters">@Html.DisplayNameFor(model => model.ratingCount):</span>
                        <span id="outputs">@Html.DisplayFor(model => model.ratingCount)</span>
                    </div>
                    <div>
                        <span id="letters">@Html.DisplayNameFor(model => model.tin):</span>
                        <span id="outputs">@Html.DisplayFor(model => model.tin)</span>
                    </div>
                </div>
                
            </div>                       
        </div>
        <div class="pt-3">
            <a class="btn btn-outline-dark" asp-action="Index">Back to List</a>
        </div>
    </div>
</body>

