@using System.Text

@model DeliveryMonitoring.Models.Company

@{
    ViewData["Title"] = "Details";
}

@functions {
    // Helper function to convert a numeric rating to a star representation
    string GetStarRating(double rating)
    {
       
        int fullStars = (int)rating;
        bool hasHalfStar = rating - fullStars >= 0.5;

        StringBuilder stars = new StringBuilder();

        for (int i = 1; i <= 5; i++)
        {
            if (i <= fullStars)
            {
                stars.Append("<i class='bi bi-star-fill'></i>"); // Assuming you're using Bootstrap Icons
            }
            else if (i == fullStars + 1 && hasHalfStar)
            {
                stars.Append("<i class='bi bi-star-half'></i>");
            }
            else
            {
                stars.Append("<i class='bi bi-star'></i>");
            }
        }

        return stars.ToString();
    }
}
<body>

    <div class="container-fluid pt-5 col-11">

        <h3>Company Details</h3>
        <hr />
        <img src="@Model.attachments[0]" alt="company logo">
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.brandName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.brandName)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.rating)
            </dt>
            <dd class="col-sm-10">
                @Html.Raw(GetStarRating(Model.rating))
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.ratingCount)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.ratingCount)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.tin)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.tin)
            </dd>
            
        </dl>
        <a class="btn btn-outline-dark" asp-action="Index">Back to List</a>
    </div>

</body>

