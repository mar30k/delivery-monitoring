@using DeliveryMonitoring.Constants
@using Newtonsoft.Json
@model DeliveryMonitoring.Models.CompletedOrdersViewModel
@{
    var adminCompanyTin = AppConstants.Company.AdminTin;
    ViewData["Title"] = "Completed Orders";
    var disTinctSupervisors = Model?.CompletedOrders?.Data?.DistinctBy(x => x.SupervisorPhoneNumber).Where(x => x.SupervisorPhoneNumber != null).ToList();
    var isRedCloud = Model?.CompanyTin == adminCompanyTin;
}
<style>
.initial-hide {
    display: none;
}
</style>
<div class="p-4 mt-2">
    @if (TempData["Message"] != null)
    {
        <div id="tempAlert" class="alert alert-warning alert-dismissible fade show" role="alert" >
            @TempData["Message"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <script>
            setTimeout(function () {
                var alertBox = document.getElementById('tempAlert');
                if (alertBox) {
                    alertBox.classList.remove('show');
                    alertBox.classList.add('fade');
                    alertBox.style.display = 'none';
                }
            }, 5000);
        </script>
    }

    @{
        var sections = Model?.OrderTables ?? new List<TableConfig>();
    }

    <ul class="nav nav-tabs" id="orderTabs" role="tablist">
        @for (int i = 0; i < sections.Count; i++)
        {
            var sec = sections[i];
            var tabId = $"tab-{sec.TableId}";
            var linkId = $"tab-link-{sec.TableId}";
            var isActive = i == 0 ? "active" : "";
            var ariaSelected = i == 0 ? "true" : "false";

            <li class="nav-item" role="presentation">
                <a class="nav-link text-decoration-none @isActive"
                   id="@linkId"
                   data-bs-toggle="tab"
                   href="#@tabId"
                   role="tab"
                   aria-controls="@tabId"
                   aria-selected="@ariaSelected">
                    @sec.Title
                </a>
            </li>
        }
    </ul>

    <div class="tab-content border border-top-0 p-3">
        @for (int i = 0; i < sections.Count; i++)
        {
            var sec = sections[i];
            var tabId = $"tab-{sec.TableId}";
            var linkId = $"tab-link-{sec.TableId}";
            var isActive = i == 0 ? "show active" : "";

            <div class="tab-pane fade @isActive"
                 id="@tabId"
                 role="tabpanel"
                 aria-labelledby="@linkId">

                <div class="row align-items-center justify-content-between p-2 mb-3">
                    <div class="col-12 col-md-6 mb-2 mb-md-0">
                        <h4 class="mb-0">@sec.Title Orders</h4>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="d-flex flex-wrap justify-content-md-end align-items-center gap-2">
                            <label for="@($"{sec.TableId}DateRange")" class="form-label mb-0 fw-semibold"></label>
                            <input type="text"
                                   id="@($"{sec.TableId}DateRange")"
                                   class="form-control"
                                   placeholder="@DateTime.Today:yyyy-MM-dd to @DateTime.Today:yyyy-MM-dd"
                                   style="max-width: 220px;"
                                   readonly />
                        </div>
                    </div>
                </div>

                @await Html.PartialAsync(
                        sec.SheetName,
                        new List<CompletedOrders>(), // replace with actual data
                        new ViewDataDictionary(ViewData)
                        {
                            ["TableId"] = sec.TableId,
                            ["Title"] = sec.Title,
                            ["IsRedCloud"] = isRedCloud,
                            ["PurposeOptions"] = Model?.PurposeOptions
                        }
                )
            </div>
        }
    </div>
</div>
<partial name="~/Views/Shared/ActionModals/_ReviewModal.cshtml" model="Model?.PurposeOptions"/>
<partial name="~/Views/Shared/ActionModals/_ActivityModal.cshtml" />
<partial name="~/Views/Shared/ActionModals/_ReviewDetailsModal.cshtml" />
<partial name="~/Views/Shared/ActionModals/_SupervisorAssignment.cshtml" />
@section Scripts {

    @{

        var jsTableConfigs = JsonConvert.SerializeObject(Model?.OrderTables);
    }

    <script>
        window.AppData = {
            tableConfigs: @Html.Raw(jsTableConfigs)
        };
    </script>

    <script>  
        $(document).ready(function () {
            // Activate tab based on URL hash on page load
            var hash = window.location.hash;
            if (hash) {
                $('#orderTabs a[href="' + hash + '"]').tab('show');
            }

            // Update URL hash when tab changes
            $('#orderTabs a').on('shown.bs.tab', function (e) {
                history.replaceState(null, null, e.target.hash);
            });
        });
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css">
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <link rel="stylesheet" href="~/css/header-filters.css" asp-append-version="true">
    <script>
        const purposeOptions = @Html.Raw(Json.Serialize(Model?.PurposeOptions ?? new Dictionary<int, string>()));
        var isRedCloud = @((isRedCloud) ? "true" : "false");
    </script>
    <script src="~/js/date-range.js" asp-append-version="true"></script> 
    <script src="~/js/table-auto-refresher.js" asp-append-version="true"></script> 
    <script src="~/js/datatable-renderers.js" asp-append-version="true"></script> 
    <script src="~/js/header-filter-dropdown.js" asp-append-version="true"></script> 
    <script src="~/js/datatable-init.js" asp-append-version="true"></script>
    <script src="~/js/completed-orders-table.js" type="module" asp-append-version="true"></script>
    <script src="~/js/completed-orders.js" asp-append-version="true"></script>
    <script src="~/js/modules/supervisor.js" type="module" asp-append-version="true"></script>
}

