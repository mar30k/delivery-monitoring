@model DeliveryMonitoring.Models.CompletedOrdersViewModel
@{
    var adminCompanyTin = "0076217301";
    ViewData["Title"] = "Completed Orders";
    var disTinctSupervisors = Model?.CompletedOrders?.Data?.DistinctBy(x => x.SupervisorPhoneNumber).Where(x => x.SupervisorPhoneNumber != null).ToList();
    var isRedCloud = Model?.CompanyTin == adminCompanyTin;
}
<style>
.initial-hide {
    display: none;
}
</style>
<div class="p-4 mt-2">
    @if (TempData["Message"] != null)
    {
        <div id="tempAlert" class="alert alert-warning alert-dismissible fade show" role="alert" >
            @TempData["Message"]
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <script>
            setTimeout(function () {
                var alertBox = document.getElementById('tempAlert');
                if (alertBox) {
                    alertBox.classList.remove('show');
                    alertBox.classList.add('fade');
                    alertBox.style.display = 'none';
                }
            }, 5000);
        </script>
    }
    <ul class="nav nav-tabs" id="orderTabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link text-decoration-none active" id="completed-delivery-tab" data-bs-toggle="tab" href="#completed-delivery" role="tab" aria-controls="completed-delivery" aria-selected="true">Delivery</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-decoration-none" id="dinein-orders-tab" data-bs-toggle="tab" href="#dine-in-orders" role="tab" aria-controls="dine-in-orders" aria-selected="false">Dine-in</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-decoration-none" id="takeaway-tab" data-bs-toggle="tab" href="#takeaway" role="tab" aria-controls="takeaway" aria-selected="false">Takeaway</a>
        </li>
    </ul>

    <div class="tab-content border border-top-0 p-3">
        <div class="tab-pane fade show active" id="completed-delivery" role="tabpanel" aria-labelledby="completed-delivery-tab">
            <div id="alertContainer"></div>
            <div class="row align-items-center justify-content-between p-2 mb-3">
                <div class="col-12 col-md-6 mb-2 mb-md-0">
                    <h4 class="mb-0"> Completed Delivery Orders</h4>
                </div>
                <div class="col-12 col-md-6">
                    <div class="d-flex flex-wrap justify-content-md-end align-items-center gap-2">
                        <label for="dateRange" class="form-label mb-0 fw-semibold">Filter by Date:</label>
                        <input type="text" id="dateRange" class="form-control" placeholder="@DateTime.Today.ToString("yyyy-MM-dd") to @DateTime.Today.ToString("yyyy-MM-dd")" style="max-width: 220px;" readonly />
                    </div>
                </div>
            </div>
            <div class="row card">
                <div class="table-responsive pt-3 pb-3">
                    <table class="table compact stripe hover pt-3" id="tablelist" style="font-size: 13px;">
                        <thead class="">
                            <tr>
                                <th class="text-center">
                                    Order Number
                                </th>
                                <th class="text-center">
                                    Company
                                </th>
                                <th class="text-center">
                                    Branch
                                </th>
                                <th class="text-center">
                                    Customer
                                </th>
                                <th class="text-center">
                                    Phone
                                </th>
                                <th class="text-center">
                                    Order DateTime
                                </th>
                                <th class="text-center">
                                    Distance
                                </th>
                                <th class="text-center">
                                    Duration
                                </th>
                                <th class="text-center">
                                    Eta
                                </th>

                                <th class="text-center">
                                    Driver
                                </th>
                                <th class="text-center">
                                    Supervisor
                                </th>
                                <th class="text-center">
                                    Total
                                </th>
                                <th class="text-center">
                                    Tip
                                </th>
                                <th class="text-center">
                                    Review
                                </th>
                                <th class="text-center">
                                    Activities
                                </th>
                                <th class="text-center">
                                    Details
                                </th>
                            </tr>
                        </thead>
                        <tfoot>
                            <tr>
                                <th colspan="11" class="text-end">Page Total:</th>
                                <th class="text-center"></th>
                                <th colspan="4"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        
        <div class="tab-pane fade" id="dine-in-orders" role="tabpanel" aria-labelledby="dinein-orders-tab">
            <div class="row align-items-center justify-content-between p-2 mb-3">
                <div class="col-12 col-md-6 mb-2 mb-md-0">
                    <h4 class="mb-0"> Dine-in Orders</h4>
                </div>
                <div class="col-12 col-md-6">
                    <div class="d-flex flex-wrap justify-content-md-end align-items-center gap-2">
                        <label for="dateRange" class="form-label mb-0 fw-semibold">Filter by Date:</label>
                        <input type="text" id="dineInDateRange" class="form-control" placeholder="@DateTime.Today.ToString("yyyy-MM-dd") to @DateTime.Today.ToString("yyyy-MM-dd")" style="max-width: 220px;" readonly />
                    </div>
                </div>
            </div>
            @await Html.PartialAsync("_NonDeliveryOrders", Model?.DineInOders?.Data,
            new ViewDataDictionary(ViewData)
            {
                ["TableId"] = "dineInTable",
                ["Title"] = "Dine-in Orders",
                ["IsRedCloud"] = isRedCloud,
                ["PurposeOptions"] = Model?.PurposeOptions
            })
        </div>


        <div class="tab-pane fade" id="takeaway" role="tabpanel" aria-labelledby="takeaway-tab">
            <div class="row align-items-center justify-content-between p-2 mb-3">
                <div class="col-12 col-md-6 mb-2 mb-md-0">
                    <h4 class="mb-0"> Takeaway Order</h4>
                </div>
                <div class="col-12 col-md-6">
                    <div class="d-flex flex-wrap justify-content-md-end align-items-center gap-2">
                        <label for="dateRange" class="form-label mb-0 fw-semibold">Filter by Date:</label>
                        <input type="text" id="takeAwayDateRange" class="form-control" placeholder="@DateTime.Today.ToString("yyyy-MM-dd") to @DateTime.Today.ToString("yyyy-MM-dd")" style="max-width: 220px;" readonly />
                    </div>
                </div>
            </div>
            @await Html.PartialAsync("_NonDeliveryOrders", Model?.TakeAwayOrders?.Data,
                    new ViewDataDictionary(ViewData) {
                         ["TableId"] = "takeAwayTable" ,
                         ["Title"] = "Takeaway Orders",
                         ["IsRedCloud"] = isRedCloud,
                         ["PurposeOptions"] = Model?.PurposeOptions
                    })
        </div>
    </div>

</div>
<div class="modal fade" id="reviewDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content shadow">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Order Review <span id="voucherCodeDetail"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p><strong>Purpose: </strong> <span id="modalPurpose">—</span></p>
                <p>
                    <strong>Note: </strong><span id="modalNote">—</span>
                    <a id="editNote"
                       href="#"
                       data-voucher-code=""
                       data-phone-number=""
                       data-customer-phone=""
                       data-purpose-key=""
                       data-note=""
                    >
                        <i class="fa-solid fa-pen-to-square"></i> edit
                    </a>
                </p>

                <div id="reviewDetailsLoadingSpinner" class="text-center my-3">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 mb-0">Loading customer review...</p>
                </div>

                <div id="customerReview" class="d-none"></div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content shadow">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Review Order <span id="voucherCodeReview"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="reviewForm">
                <div class="modal-body">
                    <input type="hidden" name="VoucherCode" id="reviewOrderId" />
                    <input type="hidden" name="isDelivery" id="isDelivery" />

                    <div class="mb-3">
                        <label for="reviewPurpose" class="form-label fw-bold">Purpose</label>
                        <select class="form-select" id="reviewPurpose" name="Purpose" required>
                            <option value="" selected disabled>-- Select Purpose --</option>
                            @foreach (var purpose in Model?.PurposeOptions ?? new Dictionary<int, string>())
                            {
                                <option value="@purpose.Key">@purpose.Value</option>
                            }
)
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="reviewNote" class="form-label fw-bold">Note</label>
                        <textarea class="form-control" id="reviewNote" name="Note" rows="3" placeholder="Enter note..." required></textarea>
                    </div>

                    <div id="reviewLoadingSpinner" class="text-center my-3">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 mb-0">Loading customer review...</p>
                    </div>
                    <div id="customerReviewSection" class="border-top pt-3 mt-3">
                        <!-- Will be dynamically filled -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" id="submitReviewBtn" class="btn btn-success">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="activityModal" tabindex="-1" aria-labelledby="activityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-secondary">
                <h5 class="modal-title text-white" id="activityModalLabel">Delivery Activity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <!-- Loader -->
                <div id="activityLoader" class="text-center my-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p>Fetching delivery activity...</p>
                </div>

                <!-- Alert container -->
                <div id="activityAlertContainer" class="mb-3"></div>

                <!-- Summary Section -->
                <div id="activitySummary" class="mb-3 d-none"></div>

                <!-- Activity Timeline -->
                <table class="table table-bordered table-hover d-none" id="activityTable">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Activity</th>
                            <th>Time</th>
                            <th>Elapsed</th>
                        </tr>
                    </thead>
                    <tbody id="activityTimeline"></tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Activate tab based on URL hash on page load
            var hash = window.location.hash;
            if (hash) {
                $('#orderTabs a[href="' + hash + '"]').tab('show');
            }

            // Update URL hash when tab changes
            $('#orderTabs a').on('shown.bs.tab', function (e) {
                history.replaceState(null, null, e.target.hash);
            });
        });
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css">
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <link rel="stylesheet" href="~/css/header-filters.css" asp-append-version="true">
    <script>
        const purposeOptions = @Html.Raw(Json.Serialize(Model?.PurposeOptions ?? new Dictionary<int, string>()));
        var isRedCloud = @((isRedCloud) ? "true" : "false");
    </script>
    <script src="~/js/header-filter-dropdown.js" asp-append-version="true"></script> 
    <script src="~/js/completed-orders.js" asp-append-version="true"></script>
}

