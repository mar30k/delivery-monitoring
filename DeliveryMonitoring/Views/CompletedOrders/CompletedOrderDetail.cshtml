@model OrderDetail
<link rel="stylesheet" href="~/css/orderDetail.css" />
@{
    ViewData["Title"] = "OrderDetail";
    var colClass = ((!string.IsNullOrEmpty(Model?.SupervisedBy) || !string.IsNullOrEmpty(Model?.SupervisorName)) && !string.IsNullOrEmpty(Model?.AssignedDriverPhoneNumber)) ? "col-md-6" : "col-md-3";
}
<div class="px-4 mt-2">

    <h3>Order Details</h3>

    <div class="card" id="orderCard">
        <div class="row px-4 pt-4 pb-2" >
            <!-- Customer Section -->
            <div class="col-md-3 mb-3">
                <h4 class="mb-2"><i class="bi bi-person-circle icon"></i> Customer</h4>
                <div>
                    <strong class="text-muted">Name:</strong>
                    <span>@(Model?.CustomerFirstName ?? "N/A")</span>
                </div>
                <div>
                    <strong class="text-muted">Phone:</strong>
                    <span>@(Model?.LineItemsDetail?.PhoneNumber ?? "N/A")</span>
                </div>
                @if (Model?.LineItemsDetail?.ExtraInformation != null &&
                                Model.LineItemsDetail.ExtraInformation.TryGetValue("Delivery Address Name:", out var value))
                {
                    string address = value?.ToString() ?? "";

                    if (Model.LineItemsDetail.ExtraInformation.TryGetValue("Specific Address:", out var specificAddress))
                    {
                        var specific = specificAddress?.ToString();

                        if (!string.IsNullOrWhiteSpace(specific))
                            address += "-" + specific;
                    }

                    address = address.Trim();

                    if (!string.IsNullOrWhiteSpace(address))
                    {
                        <div>
                            <strong class="text-muted">Address:</strong>
                            <span>@address</span>
                        </div>
                    }
                }
            </div>

            <!-- Company Section -->
            <div class="col-md-3 mb-3 ">
                <h4 class="mb-2"><i class="bi bi-building icon"></i> Company</h4>
                <div>
                    <strong class="text-muted">Name:</strong>
                    <span>@(Model?.LineItemsDetail?.CompanyName ?? "N/A")</span>
                </div>
                <div>
                    <strong class="text-muted">Branch:</strong>
                    <span>@(Model?.BranchName ?? "N/A")</span>
                </div>
                <div>
                    <strong class="text-muted">Branch Phone:</strong>
                    @if (Model?.LineItemsDetail?.ExtraData!=null && Model.LineItemsDetail.ExtraData.TryGetValue("restaurant", out var restaurantValue))
                    {
                        <span>@(!string.IsNullOrWhiteSpace(restaurantValue) ? restaurantValue : "N/A")</span>
                    }
                </div>
                <div>
                    <strong class="text-muted">TIN:</strong>
                    <span>
                        @if (Model?.LineItemsDetail?.ExtraData != null && Model.LineItemsDetail.ExtraData.TryGetValue("tin", out var tin))
                        {
                            <a href="/company/@tin">
                                @tin
                            </a>
                        }
                        else
                        {
                            <span>N/A</span>
                        }
                    </span>
                </div>
            </div>
            @{
                bool hasSupPhone = !string.IsNullOrWhiteSpace(Model?.SupervisedBy);
                bool hasSupName = !string.IsNullOrWhiteSpace(Model?.SupervisorName)
                && Model.SupervisorName != "N/A";

                bool showSupervisor = hasSupPhone || hasSupName;

                bool hasDriverPhone = !string.IsNullOrWhiteSpace(Model?.AssignedDriverPhoneNumber);
                bool hasDriverName = !string.IsNullOrWhiteSpace(Model?.AssignedDriverName);

                bool showDriver = hasDriverPhone || hasDriverName;
            }
            <!-- Supervisor Section -->
            @if (showSupervisor)
            {
                <div class="col-md-3 mb-3">
                    <h4 style="margin-bottom: 5px;">
                        <i class="bi bi-person-circle icon"></i> Supervisor
                    </h4>

                    @if (hasSupPhone)
                    {
                        <div>
                            <span id="letters">Phone:</span>
                            <span id="outputs">@Model?.SupervisedBy</span>
                        </div>
                    }

                    @if (hasSupName)
                    {
                        <div>
                            <span id="letters">Name:</span>
                            <span id="outputs">@Model?.SupervisorName</span>
                        </div>
                    }
                </div>
            }

            <!-- Driver Section -->
            @if (showDriver)
            {
                <div class="col-md-3 mb-3">
                    <h4 style="margin-bottom: 5px;">
                        <i class="fa-sharp-duotone fa-solid fa-motorcycle"></i> Driver
                    </h4>

                    @if (hasDriverPhone)
                    {
                        <div>
                            <span id="letters">Phone:</span>
                            <span id="outputs">@Model?.AssignedDriverPhoneNumber</span>
                        </div>
                    }

                    @if (hasDriverName)
                    {
                        <div>
                            <span id="letters">Name:</span>
                            <span id="outputs">@Model?.AssignedDriverName</span>
                        </div>
                    }
                </div>
            }

            <!-- ETA Section -->
            <div class="@colClass">
                @{
                    var activities = Model?.Activities;
                }

                @if (activities?.Eta is DateTime eta)
                {
                    <div>
                        <span><strong>ETA:</strong></span>
                        <span>@eta.ToString("dd-MM-yyyy hh:mm:ss tt")</span>
                    </div>
                }

                @if (activities?.ActualArrival is DateTime actual)
                {
                    <div>
                        <span><strong>Actual Time Of Arrival:</strong></span>
                        <span>@actual.ToString("dd-MM-yyyy hh:mm:ss tt")</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(activities?.EtaDifference))
                {
                    <div>
                        <span><strong>ETA Difference:</strong></span>
                        <span>@activities.EtaDifference</span>
                    </div>
                }
                
                @if (Model?.LineItemsDetail?.ExtraInformation != null && Model.LineItemsDetail.ExtraInformation.Any())
                {
                    <div class="mt-1">
                        <span><strong>Extra Information:</strong></span>
                        <button type="button" class="btn btn-link p-0 ms-1 text-decoration-none text-primary"
                                data-bs-toggle="modal" data-bs-target="#extraInfoModal">
                            View
                            <i class="bi bi-arrow-up-right-square"></i>
                        </button>
                    </div>
                }
                <!-- Extra Information Modal -->
                <div class="modal fade" id="extraInfoModal" tabindex="-1" aria-labelledby="extraInfoModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-scrollable modal-lg">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title text-white" id="extraInfoModalLabel">Extra Information</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <table class="table table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Key</th>
                                            <th>Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var kvp in Model?.LineItemsDetail?.ExtraInformation ?? new Dictionary<string, string>())
                                        {
                                            <tr>
                                                <td>@kvp.Key</td>
                                                <td>@(!string.IsNullOrWhiteSpace(kvp.Value) ? kvp.Value : "N/A")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Voucher Section -->
            <div class="@colClass">
                <div>
                    <span><strong>VoucherCode:</strong></span>
                    <span>@Model?.VoucherCode</span>
                </div>
                <div>
                    <span><strong>Order Date Time:</strong></span>
                    <span>@Model?.Activities?.StartTime?.ToString("dd-MM-yyyy hh:mm:ss tt")</span>
                </div>               
                @if (Model?.LineItemsDetail?.ExtraInformation != null && Model.LineItemsDetail.ExtraInformation.ContainsKey("Delivery Method:"))
                {
                    <div>
                        <span><strong>Delivery Method:</strong></span>
                        <span>@Model.LineItemsDetail.ExtraInformation["Delivery Method:"]</span>
                    </div>
                }
            </div>
            
        </div>
        @await Html.PartialAsync("_LineItemDetail", Model?.LineItemsDetail ?? new LineItemsDetail())
    </div>
</div>
@await Html.PartialAsync("_DeliveryActivity", Model?.Activities ?? new DeliveryMonitoring.Models.Activities())