@using Microsoft.AspNetCore.Html
@model TableConfig
@{
    ViewData["Title"] = Model?.Title;
    var isAllOrders = Model?.TableId == "allOrders";
}
<div class="p-4">
    <div class="row align-items-center justify-content-between p-2">
        <div class="col-12 col-md-6 mb-2 mb-md-0">
            <div class="d-flex align-items-baseline">
                <h4 class="mb-0 me-2"> @Model?.Title</h4>
                <button class="btn btn-success btn-sm mb-2" id="exportToExcelBtn">Export Table To Excel</button>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="d-flex flex-wrap justify-content-md-end align-items-center gap-2">
                <label for="dateRange" class="form-label mb-0 fw-semibold">Filter by Date:</label>
                <input type="text" id="dateRange" class="form-control" placeholder="@DateTime.Today.ToString("yyyy-MM-dd") to @DateTime.Today.ToString("yyyy-MM-dd")" style="max-width: 220px;" readonly />
            </div>
        </div>
    </div>
    <div class="row card">
        <div class="table-responsive pt-3 pb-3">
            <table class="table compact stripe hover pt-3" id="@Model?.TableId" style="font-size: 13px;">
                <thead class="">
                    <tr>
                        <th class="text-center">
                            Order Number
                        </th>
                        <th class="text-center">
                            Company
                        </th>
                        <th class="text-center">
                            Branch
                        </th>
                        <th class="text-center">
                            Customer
                        </th>
                        <th class="text-center">
                            Phone
                        </th>
                        <th class="text-center">
                            Order DateTime
                        </th>
                        <th class="text-center">
                            Distance
                        </th>
                        <th class="text-center">
                            Duration
                        </th>
                        <th class="text-center">
                            Eta
                        </th>

                        <th class="text-center">
                            Driver
                        </th>
                        <th class="text-center">
                            Supervisor
                        </th>
                        <th class="text-center">
                            Total
                        </th>
                        <th class="text-center">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th colspan="6" class="text-end">Totals</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<div class="modal fade" id="completePendingOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <form id="completePendingOrderForm">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">
                        Complete Order
                        <span id="completeOrderVoucher" class="text-muted"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" id="completeVoucherCode" name="voucherCode">

                    <!-- Driver -->
                    <div class="mb-3">
                        <label class="form-label">Driver</label>
                        <select class="form-select" id="driverPhone" name="driverPhone" required>
                            <option value="">Loading drivers...</option>
                        </select>
                    </div>

                    <!-- Distance -->
                    <div class="mb-3">
                        <label class="form-label">Distance (km)</label>
                        <input type="number" step="0.01" class="form-control"
                               id="distance" name="distance" placeholder="enter the distance in km">
                    </div>

                    <!-- Duration -->
                    <div class="mb-3">
                        <label class="form-label">Duration (minutes)</label>
                        <input type="number" step="0.01" class="form-control"
                               id="duration" name="duration" placeholder="enter the duration in minutes" required>
                    </div>

                    <!-- ETA -->
                    <div class="mb-3">
                        <label class="form-label">ETA (minutes)</label>
                        <input type="number" step="0.01" class="form-control"
                               id="eta" name="eta" placeholder="enter the eta in minutes" required>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-success" id="completeOrderSubmitBtn">
                        Complete Order
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css">
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <link rel="stylesheet" href="~/css/header-filters.css" asp-append-version="true">
    <script src="~/js/table-auto-refresher.js" asp-append-version="true"></script>
    <script src="~/js/complete-pending-order.js" asp-append-version="true"></script>
    <script src="~/js/date-range.js" asp-append-version="true"></script>
    <script src="~/js/header-filter-dropdown.js" asp-append-version="true"></script>
    <script src="~/js/datatable-renderers.js" asp-append-version="true"></script>
    <script src="~/js/datatable-init.js" asp-append-version="true"></script>
    <script src="~/js/table-utils.js" type="module" asp-append-version="true"></script>
    <script src="~/js/pending-orders-table.js" type="module" asp-append-version="true"></script>
    <script src="~/js/export-to-Excel.js" asp-append-version="true"></script>
    <script type="module">
        import { PendingOrdersTable } from '/js/pending-orders-table.js?v=@DateTime.Now.Ticks';
        PendingOrdersTable.init({
            tableId: "@Model?.TableId",
            ajaxUrl: "@Model?.AjaxUrl",
            userType: "@Model?.Type" + "_report",
            sheetName: "@Model?.SheetName"
        });
    </script>
}